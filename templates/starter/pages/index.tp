// Welcome page

Title -> {
    type: text
    content: "Welcome to Topo!"
    style: "text-4xl font-bold text-center text-gray-900"
}

Subtitle -> {
    type: text
    content: "A UI framework that eliminates nesting hell"
    style: "text-lg text-gray-600 text-center mt-2"
}

ButtonGroup -> {
    style: "mt-8 flex gap-4"
    children: [GetStartedButton, DemoButton]
}

GetStartedButton -> {
    type: a
    href: "https://github.com/FatmanBros/topo"
    content: "Get Started"
    style: "px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
}

DemoButton -> {
    type: a
    href: "https://fatmanbros.github.io/topo/"
    content: "View Demo"
    style: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition"
}

// =============================================================================
// Help Section
// =============================================================================

HelpSection -> {
    style: "mt-16 text-center"
    children: [HelpTitle, HelpCommands]
}

HelpTitle -> {
    type: text
    content: "Quick Start Commands"
    style: "text-sm font-medium text-gray-500 mb-4"
}

HelpCommands -> {
    style: "bg-gray-900 text-gray-100 rounded-lg p-4 font-mono text-sm inline-block text-left"
    children: [
        CommandLine({ cmd: "topo dev", desc: "Start development server" }),
        CommandLine({ cmd: "topo build", desc: "Build for production" }),
        CommandLine({ cmd: "topo start", desc: "Build and serve" })
    ]
}

CommandLine(props) -> {
    style: "py-1"
    children: [
        CommandText({ text: props.cmd }),
        CommandDesc({ text: props.desc })
    ]
}

CommandText(props) -> {
    type: text
    content: "$ " + props.text
    style: "text-green-400"
}

CommandDesc(props) -> {
    type: text
    content: "  # " + props.desc
    style: "text-gray-500"
}

Page -> {
    style: "min-h-screen flex flex-col items-center justify-center bg-gray-50 px-4"
    children: [Title, Subtitle, ButtonGroup, HelpSection]
}

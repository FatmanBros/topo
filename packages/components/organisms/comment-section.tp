// CommentSection Organism - Comment list with replies
// Usage: CommentSection({ comments: [...], onSubmit: handler })

import { CommentSectionVariants } from "../theme/variants/comment-section.tp"
import { Avatar } from "../atoms/avatar.tp"
import { PrimaryButton } from "../atoms/button.tp"

// =============================================================================
// Base CommentSection Component
// =============================================================================

CommentSection(props) -> {
    style: CommentSectionVariants.container + (props.className ? " " + props.className : "")
    children: [
        props.showForm ? CommentForm({
            avatar: props.currentUserAvatar,
            onSubmit: props.onSubmit,
            placeholder: props.placeholder
        }) : null,
        CommentList({
            comments: props.comments,
            onReply: props.onReply,
            onLike: props.onLike,
            onLoadMore: props.onLoadMore,
            hasMore: props.hasMore
        })
    ]
}

// =============================================================================
// Comment Form
// =============================================================================

CommentForm(props) -> {
    style: CommentSectionVariants.form.container
    children: [
        CommentFormAvatar({ src: props.avatar }),
        CommentFormInput({ onSubmit: props.onSubmit, placeholder: props.placeholder })
    ]
}

CommentFormAvatar(props) -> {
    style: CommentSectionVariants.form.avatar
    children: [Avatar({ src: props.src, size: "md" })]
}

CommentFormInput(props) -> {
    style: CommentSectionVariants.form.input.container
    children: [
        CommentTextarea({ placeholder: props.placeholder }),
        CommentFormActions({ onSubmit: props.onSubmit })
    ]
}

CommentTextarea(props) -> {
    type: textarea
    placeholder: props.placeholder || "Write a comment..."
    rows: 3
    style: CommentSectionVariants.form.input.textarea
}

CommentFormActions(props) -> {
    style: CommentSectionVariants.form.input.actions
    children: [
        FormActionsLeft({}),
        PrimaryButton({ children: "Post", size: "sm", onClick: props.onSubmit })
    ]
}

FormActionsLeft(props) -> {
    style: "flex items-center gap-2"
    children: []
}

// =============================================================================
// Comment List
// =============================================================================

CommentList(props) -> {
    style: CommentSectionVariants.list.container
    children: [
        ...props.comments.for(comment => {
            Comment({
                comment: comment,
                onReply: props.onReply,
                onLike: props.onLike
            })
        }),
        props.hasMore ? LoadMoreButton({ onClick: props.onLoadMore }) : null
    ]
}

// =============================================================================
// Individual Comment
// =============================================================================

Comment(props) -> {
    style: CommentSectionVariants.comment.container
    children: [
        CommentAvatar({ src: props.comment.author.avatar }),
        CommentContent({
            comment: props.comment,
            onReply: props.onReply,
            onLike: props.onLike
        })
    ]
}

CommentAvatar(props) -> {
    style: CommentSectionVariants.comment.avatar
    children: [Avatar({ src: props.src, size: "sm" })]
}

CommentContent(props) -> {
    style: CommentSectionVariants.comment.content
    children: [
        CommentHeader({ author: props.comment.author.name, time: props.comment.time }),
        CommentBody({ text: props.comment.content }),
        CommentActions({
            liked: props.comment.liked,
            likeCount: props.comment.likeCount,
            onReply: props.onReply,
            onLike: props.onLike,
            commentId: props.comment.id
        }),
        props.comment.replies && props.comment.replies.length > 0
            ? CommentReplies({ replies: props.comment.replies, onReply: props.onReply, onLike: props.onLike })
            : null
    ]
}

CommentHeader(props) -> {
    style: CommentSectionVariants.comment.header
    children: [
        AuthorName({ text: props.author }),
        CommentTime({ text: props.time })
    ]
}

AuthorName(props) -> {
    type: text
    content: props.text
    style: CommentSectionVariants.comment.author
}

CommentTime(props) -> {
    type: text
    content: props.text
    style: CommentSectionVariants.comment.time
}

CommentBody(props) -> {
    type: text
    content: props.text
    style: CommentSectionVariants.comment.body
}

// =============================================================================
// Comment Actions
// =============================================================================

CommentActions(props) -> {
    style: CommentSectionVariants.comment.actions.container
    children: [
        LikeButton({ liked: props.liked, count: props.likeCount, onClick: props.onLike }),
        ReplyButton({ onClick: props.onReply })
    ]
}

LikeButton(props) -> {
    type: button
    click: props.onClick
    style: CommentSectionVariants.comment.actions.button
         + (props.liked ? " " + CommentSectionVariants.comment.actions.active : "")
    children: [
        LikeIcon({ filled: props.liked }),
        LikeCount({ count: props.count })
    ]
}

LikeIcon(props) -> {
    type: svg
    style: CommentSectionVariants.like.icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [LikeIconPath({})]
}

LikeIconPath(props) -> {
    type: path
    d: "M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 01-1.162-.682 22.045 22.045 0 01-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 018-2.828A4.5 4.5 0 0118 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 01-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 01-.69.001l-.002-.001z"
}

LikeCount(props) -> {
    type: text
    content: props.count > 0 ? props.count : ""
    style: CommentSectionVariants.like.count
}

ReplyButton(props) -> {
    type: button
    click: props.onClick
    style: CommentSectionVariants.comment.actions.button
    content: "Reply"
}

// =============================================================================
// Replies
// =============================================================================

CommentReplies(props) -> {
    style: CommentSectionVariants.comment.replies.container
    children: props.replies.for(reply => {
        Comment({
            comment: reply,
            onReply: props.onReply,
            onLike: props.onLike
        })
    })
}

// =============================================================================
// Load More
// =============================================================================

LoadMoreButton(props) -> {
    style: CommentSectionVariants.loadMore.container
    children: [LoadMoreButtonInner({ onClick: props.onClick })]
}

LoadMoreButtonInner(props) -> {
    type: button
    click: props.onClick
    style: CommentSectionVariants.loadMore.button
    content: "Load more comments"
}

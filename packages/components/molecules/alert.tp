// Alert Molecule - Notification message component
// Usage: Alert({ variant: "success", title: "Success!", description: "Your changes have been saved." })

import { AlertVariants } from "../theme/variants/alert.tp"

// =============================================================================
// Base Alert Component
// =============================================================================

Alert(props) -> {
    role: "alert"
    style: AlertVariants.base
         + " " + AlertVariants.variant[props.variant || "info"].bg
         + " " + AlertVariants.variant[props.variant || "info"].border
         + (props.className ? " " + props.className : "")
    children: [
        props.icon != false ? AlertIcon({ variant: props.variant || "info" }) : null,
        AlertContent({
            title: props.title,
            description: props.description,
            variant: props.variant || "info",
            actions: props.actions
        }),
        props.dismissible ? AlertDismissButton({
            onClick: props.onDismiss,
            variant: props.variant || "info"
        }) : null
    ]
}

// =============================================================================
// Alert Icon
// =============================================================================

AlertIcon(props) -> {
    style: AlertVariants.icon.container
    children: [
        AlertIconSvg({ variant: props.variant })
    ]
}

AlertIconSvg(props) -> {
    type: svg
    style: AlertVariants.icon.size + " " + AlertVariants.variant[props.variant].icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        AlertIconPath({ variant: props.variant })
    ]
}

AlertIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: props.variant == "success"
        ? "M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
        : (props.variant == "danger"
            ? "M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z"
            : (props.variant == "warning"
                ? "M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z"
                : "M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z"))
}

// =============================================================================
// Alert Content
// =============================================================================

AlertContent(props) -> {
    style: AlertVariants.content
    children: [
        props.title ? AlertTitle({ text: props.title, variant: props.variant }) : null,
        props.description ? AlertDescription({ text: props.description, variant: props.variant }) : null,
        props.actions ? AlertActions({ children: props.actions }) : null
    ]
}

AlertTitle(props) -> {
    type: text
    content: props.text
    style: AlertVariants.title + " " + AlertVariants.variant[props.variant].title
}

AlertDescription(props) -> {
    type: text
    content: props.text
    style: AlertVariants.description + " " + AlertVariants.variant[props.variant].text
}

AlertActions(props) -> {
    style: AlertVariants.actions
    children: props.children
}

// =============================================================================
// Dismiss Button
// =============================================================================

AlertDismissButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Dismiss"
    style: AlertVariants.dismissButton + " " + AlertVariants.variant[props.variant].icon
    children: [
        DismissIcon({})
    ]
}

DismissIcon(props) -> {
    type: svg
    style: AlertVariants.dismissIcon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        DismissIconPath({})
    ]
}

DismissIconPath(props) -> {
    type: path
    d: "M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"
}

// =============================================================================
// Variant Presets
// =============================================================================

SuccessAlert(props) -> Alert({ ...props, variant: "success" })
DangerAlert(props) -> Alert({ ...props, variant: "danger" })
WarningAlert(props) -> Alert({ ...props, variant: "warning" })
InfoAlert(props) -> Alert({ ...props, variant: "info" })

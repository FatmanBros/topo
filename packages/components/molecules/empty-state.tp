// EmptyState Molecule - Empty state placeholder
// Usage: EmptyState({ title: "No results", description: "Try a different search" })

import { EmptyStateVariants } from "../theme/variants/empty-state.tp"

// =============================================================================
// Base EmptyState Component
// =============================================================================

EmptyState(props) -> {
    style: EmptyStateVariants.container
         + " " + EmptyStateVariants.size[props.size || "md"]
         + (props.className ? " " + props.className : "")
    children: [
        props.icon ? EmptyStateIcon({ icon: props.icon, size: props.size || "md" }) : null,
        props.illustration ? EmptyStateIllustration({ src: props.illustration, size: props.size || "md" }) : null,
        EmptyStateTitle({ text: props.title, size: props.size || "md" }),
        props.description ? EmptyStateDescription({ text: props.description, size: props.size || "md" }) : null,
        props.actions ? EmptyStateActions({ children: props.actions }) : null
    ]
}

// =============================================================================
// Icon
// =============================================================================

EmptyStateIcon(props) -> {
    style: EmptyStateVariants.icon.container
    children: [
        props.icon == "search" ? SearchIcon({ size: props.size }) :
        props.icon == "folder" ? FolderIcon({ size: props.size }) :
        props.icon == "inbox" ? InboxIcon({ size: props.size }) :
        props.icon == "document" ? DocumentIcon({ size: props.size }) :
        DefaultIcon({ size: props.size })
    ]
}

SearchIcon(props) -> {
    type: svg
    style: EmptyStateVariants.icon.size[props.size] + " " + EmptyStateVariants.icon.style
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [SearchIconPath({})]
}

SearchIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
}

FolderIcon(props) -> {
    type: svg
    style: EmptyStateVariants.icon.size[props.size] + " " + EmptyStateVariants.icon.style
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [FolderIconPath({})]
}

FolderIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"
}

InboxIcon(props) -> {
    type: svg
    style: EmptyStateVariants.icon.size[props.size] + " " + EmptyStateVariants.icon.style
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [InboxIconPath({})]
}

InboxIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"
}

DocumentIcon(props) -> {
    type: svg
    style: EmptyStateVariants.icon.size[props.size] + " " + EmptyStateVariants.icon.style
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [DocumentIconPath({})]
}

DocumentIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
}

DefaultIcon(props) -> InboxIcon({ size: props.size })

// =============================================================================
// Illustration
// =============================================================================

EmptyStateIllustration(props) -> {
    style: EmptyStateVariants.illustration.container + " " + EmptyStateVariants.illustration.size[props.size]
    children: [IllustrationImage({ src: props.src })]
}

IllustrationImage(props) -> {
    type: img
    src: props.src
    alt: ""
    style: "w-full h-auto"
}

// =============================================================================
// Title & Description
// =============================================================================

EmptyStateTitle(props) -> {
    type: text
    content: props.text
    style: EmptyStateVariants.title.base
         + " " + EmptyStateVariants.title.size[props.size]
         + " " + EmptyStateVariants.title.style
}

EmptyStateDescription(props) -> {
    type: text
    content: props.text
    style: EmptyStateVariants.description.base
         + " " + EmptyStateVariants.description.size[props.size]
         + " " + EmptyStateVariants.description.style
}

// =============================================================================
// Actions
// =============================================================================

EmptyStateActions(props) -> {
    style: EmptyStateVariants.actions
    children: props.children
}

// =============================================================================
// Presets
// =============================================================================

NoResultsState(props) -> EmptyState({
    icon: "search",
    title: props.title || "No results found",
    description: props.description || "Try adjusting your search or filter to find what you're looking for.",
    actions: props.actions,
    size: props.size
})

EmptyInboxState(props) -> EmptyState({
    icon: "inbox",
    title: props.title || "No messages",
    description: props.description || "Your inbox is empty. New messages will appear here.",
    actions: props.actions,
    size: props.size
})

EmptyFolderState(props) -> EmptyState({
    icon: "folder",
    title: props.title || "No files",
    description: props.description || "This folder is empty. Upload files to get started.",
    actions: props.actions,
    size: props.size
})

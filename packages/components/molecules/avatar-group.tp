// AvatarGroup Molecule - Display multiple avatars with overflow
// Usage: AvatarGroup({ avatars: [...], max: 4, size: "md" })

import { AvatarGroupVariants } from "../theme/variants/avatar-group.tp"

// =============================================================================
// Base AvatarGroup Component
// =============================================================================

AvatarGroup(props) -> {
    style: AvatarGroupVariants.container
         + " " + AvatarGroupVariants.stack[props.stack || "right"]
         + " " + AvatarGroupVariants.overlap[props.overlap || "md"]
         + (props.className ? " " + props.className : "")
    children: [
        AvatarGroupItems({
            avatars: props.avatars,
            max: props.max || 4,
            size: props.size || "md"
        }),
        props.avatars.length > (props.max || 4) ? AvatarOverflow({
            count: props.avatars.length - (props.max || 4),
            size: props.size || "md"
        }) : null
    ]
}

// =============================================================================
// Avatar Items
// =============================================================================

AvatarGroupItems(props) -> {
    children: props.avatars.slice(0, props.max).for((avatar, index) => {
        GroupAvatar({
            src: avatar.src,
            alt: avatar.alt || avatar.name,
            name: avatar.name,
            size: props.size,
            index: index
        })
    })
}

GroupAvatar(props) -> {
    style: AvatarGroupVariants.avatar.base
         + " " + AvatarGroupVariants.avatar.hover
         + " " + AvatarGroupVariants.size[props.size]
    title: props.name
    children: [
        props.src
            ? AvatarImage({ src: props.src, alt: props.alt })
            : AvatarInitials({ name: props.name, size: props.size })
    ]
}

AvatarImage(props) -> {
    type: img
    src: props.src
    alt: props.alt
    style: "w-full h-full object-cover rounded-full"
}

AvatarInitials(props) -> {
    style: "w-full h-full flex items-center justify-center rounded-full bg-gray-200 text-gray-600 font-medium"
    children: [InitialsText({ name: props.name })]
}

InitialsText(props) -> {
    type: text
    content: getInitials(props.name)
}

// =============================================================================
// Overflow Badge
// =============================================================================

AvatarOverflow(props) -> {
    style: AvatarGroupVariants.overflow.base
         + " " + AvatarGroupVariants.overflow.style
         + " " + AvatarGroupVariants.size[props.size]
    children: [OverflowText({ count: props.count })]
}

OverflowText(props) -> {
    type: text
    content: "+" + props.count
}

// =============================================================================
// Size Presets
// =============================================================================

SmallAvatarGroup(props) -> AvatarGroup({ ...props, size: "sm" })
LargeAvatarGroup(props) -> AvatarGroup({ ...props, size: "lg" })

// =============================================================================
// With More Label
// =============================================================================

AvatarGroupWithLabel(props) -> {
    style: "flex items-center" + (props.className ? " " + props.className : "")
    children: [
        AvatarGroup({
            avatars: props.avatars,
            max: props.max || 4,
            size: props.size || "md"
        }),
        props.avatars.length > (props.max || 4) ? MoreLabel({
            count: props.avatars.length - (props.max || 4)
        }) : null
    ]
}

MoreLabel(props) -> {
    type: text
    content: "and " + props.count + " more"
    style: AvatarGroupVariants.moreLabel
}

// Breadcrumb Molecule - Navigation breadcrumb component
// Usage: Breadcrumb({ items: [{ label: "Home", href: "/" }, { label: "Products" }] })

import { BreadcrumbVariants } from "../theme/variants/breadcrumb.tp"

// =============================================================================
// Base Breadcrumb Component
// =============================================================================

Breadcrumb(props) -> {
    type: nav
    ariaLabel: "Breadcrumb"
    style: BreadcrumbVariants.nav + (props.className ? " " + props.className : "")
    children: [
        BreadcrumbList({
            items: props.items,
            separator: props.separator || "chevron",
            size: props.size || "md",
            showHome: props.showHome
        })
    ]
}

// =============================================================================
// Breadcrumb List
// =============================================================================

BreadcrumbList(props) -> {
    type: ol
    style: BreadcrumbVariants.list + " " + BreadcrumbVariants.size[props.size]
    children: [
        props.showHome ? BreadcrumbHomeItem({ href: "/", separator: props.separator }) : null,
        ...props.items.for((item, index) => {
            BreadcrumbItemWrapper({
                item: item,
                isLast: index == props.items.length - 1,
                separator: props.separator
            })
        })
    ]
}

// =============================================================================
// Breadcrumb Item
// =============================================================================

BreadcrumbItemWrapper(props) -> {
    type: li
    style: BreadcrumbVariants.item
    children: [
        BreadcrumbLink({
            label: props.item.label,
            href: props.item.href,
            isCurrent: props.isLast || !props.item.href
        }),
        props.isLast ? null : BreadcrumbSeparator({ type: props.separator })
    ]
}

BreadcrumbLink(props) -> props.isCurrent
    ? BreadcrumbCurrentText({ text: props.label })
    : BreadcrumbAnchor({ href: props.href, text: props.label })

BreadcrumbAnchor(props) -> {
    type: a
    href: props.href
    style: BreadcrumbVariants.link.base + " " + BreadcrumbVariants.link.default
    content: props.text
}

BreadcrumbCurrentText(props) -> {
    type: text
    ariaCurrent: "page"
    content: props.text
    style: BreadcrumbVariants.link.base + " " + BreadcrumbVariants.link.current
}

// =============================================================================
// Breadcrumb Separator
// =============================================================================

BreadcrumbSeparator(props) -> {
    ariaHidden: true
    style: BreadcrumbVariants.separator.base
    children: [
        props.type == "chevron" ? ChevronIcon({}) : BreadcrumbSeparatorText({ type: props.type })
    ]
}

BreadcrumbSeparatorText(props) -> {
    type: text
    content: BreadcrumbVariants.separatorStyle[props.type]
}

ChevronIcon(props) -> {
    type: svg
    style: BreadcrumbVariants.separator.icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        ChevronPath({})
    ]
}

ChevronPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
}

// =============================================================================
// Home Icon Item
// =============================================================================

BreadcrumbHomeItem(props) -> {
    type: li
    style: BreadcrumbVariants.item
    children: [
        BreadcrumbHomeLink({ href: props.href }),
        BreadcrumbSeparator({ type: props.separator })
    ]
}

BreadcrumbHomeLink(props) -> {
    type: a
    href: props.href
    ariaLabel: "Home"
    style: BreadcrumbVariants.link.base + " " + BreadcrumbVariants.link.default
    children: [
        HomeIcon({})
    ]
}

HomeIcon(props) -> {
    type: svg
    style: BreadcrumbVariants.homeIcon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        HomePath({})
    ]
}

HomePath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z"
}

// =============================================================================
// Separator Presets
// =============================================================================

SlashBreadcrumb(props) -> Breadcrumb({ ...props, separator: "slash" })
ArrowBreadcrumb(props) -> Breadcrumb({ ...props, separator: "arrow" })
DotBreadcrumb(props) -> Breadcrumb({ ...props, separator: "dot" })

// Rating Variants - Style definitions for Rating component

import { ColorStyles } from "../tokens.tp"

RatingVariants -> {
    container: "inline-flex items-center gap-0.5",

    // Star styles
    star: {
        base: "transition-colors cursor-pointer",
        empty: ColorStyles.neutral.textMuted,
        filled: "text-amber-400",
        hover: "text-amber-300",
        readonly: "cursor-default"
    },

    // Size variants
    size: {
        xs: "h-3 w-3",
        sm: "h-4 w-4",
        md: "h-5 w-5",
        lg: "h-6 w-6",
        xl: "h-8 w-8"
    },

    // Half star support
    half: {
        container: "relative",
        background: "absolute inset-0",
        foreground: "absolute inset-0 overflow-hidden"
    },

    // With label
    label: {
        container: "flex items-center gap-2",
        text: ColorStyles.neutral.textLight + " text-sm",
        count: ColorStyles.neutral.textMuted + " text-sm"
    },

    // Interactive states
    interactive: {
        container: "gap-1",
        star: "hover:scale-110 transition-transform"
    },

    // Disabled state
    disabled: "opacity-50 cursor-not-allowed"
}

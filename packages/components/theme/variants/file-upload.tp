// FileUpload Variants - Style definitions for FileUpload component

import { ColorStyles, Radius } from "../tokens.tp"

FileUploadVariants -> {
    // Dropzone style
    dropzone: {
        base: "relative border-2 border-dashed transition-colors cursor-pointer " + Radius.lg,
        default: ColorStyles.neutral.borderLight + " hover:border-gray-400 bg-gray-50 hover:bg-gray-100",
        active: ColorStyles.primary.borderLight + " " + ColorStyles.primary.bgLight,
        disabled: "opacity-50 cursor-not-allowed"
    },

    // Size variants
    size: {
        sm: "p-4",
        md: "p-6",
        lg: "p-8"
    },

    // Content layout
    content: "flex flex-col items-center justify-center text-center",

    // Icon
    icon: {
        container: "mb-3",
        size: {
            sm: "h-8 w-8",
            md: "h-10 w-10",
            lg: "h-12 w-12"
        },
        style: ColorStyles.neutral.textMuted
    },

    // Text content
    title: "font-medium " + ColorStyles.neutral.text,

    description: "text-sm mt-1 " + ColorStyles.neutral.textLight,

    hint: "text-xs mt-2 " + ColorStyles.neutral.textMuted,

    // Browse button/link
    browse: ColorStyles.primary.text + " font-medium hover:underline",

    // File list
    fileList: {
        container: "mt-4 space-y-2",
        item: "flex items-center gap-3 p-3 bg-white border " + ColorStyles.neutral.borderLight + " " + Radius.md,
        icon: "h-8 w-8 flex-shrink-0 " + ColorStyles.neutral.textMuted,
        info: "flex-1 min-w-0",
        name: "text-sm font-medium " + ColorStyles.neutral.text + " truncate",
        size: "text-xs " + ColorStyles.neutral.textMuted,
        remove: "p-1 rounded hover:bg-gray-100 " + ColorStyles.neutral.textMuted + " hover:text-gray-600"
    },

    // Progress bar
    progress: {
        container: "mt-2 h-1.5 bg-gray-200 " + Radius.full + " overflow-hidden",
        bar: ColorStyles.primary.bg + " h-full transition-all duration-300"
    },

    // Error state
    error: {
        border: ColorStyles.danger.borderLight,
        text: ColorStyles.danger.text + " text-sm mt-2"
    }
}

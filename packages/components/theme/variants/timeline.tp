// Timeline Variants - Style definitions for Timeline component

TimelineVariants -> {
    container: "relative",

    // Orientation
    orientation: {
        vertical: "space-y-0",
        horizontal: "flex items-start overflow-x-auto"
    },

    // Timeline item
    item: {
        vertical: {
            container: "relative flex gap-4 pb-8 last:pb-0",
            line: "absolute left-4 top-8 bottom-0 w-0.5 -ml-px bg-gray-200",
            lineLast: "hidden"
        },
        horizontal: {
            container: "relative flex flex-col items-center px-8 min-w-[200px]",
            line: "absolute left-full top-4 w-8 h-0.5 bg-gray-200",
            lineLast: "hidden"
        }
    },

    // Indicator/icon
    indicator: {
        container: "relative z-10 flex items-center justify-center flex-shrink-0",
        base: "rounded-full flex items-center justify-center",
        size: {
            sm: "h-6 w-6",
            md: "h-8 w-8",
            lg: "h-10 w-10"
        },
        variant: {
            default: "bg-gray-200 text-gray-700",
            primary: "bg-indigo-600 text-white",
            success: "bg-green-600 text-white",
            warning: "bg-amber-500 text-white",
            danger: "bg-red-600 text-white",
            info: "bg-blue-600 text-white"
        },
        icon: "h-4 w-4"
    },

    // Content
    content: {
        container: "flex-1 min-w-0",
        title: "font-medium text-gray-700",
        description: "text-sm text-gray-500 mt-1",
        time: "text-xs text-gray-400 mt-1",
        // Card style content
        card: {
            base: "p-4 bg-white border border-gray-200 rounded-lg",
            title: "font-medium text-gray-700",
            body: "text-sm text-gray-500 mt-2"
        }
    },

    // Connector line
    connector: {
        default: "bg-gray-200",
        completed: "bg-indigo-600"
    },

    // Size variants
    size: {
        sm: {
            gap: "gap-3",
            text: "text-sm"
        },
        md: {
            gap: "gap-4",
            text: "text-base"
        },
        lg: {
            gap: "gap-6",
            text: "text-lg"
        }
    }
}

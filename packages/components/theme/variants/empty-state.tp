// EmptyState Variants - Style definitions for EmptyState component

import { ColorStyles } from "../tokens.tp"

EmptyStateVariants -> {
    container: "flex flex-col items-center justify-center text-center py-12 px-4",

    // Size variants
    size: {
        sm: "py-8 px-4",
        md: "py-12 px-6",
        lg: "py-16 px-8"
    },

    // Icon container
    icon: {
        container: "mb-4",
        size: {
            sm: "h-12 w-12",
            md: "h-16 w-16",
            lg: "h-20 w-20"
        },
        style: ColorStyles.neutral.textMuted
    },

    // Title
    title: {
        base: "font-semibold mb-2",
        size: {
            sm: "text-base",
            md: "text-lg",
            lg: "text-xl"
        },
        style: ColorStyles.neutral.text
    },

    // Description
    description: {
        base: "max-w-md mb-6",
        size: {
            sm: "text-sm",
            md: "text-base",
            lg: "text-lg"
        },
        style: ColorStyles.neutral.textLight
    },

    // Actions container
    actions: "flex items-center gap-3",

    // Illustration/Image
    illustration: {
        container: "mb-6",
        size: {
            sm: "max-w-xs",
            md: "max-w-sm",
            lg: "max-w-md"
        }
    }
}

// DataTable Variants - Style definitions for DataTable component

import { ColorStyles, Radius } from "../tokens.tp"

DataTableVariants -> {
    container: "w-full overflow-hidden border " + ColorStyles.neutral.borderLight + " " + Radius.lg,

    // Table wrapper for horizontal scroll
    wrapper: "overflow-x-auto",

    table: "w-full divide-y " + ColorStyles.neutral.borderLight,

    // Header
    thead: "bg-gray-50",

    th: {
        base: "px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider " + ColorStyles.neutral.text,
        sortable: "cursor-pointer hover:bg-gray-100 select-none",
        sorted: ColorStyles.primary.text
    },

    sortIcon: {
        container: "inline-flex ml-1",
        size: "h-4 w-4",
        active: ColorStyles.primary.text,
        inactive: ColorStyles.neutral.textMuted
    },

    // Body
    tbody: "bg-white divide-y " + ColorStyles.neutral.borderLight,

    tr: {
        base: "transition-colors",
        hover: "hover:bg-gray-50",
        selected: ColorStyles.primary.bgLight,
        striped: "even:bg-gray-50"
    },

    td: {
        base: "px-4 py-3 text-sm " + ColorStyles.neutral.text,
        truncate: "max-w-xs truncate"
    },

    // Empty state
    empty: {
        cell: "px-4 py-12 text-center",
        text: ColorStyles.neutral.textMuted
    },

    // Loading state
    loading: {
        overlay: "absolute inset-0 bg-white/50 flex items-center justify-center",
        spinner: "h-8 w-8 animate-spin " + ColorStyles.primary.text
    },

    // Checkbox column
    checkbox: {
        th: "w-12 px-4",
        td: "w-12 px-4"
    },

    // Actions column
    actions: {
        th: "w-20 px-4 text-right",
        td: "w-20 px-4 text-right"
    },

    // Pagination
    pagination: {
        container: "px-4 py-3 border-t " + ColorStyles.neutral.borderLight + " bg-gray-50 flex items-center justify-between",
        info: "text-sm " + ColorStyles.neutral.textLight,
        controls: "flex items-center gap-2"
    }
}

{
  "$schema": "./topo.schema.json",
  "project": {
    "name": "topo",
    "version": "0.1.0"
  },
  "build": {
    "mode": "ssg",
    "output": "dist",
    "basePath": "/topo",
    "minify": true,
    "sourcemap": true
  },
  "dev": {
    "port": 7090,
    "open": true,
    "hmr": true
  },
  "style": {
    "framework": "tailwind",
    "config": "tailwind.config.js",
    "tailwind": {
      "enabled": true,
      "version": "3.4.0",
      "cdn": true
    }
  },
  "paths": {
    "pages": "demo/pages",
    "components": "demo/components",
    "stores": "src/stores",
    "services": "src/services",
    "aliases": {
      "@": "demo"
    }
  },
  "runtime": {
    "api": {
      "baseUrl": "/api",
      "timeout": 5000
    }
  },
  "i18n": {
    "locales": ["ja", "en"],
    "defaultLocale": "ja",
    "translationsDir": "demo/locales",
    "translations": {
      "sign_in": { "ja": "サインイン", "en": "Sign In" },
      "email": { "ja": "メールアドレス", "en": "Email" },
      "password": { "ja": "パスワード", "en": "Password" },
      "email_placeholder": { "ja": "メールアドレスを入力", "en": "Enter your email" },
      "password_placeholder": { "ja": "パスワードを入力", "en": "Enter your password" },
      "welcome": { "ja": "topoへようこそ！", "en": "Welcome to topo!" },
      "about": { "ja": "topoについて", "en": "About topo" },
      "users": { "ja": "ユーザー", "en": "Users" },
      "back_home": { "ja": "ホームに戻る", "en": "Back to Home" },
      "validation_required": { "ja": "{{field}}は必須です", "en": "{{field}} is required" },
      "validation_min_length": { "ja": "{{field}}は{{min}}文字以上で入力してください", "en": "{{field}} must be at least {{min}} characters" },
      "validation_max_length": { "ja": "{{field}}は{{max}}文字以下で入力してください", "en": "{{field}} must be at most {{max}} characters" },
      "validation_min_value": { "ja": "{{field}}は{{min}}以上で入力してください", "en": "{{field}} must be at least {{min}}" },
      "validation_max_value": { "ja": "{{field}}は{{max}}以下で入力してください", "en": "{{field}} must be at most {{max}}" },
      "validation_email": { "ja": "{{field}}は有効なメールアドレスを入力してください", "en": "{{field}} must be a valid email address" },
      "validation_pattern": { "ja": "{{field}}の形式が正しくありません", "en": "{{field}} does not match the required pattern" }
    }
  }
}

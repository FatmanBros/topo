{
  "$schema": "./topo.schema.json",
  "project": {
    "name": "topo",
    "version": "0.1.0"
  },
  "build": {
    "mode": "spa",
    "output": "dist",
    "minify": true,
    "sourcemap": true
  },
  "dev": {
    "port": 3000,
    "open": true,
    "hmr": true
  },
  "style": {
    "framework": "tailwind",
    "config": "tailwind.config.js"
  },
  "paths": {
    "pages": "src/pages",
    "components": "src/components",
    "stores": "src/stores",
    "services": "src/services"
  },
  "runtime": {
    "api": {
      "baseUrl": "/api",
      "timeout": 5000
    }
  }
}

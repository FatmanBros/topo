{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Topo",
  "scopeName": "source.topo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#test-definition" },
    { "include": "#store-definition" },
    { "include": "#api-service-definition" },
    { "include": "#component-definition" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#store-access" },
    { "include": "#function-call" },
    { "include": "#property" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.topo",
          "match": "//.*$"
        }
      ]
    },
    "test-definition": {
      "patterns": [
        {
          "comment": "Test block: Test(\"name\") { ... } or xTest(\"name\") { ... }",
          "match": "^\\s*(Test|xTest)\\s*\\(\\s*(\"[^\"]*\")\\s*\\)",
          "captures": {
            "1": { "name": "keyword.control.test.topo" },
            "2": { "name": "string.quoted.double.test-name.topo" }
          }
        },
        {
          "comment": "BeforeEach, AfterEach, BeforeOnce, AfterOnce hooks",
          "name": "keyword.control.test.topo",
          "match": "^\\s*(BeforeEach|AfterEach|BeforeOnce|AfterOnce)\\b"
        },
        {
          "comment": "Test functions: goto, expect, fill, click, wait, mock, capture",
          "match": "\\b(goto|expect|fill|click|wait|mock|capture)\\s*\\(",
          "captures": {
            "1": { "name": "support.function.test.topo" }
          }
        },
        {
          "comment": "Test targets: submit, button",
          "name": "constant.language.test-target.topo",
          "match": "\\b(submit)\\b"
        },
        {
          "comment": "Test conditions: visible, hidden, disabled, empty",
          "name": "constant.language.test-condition.topo",
          "match": "\\b(visible|hidden|disabled|empty)\\b"
        },
        {
          "comment": "Page property: page.url",
          "match": "\\b(page)\\.(url|title)\\b",
          "captures": {
            "1": { "name": "variable.language.page.topo" },
            "2": { "name": "variable.other.property.topo" }
          }
        }
      ]
    },
    "imports": {
      "begin": "^\\s*(import)\\s*\\{",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.topo" }
      },
      "end": "\\}\\s*(from)\\s*(\"[^\"]*\"|'[^']*')",
      "endCaptures": {
        "1": { "name": "keyword.control.from.topo" },
        "2": { "name": "string.quoted.topo" }
      },
      "patterns": [
        {
          "name": "entity.name.type.topo",
          "match": "[A-Z][a-zA-Z0-9]*"
        },
        {
          "name": "punctuation.separator.comma.topo",
          "match": ","
        }
      ]
    },
    "component-definition": {
      "patterns": [
        {
          "comment": "Component with params: Name(params) -> { or Name(params) -> Base(",
          "match": "^\\s*([A-Z][a-zA-Z0-9]*)\\s*(\\([^)]*\\))?\\s*(->)",
          "captures": {
            "1": { "name": "entity.name.function.component.topo" },
            "2": {
              "name": "meta.parameters.topo",
              "patterns": [
                { "include": "#parameter-list" }
              ]
            },
            "3": { "name": "keyword.operator.arrow.topo" }
          }
        }
      ]
    },
    "parameter-list": {
      "patterns": [
        {
          "name": "variable.parameter.topo",
          "match": "[a-zA-Z][a-zA-Z0-9]*"
        },
        {
          "name": "punctuation.separator.comma.topo",
          "match": ","
        }
      ]
    },
    "store-definition": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][a-zA-Z0-9]*)\\s*(\\|)\\s*\\{",
          "captures": {
            "1": { "name": "entity.name.class.store.topo" },
            "2": { "name": "keyword.operator.pipe.topo" }
          }
        },
        {
          "name": "keyword.other.store-block.topo",
          "match": "\\b(State|Actions|Commands|Reducers|Effects|Selectors)\\b"
        },
        {
          "name": "keyword.control.on.topo",
          "match": "\\bon\\b"
        }
      ]
    },
    "api-service-definition": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][a-zA-Z0-9]*)\\s*(::)\\s*\\{",
          "captures": {
            "1": { "name": "entity.name.class.api.topo" },
            "2": { "name": "keyword.operator.double-colon.topo" }
          }
        },
        {
          "name": "constant.language.http-method.topo",
          "match": "\\b(GET|POST|PUT|DELETE|PATCH)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.topo",
          "match": "(@)([a-zA-Z]+)(\\([^)]*\\))?",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.topo" },
            "2": { "name": "entity.name.function.decorator.topo" },
            "3": { "name": "meta.annotation.arguments.topo" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.topo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.topo",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.topo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.topo",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.topo",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "property": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z][a-zA-Z0-9]*)\\s*(:)",
          "captures": {
            "1": { "name": "support.type.property-name.topo" },
            "2": { "name": "punctuation.separator.key-value.topo" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.topo",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "constant.language.topo",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "support.constant.type.topo",
          "match": "(?<=type:\\s*)(text|button|input|link|select|textarea|container|form|submit)\\b"
        },
        {
          "name": "support.constant.align.topo",
          "match": "(?<=align:\\s*)(horizontal|vertical)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.topo",
          "match": "->"
        },
        {
          "name": "keyword.operator.pipe.topo",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.double-colon.topo",
          "match": "::"
        }
      ]
    },
    "store-access": {
      "patterns": [
        {
          "name": "meta.store.access.topo",
          "match": "(\\$)([a-zA-Z][a-zA-Z0-9]*)\\.([a-zA-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.topo" },
            "2": { "name": "variable.other.object.topo" },
            "3": { "name": "variable.other.property.topo" }
          }
        },
        {
          "name": "variable.other.store-ref.topo",
          "match": "(\\$)([a-zA-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.topo" },
            "2": { "name": "variable.other.object.topo" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.i18n.topo",
          "match": "\\b(t)\\s*\\(",
          "captures": {
            "1": { "name": "support.function.i18n.topo" }
          }
        },
        {
          "comment": "Store action dispatch: Store.Action",
          "match": "([A-Z][a-zA-Z0-9]*)\\.([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "variable.other.object.topo" },
            "2": { "name": "entity.name.function.topo" }
          }
        },
        {
          "comment": "Component call with parens",
          "match": "([A-Z][a-zA-Z0-9]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.type.component.topo" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.component-ref.topo",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
        },
        {
          "name": "variable.other.topo",
          "match": "\\b[a-z][a-zA-Z0-9]*\\b"
        }
      ]
    }
  }
}

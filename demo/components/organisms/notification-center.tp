// NotificationCenter Organism - Notification dropdown
// Usage: NotificationCenter({ notifications: [...], unreadCount: 5 })

import { NotificationCenterVariants } from "../../theme/variants/notification-center.tp"

// =============================================================================
// Base NotificationCenter Component
// =============================================================================

NotificationCenter(props) -> {
    style: "relative" + (props.className ? " " + props.className : "")
    children: [
        NotificationTrigger({
            unreadCount: props.unreadCount,
            onClick: props.onToggle
        }),
        props.isOpen ? NotificationPanel({
            notifications: props.notifications,
            onMarkAllRead: props.onMarkAllRead,
            onNotificationClick: props.onNotificationClick,
            onViewAll: props.onViewAll
        }) : null
    ]
}

// =============================================================================
// Trigger Button
// =============================================================================

NotificationTrigger(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Notifications"
    style: NotificationCenterVariants.trigger.button
    children: [
        BellIcon({}),
        props.unreadCount > 0 ? NotificationBadge({ count: props.unreadCount }) : null
    ]
}

BellIcon(props) -> {
    type: svg
    style: NotificationCenterVariants.trigger.icon
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "2"
    children: [BellIconPath({})]
}

BellIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"
}

NotificationBadge(props) -> {
    style: NotificationCenterVariants.trigger.badge.container
    children: [BadgeText({ count: props.count })]
}

BadgeText(props) -> {
    type: text
    content: props.count > 9 ? "9+" : props.count
    style: NotificationCenterVariants.trigger.badge.dot
}

// =============================================================================
// Notification Panel
// =============================================================================

NotificationPanel(props) -> {
    style: NotificationCenterVariants.panel.container
    children: [
        PanelHeader({ onMarkAllRead: props.onMarkAllRead }),
        NotificationList({ notifications: props.notifications, onClick: props.onNotificationClick }),
        PanelFooter({ onViewAll: props.onViewAll })
    ]
}

PanelHeader(props) -> {
    style: NotificationCenterVariants.panel.header.container
    children: [
        HeaderTitle({}),
        MarkAllReadButton({ onClick: props.onMarkAllRead })
    ]
}

HeaderTitle(props) -> {
    type: text
    content: "Notifications"
    style: NotificationCenterVariants.panel.header.title
}

MarkAllReadButton(props) -> {
    type: button
    click: props.onClick
    style: NotificationCenterVariants.panel.header.action
    content: "Mark all read"
}

// =============================================================================
// Notification List
// =============================================================================

NotificationList(props) -> {
    style: NotificationCenterVariants.panel.list
    children: props.notifications.length > 0
        ? props.notifications.for(notification => {
            NotificationItem({
                notification: notification,
                onClick: props.onClick
            })
        })
        : [EmptyNotifications({})]
}

NotificationItem(props) -> {
    click: props.onClick
    style: NotificationCenterVariants.item.container.base
         + (props.notification.unread ? " " + NotificationCenterVariants.item.container.unread : "")
    children: [
        NotificationIcon({ type: props.notification.type }),
        NotificationContent({ notification: props.notification }),
        props.notification.unread ? UnreadDot({}) : null
    ]
}

NotificationIcon(props) -> {
    style: NotificationCenterVariants.item.icon.container
         + " " + NotificationCenterVariants.item.icon[props.type || "default"]
    children: [NotificationTypeIcon({ type: props.type })]
}

NotificationTypeIcon(props) -> {
    type: svg
    style: "h-5 w-5"
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [NotificationTypeIconPath({ type: props.type })]
}

NotificationTypeIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: props.type == "success"
        ? "M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
        : (props.type == "warning"
            ? "M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z"
            : "M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z")
}

NotificationContent(props) -> {
    style: NotificationCenterVariants.item.content
    children: [
        NotificationTitle({ text: props.notification.title }),
        NotificationMessage({ text: props.notification.message }),
        NotificationTime({ text: props.notification.time })
    ]
}

NotificationTitle(props) -> {
    type: text
    content: props.text
    style: NotificationCenterVariants.item.title
}

NotificationMessage(props) -> {
    type: text
    content: props.text
    style: NotificationCenterVariants.item.message
}

NotificationTime(props) -> {
    type: text
    content: props.text
    style: NotificationCenterVariants.item.time
}

UnreadDot(props) -> {
    style: NotificationCenterVariants.item.unreadDot
}

// =============================================================================
// Empty State
// =============================================================================

EmptyNotifications(props) -> {
    style: NotificationCenterVariants.empty.container
    children: [
        EmptyIcon({}),
        EmptyText({})
    ]
}

EmptyIcon(props) -> {
    type: svg
    style: NotificationCenterVariants.empty.icon
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [EmptyIconPath({})]
}

EmptyIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"
}

EmptyText(props) -> {
    type: text
    content: "No notifications"
    style: NotificationCenterVariants.empty.text
}

// =============================================================================
// Footer
// =============================================================================

PanelFooter(props) -> {
    style: NotificationCenterVariants.panel.footer.container
    children: [ViewAllLink({ onClick: props.onViewAll })]
}

ViewAllLink(props) -> {
    type: button
    click: props.onClick
    style: NotificationCenterVariants.panel.footer.link
    content: "View all notifications"
}

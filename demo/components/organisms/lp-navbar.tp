// LP Navbar organism - fixed navigation bar for landing page
import { SmallCTAButton } from "../molecules/cta-button.tp"

LPNavbar -> {
    style: "fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100"
    children: [LPNavbarInner]
}

LPNavbarInner -> {
    style: "max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
    children: [LPNavbarLogo, LPNavbarLinks, LPNavbarCTA]
}

LPNavbarLogo -> {
    type: link
    href: "/"
    content: "topo"
    style: "text-2xl font-bold bg-gradient-to-r from-pink-500 to-violet-500 bg-clip-text text-transparent"
}

LPNavbarLinks -> {
    style: "hidden md:flex items-center gap-8"
    children: [
        LPNavLink({ href: "#features", label: "Features" }),
        LPNavLink({ href: "#example", label: "Example" }),
        LPNavLink({ href: "#getting-started", label: "Get Started" }),
        LPNavLink({ href: "/dashboard", label: "Demo" })
    ]
}

LPNavLink(props) -> {
    type: link
    href: props.href
    content: props.label
    style: "text-gray-600 hover:text-pink-500 transition-colors font-medium"
}

LPNavbarCTA -> {
    style: "hidden md:block"
    children: [SmallCTAButton({ href: "https://github.com/FatmanBros/topo", content: "GitHub" })]
}

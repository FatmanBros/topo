import { LoginForm } from "../stores/login.tp"
import { FormField } from "../molecules/form-field.tp"
import { LangSwitcher } from "../molecules/lang-switcher.tp"
import { SubmitButton } from "../atoms/button.tp"
import { Text } from "../atoms/text.tp"

LoginTitle -> {
    type: text
    content: t("sign_in")
    style: "text-2xl font-bold text-gray-900 mb-6 text-center"
}

DebugInfo -> {
    type: text
    content: $LoginForm.email
    style: "text-sm text-gray-500 mt-4 text-center"
}

LoginFormCard -> {
    style: "bg-white p-8 rounded-xl shadow-lg max-w-md w-full"
    align: vertical
    children: [
        LangSwitcher,
        LoginTitle,
        FormField({
            label: t("email")
            inputType: "email"
            placeholder: t("email_placeholder")
            value: $LoginForm.email
            onInput: LoginForm.SetEmail
            errorMsg: $LoginForm.emailError
        }),
        FormField({
            label: t("password")
            inputType: "password"
            placeholder: t("password_placeholder")
            value: $LoginForm.password
            onInput: LoginForm.SetPassword
            errorMsg: $LoginForm.passwordError
        }),
        SubmitButton(t("sign_in"), LoginForm.Submit),
        DebugInfo
    ]
}

LoginApp -> {
    style: "min-h-screen bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center p-4"
    children: [LoginFormCard]
}

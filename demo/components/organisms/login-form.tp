import { FormField } from "../molecules/form-field.tp"
import { LangSwitcher } from "../molecules/lang-switcher.tp"
import { SubmitButton } from "../atoms/button.tp"
import { Heading } from "../atoms/heading.tp"
import { Text } from "../atoms/text.tp"

// ─── Store定義 ───
LoginFormCard | {
    State {
        @label("email")
        @required
        @email
        email: ""

        @label("password")
        @required
        @minLength(8)
        password: ""

        isSubmitting: false
    }

    Commands {
        Submit
        Reset
    }

    Actions {
        SetEmail(value)
        SetPassword(value)
        SetSubmitting(value)
    }

    Reducers {
        on SetEmail(value) {
            email: value
        }
        on SetPassword(value) {
            password: value
        }
        on SetSubmitting(value) {
            isSubmitting: value
        }
    }
}

// ─── Component定義 ───
LoginFormCard -> {
    style: "bg-white p-8 rounded-xl shadow-lg max-w-md w-full"
    align: vertical
    children: [
        LangSwitcher,
        Heading({
            t: "sign_in"
            style: "text-2xl font-bold text-gray-900 mb-6 text-center"
        }),
        FormField({
            label: { t: "email" }
            inputType: "email"
            placeholder: { t: "email_placeholder" }
            value: $LoginFormCard.email
            onInput: LoginFormCard.SetEmail
            errorMsg: $LoginFormCard.emailError
        }),
        FormField({
            label: { t: "password" }
            inputType: "password"
            placeholder: { t: "password_placeholder" }
            value: $LoginFormCard.password
            onInput: LoginFormCard.SetPassword
            errorMsg: $LoginFormCard.passwordError
        }),
        SubmitButton({ t: "sign_in" }, LoginFormCard.Submit),
        Text({
            text: $LoginFormCard.email
            style: "text-sm text-gray-500 mt-4 text-center"
        })
    ]
}

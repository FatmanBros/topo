import { LangSwitcher } from "../molecules/lang-switcher.tp"
import { SubmitButton } from "../atoms/button.tp"
import { Heading } from "../atoms/heading.tp"
import { Text } from "../atoms/text.tp"
import { AuthorityApi } from "../../services/authority-api.tp"

// ─── Store定義 ───
LoginFormCard | {
    State {
        @key("email")
        @required
        @email
        email: ""

        @key("password")
        @required
        @minLength(8)
        password: ""

        @hidden
        isSubmitting: false

        @hidden
        error: ""
    }

    Commands {
        Submit
        Reset
    }

    Actions {
        SetEmail(value)
        SetPassword(value)
        SetSubmitting(value)
        SetError(value)
        LoginSuccess(user)
    }

    Reducers {
        // SetEmail and SetPassword are auto-generated with validation
        on SetSubmitting(value) {
            isSubmitting: value
        }
        on SetError(value) {
            error: value
        }
        on LoginSuccess(user) {
            isSubmitting: false
            error: ""
        }
    }

    Effects {
        on Submit {
            dispatch: SetSubmitting(true)
            dispatch: SetError("")
            try {
                response: await AuthorityApi.login({
                    email: $email,
                    password: $password
                })
                dispatch: LoginSuccess(response.user)
                navigate: "/dashboard"
            } catch(e) {
                dispatch: SetError(e.message)
                dispatch: SetSubmitting(false)
            }
        }
    }
}

// ─── フォーム（トリガーは外から渡す） ───
LoginForm(props) -> {
    type: "form"
    onSubmit: LoginFormCard.Submit
    style: "flex flex-col"
    children: [...LoginFormCard.Fields, props.trigger]
}

// ─── Component定義 ───
LoginFormCard -> {
    style: "bg-white p-8 rounded-xl shadow-lg max-w-md w-full"
    align: vertical
    children: [
        LangSwitcher,
        Heading({
            t: "sign_in"
            style: "text-2xl font-bold text-gray-900 mb-6 text-center"
        }),
        LoginForm({
            trigger: SubmitButton({ t: "sign_in" })
        }),
        Text({
            text: $LoginFormCard.email
            style: "text-sm text-gray-500 mt-4 text-center"
        })
    ]
}

import { LangSwitcher } from "../molecules/lang-switcher.tp"
import { SubmitButton } from "../atoms/button.tp"
import { Heading } from "../atoms/heading.tp"
import { Text } from "../atoms/text.tp"

// ─── Store定義 ───
LoginFormCard | {
    State {
        @key("email")
        @required
        @email
        email: ""

        @key("password")
        @required
        @minLength(8)
        password: ""

        @hidden
        isSubmitting: false
    }

    Commands {
        Submit
        Reset
    }

    Actions {
        SetEmail(value)
        SetPassword(value)
        SetSubmitting(value)
    }

    Reducers {
        on SetEmail(value) {
            email: value
        }
        on SetPassword(value) {
            password: value
        }
        on SetSubmitting(value) {
            isSubmitting: value
        }
    }
}

// ─── Submitボタン内蔵のフォーム ───
LoginForm -> {
    type: "form"
    onSubmit: LoginFormCard.Submit
    style: "flex flex-col"
    children: [...LoginFormCard.Fields]
}

// ─── Component定義 ───
LoginFormCard -> {
    style: "bg-white p-8 rounded-xl shadow-lg max-w-md w-full"
    align: vertical
    children: [
        LangSwitcher,
        Heading({
            t: "sign_in"
            style: "text-2xl font-bold text-gray-900 mb-6 text-center"
        }),
        LoginForm,
        {
            type: "submit"
            content: { t: "sign_in" }
            click: LoginFormCard.Submit
            style: "w-full bg-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-indigo-700 transition cursor-pointer"
        },
        Text({
            text: $LoginFormCard.email
            style: "text-sm text-gray-500 mt-4 text-center"
        })
    ]
}

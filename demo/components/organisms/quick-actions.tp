// Quick action buttons
QuickActions -> {
    style: "bg-white rounded-xl shadow-sm border border-gray-100 p-6"
    align: vertical
    children: [QuickActionsHeader, QuickActionsList]
}

QuickActionsHeader -> {
    type: text
    content: "Quick Actions"
    style: "text-lg font-semibold text-gray-900 mb-4"
}

QuickActionsList -> {
    style: "grid grid-cols-2 gap-3"
    children: [
        QuickActionButton({ label: "New Project", icon: "+" }),
        QuickActionButton({ label: "Add User", icon: "+" }),
        QuickActionButton({ label: "Generate Report", icon: ">" }),
        QuickActionButton({ label: "Settings", icon: "*" })
    ]
}

QuickActionButton(props) -> {
    type: button
    content: props.label
    style: "p-3 bg-gray-50 hover:bg-gray-100 rounded-lg text-sm font-medium text-gray-700 transition text-left"
}

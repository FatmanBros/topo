// Activity feed showing recent actions
ActivityFeed -> {
    style: "bg-white rounded-xl shadow-sm border border-gray-100 p-6"
    align: vertical
    children: [ActivityHeader, ActivityList]
}

ActivityHeader -> {
    type: text
    content: "Recent Activity"
    style: "text-lg font-semibold text-gray-900 mb-4"
}

ActivityList -> {
    align: vertical
    style: "space-y-4"
    children: [
        ActivityItem({ user: "Alice", action: "created a new project", time: "2 minutes ago" }),
        ActivityItem({ user: "Bob", action: "updated the dashboard", time: "15 minutes ago" }),
        ActivityItem({ user: "Carol", action: "completed a task", time: "1 hour ago" }),
        ActivityItem({ user: "Dave", action: "joined the team", time: "3 hours ago" })
    ]
}

ActivityItem(props) -> {
    style: "flex items-center gap-3 py-3 border-b border-gray-100 last:border-0"
    children: [
        ActivityAvatar({ initial: props.user }),
        ActivityContent({ user: props.user, action: props.action, time: props.time })
    ]
}

ActivityAvatar(props) -> {
    style: "w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center flex-shrink-0"
    children: [ActivityAvatarText({ text: props.initial })]
}

ActivityAvatarText(props) -> {
    type: text
    content: props.text
    style: "text-sm font-medium text-gray-600"
}

ActivityContent(props) -> {
    align: vertical
    children: [
        ActivityText({ user: props.user, action: props.action }),
        ActivityTime({ time: props.time })
    ]
}

ActivityText(props) -> {
    type: text
    content: props.user + " " + props.action
    style: "text-sm text-gray-700"
}

ActivityTime(props) -> {
    type: text
    content: props.time
    style: "text-xs text-gray-400"
}

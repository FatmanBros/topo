// Dashboard header with title and user info
import { Heading } from "../atoms/heading.tp"
import { Text } from "../atoms/text.tp"
import { Button } from "../atoms/button.tp"

DashboardHeader(props) -> {
    style: "flex items-center justify-between mb-8"
    children: [
        HeaderLeft({ title: props.title, subtitle: props.subtitle }),
        HeaderRight({ userName: props.userName })
    ]
}

HeaderLeft(props) -> {
    align: vertical
    children: [
        Heading({ text: props.title, level: 2, style: "text-2xl font-bold text-gray-900" }),
        Text({ text: props.subtitle, style: "text-gray-500 mt-1" })
    ]
}

HeaderRight(props) -> {
    style: "flex items-center gap-4"
    children: [
        Button("Notifications", null, "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition", "button"),
        UserAvatar({ initial: props.userName ? props.userName.charAt(0) : "U" })
    ]
}

UserAvatar(props) -> {
    style: "w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center"
    children: [Text({ text: props.initial, style: "text-white font-semibold" })]
}

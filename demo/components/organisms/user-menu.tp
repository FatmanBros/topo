// UserMenu Organism - User dropdown menu
// Usage: UserMenu({ user: { name, email, avatar }, items: [...] })

import { UserMenuVariants } from "../../theme/variants/user-menu.tp"

// =============================================================================
// Base UserMenu Component
// =============================================================================

UserMenu(props) -> {
    style: UserMenuVariants.container + (props.className ? " " + props.className : "")
    children: [
        UserMenuTrigger({
            user: props.user,
            onClick: props.onToggle
        }),
        props.isOpen ? UserMenuPanel({
            user: props.user,
            items: props.items,
            onItemClick: props.onItemClick,
            status: props.status
        }) : null
    ]
}

// =============================================================================
// Trigger
// =============================================================================

UserMenuTrigger(props) -> {
    type: button
    click: props.onClick
    style: UserMenuVariants.trigger.button
    children: [
        TriggerAvatar({ src: props.user.avatar }),
        TriggerName({ name: props.user.name }),
        TriggerChevron({})
    ]
}

TriggerAvatar(props) -> {
    type: img
    src: props.src
    alt: "User avatar"
    style: UserMenuVariants.trigger.avatar
}

TriggerName(props) -> {
    type: text
    content: props.name
    style: UserMenuVariants.trigger.name
}

TriggerChevron(props) -> {
    type: svg
    style: UserMenuVariants.trigger.chevron
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [ChevronPath({})]
}

ChevronPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
}

// =============================================================================
// Panel
// =============================================================================

UserMenuPanel(props) -> {
    style: UserMenuVariants.panel.container
    children: [
        UserMenuHeader({ user: props.user, status: props.status }),
        UserMenuItems({ items: props.items, onItemClick: props.onItemClick })
    ]
}

// =============================================================================
// Header
// =============================================================================

UserMenuHeader(props) -> {
    style: UserMenuVariants.panel.header.container
    children: [
        HeaderName({ name: props.user.name }),
        HeaderEmail({ email: props.user.email }),
        props.status ? UserStatus({ status: props.status }) : null
    ]
}

HeaderName(props) -> {
    type: text
    content: props.name
    style: UserMenuVariants.panel.header.name
}

HeaderEmail(props) -> {
    type: text
    content: props.email
    style: UserMenuVariants.panel.header.email
}

UserStatus(props) -> {
    style: UserMenuVariants.status.container + " mt-2"
    children: [
        StatusDot({ status: props.status }),
        StatusText({ status: props.status })
    ]
}

StatusDot(props) -> {
    style: UserMenuVariants.status.dot.base + " " + UserMenuVariants.status.dot[props.status]
}

StatusText(props) -> {
    type: text
    content: props.status.charAt(0).toUpperCase() + props.status.slice(1)
    style: UserMenuVariants.status.text
}

// =============================================================================
// Menu Items
// =============================================================================

UserMenuItems(props) -> {
    style: UserMenuVariants.panel.menu
    children: props.items.map(item =>
        item.type == "divider"
            ? MenuDivider({})
            : item.type == "label"
                ? SectionLabel({ text: item.text })
                : MenuItem({
                    item: item,
                    onClick: props.onItemClick
                })
    )
}

MenuItem(props) -> {
    type: button
    click: props.onClick
    style: UserMenuVariants.panel.item.base
         + " " + (props.item.danger
             ? UserMenuVariants.panel.item.danger
             : props.item.active
                 ? UserMenuVariants.panel.item.active
                 : UserMenuVariants.panel.item.default)
    children: [
        props.item.icon ? MenuItemIcon({ icon: props.item.icon }) : null,
        MenuItemLabel({ text: props.item.label })
    ]
}

MenuItemIcon(props) -> {
    type: text
    content: props.icon
    style: UserMenuVariants.panel.itemIcon
}

MenuItemLabel(props) -> {
    type: text
    content: props.text
}

MenuDivider(props) -> {
    style: UserMenuVariants.panel.divider
}

SectionLabel(props) -> {
    type: text
    content: props.text
    style: UserMenuVariants.panel.sectionLabel
}

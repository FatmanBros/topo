// CardList Organism - Card list with grid/list view toggle
// Usage: CardList({ items: [...], view: "grid", columns: 3 })

import { CardListVariants } from "../../theme/variants/card-list.tp"

// =============================================================================
// Base CardList Component
// =============================================================================

CardList(props) -> {
    style: CardListVariants.container + (props.className ? " " + props.className : "")
    children: [
        props.showViewToggle ? ViewToggle({
            view: props.view || "grid",
            onViewChange: props.onViewChange
        }) : null,
        props.view == "list"
            ? ListView({ items: props.items, onItemClick: props.onItemClick })
            : GridView({ items: props.items, columns: props.columns || 3, onItemClick: props.onItemClick })
    ]
}

// =============================================================================
// View Toggle
// =============================================================================

ViewToggle(props) -> {
    style: CardListVariants.viewToggle.container + " mb-4"
    children: [
        GridViewButton({ active: props.view == "grid", onClick: props.onViewChange }),
        ListViewButton({ active: props.view == "list", onClick: props.onViewChange })
    ]
}

GridViewButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Grid view"
    style: CardListVariants.viewToggle.button.base
         + " " + (props.active
             ? CardListVariants.viewToggle.button.active
             : CardListVariants.viewToggle.button.inactive)
    children: [GridIcon({})]
}

ListViewButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "List view"
    style: CardListVariants.viewToggle.button.base
         + " " + (props.active
             ? CardListVariants.viewToggle.button.active
             : CardListVariants.viewToggle.button.inactive)
    children: [ListIcon({})]
}

GridIcon(props) -> {
    type: svg
    style: CardListVariants.viewToggle.icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [GridIconPath({})]
}

GridIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M4.25 2A2.25 2.25 0 002 4.25v2.5A2.25 2.25 0 004.25 9h2.5A2.25 2.25 0 009 6.75v-2.5A2.25 2.25 0 006.75 2h-2.5zm0 9A2.25 2.25 0 002 13.25v2.5A2.25 2.25 0 004.25 18h2.5A2.25 2.25 0 009 15.75v-2.5A2.25 2.25 0 006.75 11h-2.5zm9-9A2.25 2.25 0 0011 4.25v2.5A2.25 2.25 0 0013.25 9h2.5A2.25 2.25 0 0018 6.75v-2.5A2.25 2.25 0 0015.75 2h-2.5zm0 9A2.25 2.25 0 0011 13.25v2.5A2.25 2.25 0 0013.25 18h2.5A2.25 2.25 0 0018 15.75v-2.5A2.25 2.25 0 0015.75 11h-2.5z"
}

ListIcon(props) -> {
    type: svg
    style: CardListVariants.viewToggle.icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [ListIconPath({})]
}

ListIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"
}

// =============================================================================
// Grid View
// =============================================================================

GridView(props) -> {
    style: CardListVariants.grid.container + " " + CardListVariants.grid.cols[props.columns]
    children: props.items.map(item => GridCard({ item: item, onClick: props.onItemClick }))
}

GridCard(props) -> {
    click: props.onClick
    style: CardListVariants.card.base + " cursor-pointer"
    children: [
        props.item.image ? GridCardImage({ src: props.item.image, alt: props.item.title }) : null,
        GridCardContent({ item: props.item })
    ]
}

GridCardImage(props) -> {
    type: img
    src: props.src
    alt: props.alt
    style: CardListVariants.card.grid.image
}

GridCardContent(props) -> {
    style: CardListVariants.card.grid.content
    children: [
        GridCardTitle({ text: props.item.title }),
        props.item.description ? GridCardDescription({ text: props.item.description }) : null,
        props.item.meta ? GridCardMeta({ meta: props.item.meta }) : null
    ]
}

GridCardTitle(props) -> {
    type: text
    content: props.text
    style: CardListVariants.card.grid.title
}

GridCardDescription(props) -> {
    type: text
    content: props.text
    style: CardListVariants.card.grid.description
}

GridCardMeta(props) -> {
    style: CardListVariants.card.grid.meta
    children: props.meta.map(m => MetaItem({ text: m }))
}

MetaItem(props) -> {
    type: text
    content: props.text
}

// =============================================================================
// List View
// =============================================================================

ListView(props) -> {
    style: CardListVariants.list.container
    children: props.items.map(item => ListCard({ item: item, onClick: props.onItemClick }))
}

ListCard(props) -> {
    click: props.onClick
    style: CardListVariants.card.base + " " + CardListVariants.card.list.container + " cursor-pointer"
    children: [
        props.item.image ? ListCardImage({ src: props.item.image, alt: props.item.title }) : null,
        ListCardContent({ item: props.item })
    ]
}

ListCardImage(props) -> {
    type: img
    src: props.src
    alt: props.alt
    style: CardListVariants.card.list.image
}

ListCardContent(props) -> {
    style: CardListVariants.card.list.content
    children: [
        ListCardTitle({ text: props.item.title }),
        props.item.description ? ListCardDescription({ text: props.item.description }) : null,
        props.item.meta ? ListCardMeta({ meta: props.item.meta }) : null
    ]
}

ListCardTitle(props) -> {
    type: text
    content: props.text
    style: CardListVariants.card.list.title
}

ListCardDescription(props) -> {
    type: text
    content: props.text
    style: CardListVariants.card.list.description
}

ListCardMeta(props) -> {
    style: CardListVariants.card.list.meta
    children: props.meta.map(m => MetaItem({ text: m }))
}

// =============================================================================
// Column Presets
// =============================================================================

TwoColumnCardList(props) -> CardList({ ...props, columns: 2 })
ThreeColumnCardList(props) -> CardList({ ...props, columns: 3 })
FourColumnCardList(props) -> CardList({ ...props, columns: 4 })

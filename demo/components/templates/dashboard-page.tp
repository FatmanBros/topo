// Dashboard page template
import { DashboardLayout } from "./dashboard-layout.tp"
import { DashboardHeader } from "../organisms/dashboard-header.tp"
import { Card } from "../atoms/card.tp"
import { StatCard } from "../atoms/stat-card.tp"
import { ActionButton } from "../atoms/button.tp"
import { ActivityItem } from "../molecules/activity-item.tp"

DashboardPage -> DashboardLayout([DashboardHeader, StatCardsGrid, DashboardContent])

StatCardsGrid -> {
    style: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8"
    children: [
        StatCard({ label: "Total Users", value: "12,345", change: "+12.5%", positive: true }),
        StatCard({ label: "Revenue", value: "$45,678", change: "+8.2%", positive: true }),
        StatCard({ label: "Active Sessions", value: "1,234", change: "-3.1%", positive: false }),
        StatCard({ label: "Conversion Rate", value: "3.24%", change: "+0.8%", positive: true })
    ]
}

DashboardContent -> {
    style: "grid grid-cols-1 lg:grid-cols-3 gap-6"
    children: [RecentActivityCard, QuickActionsCard]
}

RecentActivityCard -> {
    style: "lg:col-span-2"
    children: [
        Card({
            title: "Recent Activity",
            children: [ActivityList]
        })
    ]
}

ActivityList -> {
    align: vertical
    style: "space-y-0"
    children: [
        ActivityItem({ user: "Alice", action: "created a new project", time: "2 minutes ago" }),
        ActivityItem({ user: "Bob", action: "updated the dashboard", time: "15 minutes ago" }),
        ActivityItem({ user: "Carol", action: "completed a task", time: "1 hour ago" }),
        ActivityItem({ user: "Dave", action: "joined the team", time: "3 hours ago" })
    ]
}

QuickActionsCard -> Card({
    title: "Quick Actions",
    children: [QuickActionButtons]
})

QuickActionButtons -> {
    style: "grid grid-cols-2 gap-3"
    children: [
        ActionButton({ label: "New Project" }),
        ActionButton({ label: "Add User" }),
        ActionButton({ label: "Generate Report" }),
        ActionButton({ label: "Settings" })
    ]
}


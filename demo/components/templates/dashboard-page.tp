// Dashboard page template
import { DashboardHeader } from "../organisms/dashboard-header.tp"
import { DashboardSidebar } from "../organisms/dashboard-sidebar.tp"
import { StatCards } from "../organisms/stat-cards.tp"
import { ActivityFeed } from "../organisms/activity-feed.tp"
import { QuickActions } from "../organisms/quick-actions.tp"

DashboardPage -> {
    style: "min-h-screen bg-gray-50"
    children: [DashboardSidebar, DashboardMain]
}

DashboardMain -> {
    style: "ml-64 p-8"
    align: vertical
    children: [DashboardHeader, StatCards, DashboardContent]
}

DashboardContent -> {
    style: "grid grid-cols-1 lg:grid-cols-3 gap-6"
    children: [ActivityFeedWrapper, QuickActionsWrapper]
}

ActivityFeedWrapper -> {
    style: "lg:col-span-2"
    children: [ActivityFeed]
}

QuickActionsWrapper -> {
    children: [QuickActions]
}

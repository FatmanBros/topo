// Link Atom - Styled anchor/link component
// Usage: Link({ href: "/page", children: "Click here", variant: "primary" })

import { LinkVariants } from "../../theme/variants/link.tp"

// =============================================================================
// Base Link Component
// =============================================================================

Link(props) -> {
    type: a
    href: props.href
    target: props.external ? "_blank" : props.target
    rel: props.external ? "noopener noreferrer" : props.rel
    click: props.onClick
    style: LinkVariants.base
         + " " + LinkVariants.variant[props.variant || "primary"]
         + " " + LinkVariants.underline[props.underline || "hover"]
         + " " + LinkVariants.size[props.size || "md"]
         + " " + LinkVariants.weight[props.weight || "normal"]
         + (props.disabled ? " " + LinkVariants.disabled : "")
         + (props.className ? " " + props.className : "")
    children: [
        props.children,
        props.external ? ExternalIcon({}) : null
    ]
}

ExternalIcon(props) -> {
    type: svg
    style: LinkVariants.external.icon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    ariaHidden: true
    children: [
        ExternalIconPath({})
    ]
}

ExternalIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    d: "M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5zm7.25.25a.75.75 0 01.75-.75h4a.75.75 0 01.75.75v4a.75.75 0 01-1.5 0V6.56l-5.22 5.22a.75.75 0 11-1.06-1.06l5.22-5.22h-3.19a.75.75 0 01-.75-.75z"
    clipRule: "evenodd"
}

// =============================================================================
// Variant Presets
// =============================================================================

PrimaryLink(props) -> Link({ ...props, variant: "primary" })
SecondaryLink(props) -> Link({ ...props, variant: "secondary" })
SubtleLink(props) -> Link({ ...props, variant: "subtle" })
DangerLink(props) -> Link({ ...props, variant: "danger" })
SuccessLink(props) -> Link({ ...props, variant: "success" })

// =============================================================================
// External Link Preset
// =============================================================================

ExternalLink(props) -> Link({ ...props, external: true })

Button(content, onClick, style, buttonType) -> {
    type: buttonType
    content: content
    click: onClick
    style: style
}

PrimaryButton(content, onClick) -> Button(content, onClick, "w-full bg-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-indigo-700 transition", button)

SubmitButton(content, onClick) -> Button(content, onClick, "w-full bg-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-indigo-700 transition cursor-pointer", submit)

Textarea(placeholder, value, onInput, rows) -> {
    type: textarea
    placeholder: placeholder
    value: value
    input: onInput
    rows: rows
    style: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition resize-y"
}

// Sidebar navigation molecule
import { SidebarItem } from "../atoms/sidebar-item.tp"

SidebarNav(props) -> {
    align: vertical
    style: "space-y-2"
    children: props.items.for(item => {
        SidebarItem({
            label: item.label,
            href: item.href,
            icon: item.icon,
            active: item.active
        })
    })
}

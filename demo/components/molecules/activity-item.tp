// Activity item molecule - shows user action with avatar
ActivityItem(user, action, time) -> {
    style: "flex items-center gap-3 py-3 border-b border-gray-100 last:border-0"
    children: [
        ActivityAvatar({ user: user }),
        ActivityDetails({ user: user, action: action, time: time })
    ]
}

ActivityAvatar(user) -> {
    type: text
    content: user
    style: "w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-medium text-gray-600"
}

ActivityDetails(user, action, time) -> {
    align: vertical
    children: [
        ActivityText({ text: user + " " + action }),
        ActivityTime({ time: time })
    ]
}

ActivityText(text) -> {
    type: text
    content: text
    style: "text-sm text-gray-700"
}

ActivityTime(time) -> {
    type: text
    content: time
    style: "text-xs text-gray-400"
}

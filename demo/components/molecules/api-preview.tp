// API Preview - Renders a list of API endpoints
import { Text } from "@/components/atoms/text.tp"

ApiPreview(props) -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: props.endpoints.for(endpoint => {
        ApiLine({
            method: endpoint.method,
            path: endpoint.path,
            desc: endpoint.desc
        })
    })
}

ApiLine(props) -> {
    style: "flex items-center gap-2"
    children: [
        ApiMethod({ method: props.method }),
        Text({ text: props.path, style: "text-gray-600" }),
        Text({ text: props.desc, style: "text-gray-400 text-xs" })
    ]
}

ApiMethod(props) -> Text({
    text: props.method,
    style: props.method == "GET" ? "px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold"
         : props.method == "POST" ? "px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-bold"
         : props.method == "PUT" ? "px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs font-bold"
         : "px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs font-bold"
})

import { Text } from "@packages/components/atoms/text.tp"

SimpleCard(title, desc) -> {
    style: "bg-white p-6 rounded-xl shadow-sm border border-gray-100"
    align: vertical
    children: [
        Text(title, "text-xl font-semibold text-gray-800 mb-2"),
        Text(desc, "text-gray-600")
    ]
}

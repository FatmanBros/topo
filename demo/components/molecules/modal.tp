// Modal Molecule - Dialog/overlay component
// Usage: Modal({ isOpen: true, title: "Confirm", onClose: handler, children: [...] })

import { ModalVariants } from "../../theme/variants/modal.tp"

// =============================================================================
// Base Modal Component
// =============================================================================

Modal(props) -> {
    when: props.isOpen
    style: ModalVariants.overlay
    click: props.closeOnOverlay != false ? props.onClose : null
    children: [
        ModalContainer({
            size: props.size || "md",
            title: props.title,
            onClose: props.onClose,
            children: props.children,
            footer: props.footer,
            showClose: props.showClose != false
        })
    ]
}

ModalContainer(props) -> {
    role: "dialog"
    ariaModal: true
    click: stopPropagation
    style: ModalVariants.container + " " + ModalVariants.size[props.size]
    children: [
        props.title || props.showClose ? ModalHeader({
            title: props.title,
            onClose: props.onClose,
            showClose: props.showClose
        }) : null,
        ModalBody({ children: props.children }),
        props.footer ? ModalFooter({ children: props.footer }) : null
    ]
}

// =============================================================================
// Modal Header
// =============================================================================

ModalHeader(props) -> {
    style: ModalVariants.header
    children: [
        props.title ? ModalTitle({ text: props.title }) : ModalSpacer({}),
        props.showClose ? ModalCloseButton({ onClick: props.onClose }) : null
    ]
}

ModalTitle(props) -> {
    type: text
    content: props.text
    style: ModalVariants.title
}

ModalSpacer(props) -> {
    style: "flex-1"
}

ModalCloseButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Close modal"
    style: ModalVariants.closeButton
    children: [
        CloseIcon({})
    ]
}

CloseIcon(props) -> {
    type: svg
    style: ModalVariants.closeIcon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        CloseIconPath({})
    ]
}

CloseIconPath(props) -> {
    type: path
    d: "M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"
}

// =============================================================================
// Modal Body
// =============================================================================

ModalBody(props) -> {
    style: ModalVariants.body
    children: props.children
}

// =============================================================================
// Modal Footer
// =============================================================================

ModalFooter(props) -> {
    style: ModalVariants.footer
    children: props.children
}

// =============================================================================
// Size Presets
// =============================================================================

SmallModal(props) -> Modal({ ...props, size: "sm" })
LargeModal(props) -> Modal({ ...props, size: "lg" })
FullModal(props) -> Modal({ ...props, size: "full" })

// =============================================================================
// Confirmation Modal (preset with confirm/cancel buttons)
// =============================================================================

ConfirmModal(props) -> Modal({
    isOpen: props.isOpen,
    title: props.title,
    onClose: props.onCancel,
    size: props.size || "sm",
    children: props.message,
    footer: [
        CancelButton({ onClick: props.onCancel, text: props.cancelText || "Cancel" }),
        ConfirmButton({
            onClick: props.onConfirm,
            text: props.confirmText || "Confirm",
            variant: props.variant || "primary"
        })
    ]
})

CancelButton(props) -> {
    type: button
    click: props.onClick
    style: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
    content: props.text
}

ConfirmButton(props) -> {
    type: button
    click: props.onClick
    style: "px-4 py-2 text-sm font-medium text-white rounded-lg transition-colors"
         + (props.variant == "danger" ? " bg-red-600 hover:bg-red-700" : " bg-indigo-600 hover:bg-indigo-700")
    content: props.text
}

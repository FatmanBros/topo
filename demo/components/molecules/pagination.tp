// Pagination Molecule - Page navigation component
// Usage: Pagination({ currentPage: 1, totalPages: 10, onChange: handler })

import { PaginationVariants } from "../../theme/variants/pagination.tp"

// =============================================================================
// Base Pagination Component
// =============================================================================

Pagination(props) -> {
    role: "navigation"
    ariaLabel: "Pagination"
    style: PaginationVariants.container + (props.className ? " " + props.className : "")
    children: [
        PaginationPrev({
            disabled: props.currentPage <= 1,
            onClick: props.onChange,
            currentPage: props.currentPage,
            size: props.size || "md",
            showLabel: props.showLabels
        }),
        PaginationPages({
            currentPage: props.currentPage,
            totalPages: props.totalPages,
            onChange: props.onChange,
            size: props.size || "md",
            siblingCount: props.siblingCount || 1
        }),
        PaginationNext({
            disabled: props.currentPage >= props.totalPages,
            onClick: props.onChange,
            currentPage: props.currentPage,
            totalPages: props.totalPages,
            size: props.size || "md",
            showLabel: props.showLabels
        })
    ]
}

// =============================================================================
// Previous Button
// =============================================================================

PaginationPrev(props) -> {
    type: button
    disabled: props.disabled
    click: props.onClick
    ariaLabel: "Previous page"
    style: PaginationVariants.button.base
         + " " + PaginationVariants.size[props.size]
         + " " + PaginationVariants.nav.prev
         + " " + (props.disabled ? PaginationVariants.button.disabled : PaginationVariants.button.default)
    children: [
        PrevIcon({}),
        props.showLabel ? PaginationLabel({ text: "Previous" }) : null
    ]
}

PrevIcon(props) -> {
    type: svg
    style: PaginationVariants.navIcon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        PrevIconPath({})
    ]
}

PrevIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
}

// =============================================================================
// Next Button
// =============================================================================

PaginationNext(props) -> {
    type: button
    disabled: props.disabled
    click: props.onClick
    ariaLabel: "Next page"
    style: PaginationVariants.button.base
         + " " + PaginationVariants.size[props.size]
         + " " + PaginationVariants.nav.next
         + " " + (props.disabled ? PaginationVariants.button.disabled : PaginationVariants.button.default)
    children: [
        props.showLabel ? PaginationLabel({ text: "Next" }) : null,
        NextIcon({})
    ]
}

NextIcon(props) -> {
    type: svg
    style: PaginationVariants.navIcon
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [
        NextIconPath({})
    ]
}

NextIconPath(props) -> {
    type: path
    fillRule: "evenodd"
    clipRule: "evenodd"
    d: "M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
}

PaginationLabel(props) -> {
    type: text
    content: props.text
}

// =============================================================================
// Page Numbers
// =============================================================================

PaginationPages(props) -> {
    style: "flex items-center gap-1"
    children: generatePageNumbers(props.currentPage, props.totalPages, props.siblingCount).for(page => {
        page == "ellipsis"
            ? PaginationEllipsis({})
            : PageButton({
                page: page,
                isActive: page == props.currentPage,
                onClick: props.onChange,
                size: props.size
            })
    })
}

PageButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Page " + props.page
    ariaCurrent: props.isActive ? "page" : null
    style: PaginationVariants.button.base
         + " " + PaginationVariants.size[props.size]
         + " " + (props.isActive ? PaginationVariants.button.active : PaginationVariants.button.default)
    content: props.page
}

PaginationEllipsis(props) -> {
    type: text
    content: "..."
    style: PaginationVariants.ellipsis
}

// =============================================================================
// Simple Pagination (just prev/next)
// =============================================================================

SimplePagination(props) -> {
    role: "navigation"
    ariaLabel: "Pagination"
    style: PaginationVariants.container + (props.className ? " " + props.className : "")
    children: [
        PaginationPrev({
            disabled: props.currentPage <= 1,
            onClick: props.onChange,
            currentPage: props.currentPage,
            size: props.size || "md",
            showLabel: true
        }),
        PaginationInfo({
            currentPage: props.currentPage,
            totalPages: props.totalPages
        }),
        PaginationNext({
            disabled: props.currentPage >= props.totalPages,
            onClick: props.onChange,
            currentPage: props.currentPage,
            totalPages: props.totalPages,
            size: props.size || "md",
            showLabel: true
        })
    ]
}

PaginationInfo(props) -> {
    type: text
    content: "Page " + props.currentPage + " of " + props.totalPages
    style: PaginationVariants.info
}

// =============================================================================
// Size Presets
// =============================================================================

SmallPagination(props) -> Pagination({ ...props, size: "sm" })
LargePagination(props) -> Pagination({ ...props, size: "lg" })

// Feature List - Checkmark list for feature highlights
import { Text } from "@/components/atoms/text.tp"

FeatureList(props) -> {
    align: vertical
    style: "space-y-2 text-sm"
    children: [
        Text({ text: props.title, style: "font-medium text-gray-700" }),
        ...props.items.for(item => { FeatureItem(item) })
    ]
}

FeatureItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.icon, style: "text-green-500" }),
        Text({ text: props.text, style: "text-gray-600" })
    ]
}

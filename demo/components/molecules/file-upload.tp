// FileUpload Molecule - File upload dropzone
// Usage: FileUpload({ onUpload: handler, accept: "image/*", multiple: true })

import { FileUploadVariants } from "../../theme/variants/file-upload.tp"

// =============================================================================
// Base FileUpload Component
// =============================================================================

FileUpload(props) -> {
    style: FileUploadVariants.dropzone.base
         + " " + (props.isDragActive
             ? FileUploadVariants.dropzone.active
             : FileUploadVariants.dropzone.default)
         + " " + FileUploadVariants.size[props.size || "md"]
         + (props.disabled ? " " + FileUploadVariants.dropzone.disabled : "")
         + (props.error ? " " + FileUploadVariants.error.border : "")
         + (props.className ? " " + props.className : "")
    children: [
        FileUploadInput({
            accept: props.accept,
            multiple: props.multiple,
            onChange: props.onUpload,
            disabled: props.disabled
        }),
        FileUploadContent({
            size: props.size || "md",
            title: props.title,
            description: props.description,
            hint: props.hint
        }),
        props.error ? FileUploadError({ message: props.error }) : null,
        props.files && props.files.length > 0 ? FileList({
            files: props.files,
            onRemove: props.onRemove
        }) : null
    ]
}

// =============================================================================
// Hidden Input
// =============================================================================

FileUploadInput(props) -> {
    type: input
    inputType: "file"
    accept: props.accept
    multiple: props.multiple
    change: props.onChange
    disabled: props.disabled
    style: "absolute inset-0 w-full h-full opacity-0 cursor-pointer"
}

// =============================================================================
// Content
// =============================================================================

FileUploadContent(props) -> {
    style: FileUploadVariants.content
    children: [
        UploadIcon({ size: props.size }),
        UploadTitle({ text: props.title }),
        UploadDescription({ text: props.description }),
        props.hint ? UploadHint({ text: props.hint }) : null
    ]
}

UploadIcon(props) -> {
    style: FileUploadVariants.icon.container
    children: [UploadIconSvg({ size: props.size })]
}

UploadIconSvg(props) -> {
    type: svg
    style: FileUploadVariants.icon.size[props.size] + " " + FileUploadVariants.icon.style
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [UploadIconPath({})]
}

UploadIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"
}

UploadTitle(props) -> {
    style: FileUploadVariants.title
    children: [
        UploadTitleText({ text: props.text || "Drop files here or " }),
        BrowseLink({})
    ]
}

UploadTitleText(props) -> {
    type: text
    content: props.text
}

BrowseLink(props) -> {
    type: text
    content: "browse"
    style: FileUploadVariants.browse
}

UploadDescription(props) -> {
    type: text
    content: props.text || "Upload files from your computer"
    style: FileUploadVariants.description
}

UploadHint(props) -> {
    type: text
    content: props.text
    style: FileUploadVariants.hint
}

// =============================================================================
// Error Message
// =============================================================================

FileUploadError(props) -> {
    type: text
    content: props.message
    style: FileUploadVariants.error.text
}

// =============================================================================
// File List
// =============================================================================

FileList(props) -> {
    style: FileUploadVariants.fileList.container
    children: props.files.map((file, index) => FileListItem({
        file: file,
        onRemove: props.onRemove,
        index: index
    }))
}

FileListItem(props) -> {
    style: FileUploadVariants.fileList.item
    children: [
        FileIcon({}),
        FileInfo({ name: props.file.name, size: props.file.size }),
        props.onRemove ? RemoveButton({ onClick: props.onRemove, index: props.index }) : null
    ]
}

FileIcon(props) -> {
    type: svg
    style: FileUploadVariants.fileList.icon
    viewBox: "0 0 24 24"
    fill: "none"
    stroke: "currentColor"
    strokeWidth: "1.5"
    children: [FileIconPath({})]
}

FileIconPath(props) -> {
    type: path
    strokeLinecap: "round"
    strokeLinejoin: "round"
    d: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
}

FileInfo(props) -> {
    style: FileUploadVariants.fileList.info
    children: [
        FileName({ name: props.name }),
        FileSize({ size: props.size })
    ]
}

FileName(props) -> {
    type: text
    content: props.name
    style: FileUploadVariants.fileList.name
}

FileSize(props) -> {
    type: text
    content: formatFileSize(props.size)
    style: FileUploadVariants.fileList.size
}

RemoveButton(props) -> {
    type: button
    click: props.onClick
    ariaLabel: "Remove file"
    style: FileUploadVariants.fileList.remove
    children: [RemoveIcon({})]
}

RemoveIcon(props) -> {
    type: svg
    style: "h-4 w-4"
    viewBox: "0 0 20 20"
    fill: "currentColor"
    children: [RemoveIconPath({})]
}

RemoveIconPath(props) -> {
    type: path
    d: "M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"
}

// =============================================================================
// Presets
// =============================================================================

ImageUpload(props) -> FileUpload({
    ...props,
    accept: "image/*",
    title: "Drop images here or ",
    description: "PNG, JPG, GIF up to 10MB",
    hint: props.hint
})

DocumentUpload(props) -> FileUpload({
    ...props,
    accept: ".pdf,.doc,.docx,.txt",
    title: "Drop documents here or ",
    description: "PDF, DOC, DOCX, TXT",
    hint: props.hint
})

import { Button } from "@packages/components/atoms/button.tp"

LangJa -> Button("日本語", $i18n.setLocale("ja"), "px-3 py-1 text-sm rounded bg-gray-200 hover:bg-gray-300 mr-2", "button")

LangEn -> Button("English", $i18n.setLocale("en"), "px-3 py-1 text-sm rounded bg-gray-200 hover:bg-gray-300", "button")

LangSwitcher -> {
    style: "flex justify-center mb-4"
    align: horizontal
    children: [LangJa, LangEn]
}

// Radio Variants - Style definitions for Radio component

RadioVariants -> {
    container: "inline-flex items-center gap-2 cursor-pointer",

    input: "peer h-4 w-4 shrink-0 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50",

    variant: {
        primary: "checked:border-indigo-600 checked:bg-indigo-600 focus:ring-indigo-500",
        secondary: "checked:border-gray-600 checked:bg-gray-600 focus:ring-gray-500",
        success: "checked:border-green-600 checked:bg-green-600 focus:ring-green-500",
        danger: "checked:border-red-600 checked:bg-red-600 focus:ring-red-500"
    },

    size: {
        sm: "h-3.5 w-3.5",
        md: "h-4 w-4",
        lg: "h-5 w-5"
    },

    label: "text-sm text-gray-700 select-none peer-disabled:opacity-50",

    description: "text-xs text-gray-500 mt-0.5",

    group: {
        vertical: "flex flex-col gap-2",
        horizontal: "flex flex-row gap-4 flex-wrap"
    }
}

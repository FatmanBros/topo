// CardList Variants - Style definitions for CardList component

import { ColorStyles, Radius, Shadows } from "../tokens.tp"

CardListVariants -> {
    container: "w-full",

    // View toggle
    viewToggle: {
        container: "flex items-center gap-1 p-1 bg-gray-100 " + Radius.lg,
        button: {
            base: "p-2 " + Radius.md + " transition-colors",
            active: "bg-white " + Shadows.sm + " " + ColorStyles.neutral.text,
            inactive: ColorStyles.neutral.textMuted + " hover:text-gray-600"
        },
        icon: "h-4 w-4"
    },

    // Grid layout
    grid: {
        container: "grid gap-4",
        cols: {
            1: "grid-cols-1",
            2: "grid-cols-1 sm:grid-cols-2",
            3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
            4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        }
    },

    // List layout
    list: {
        container: "flex flex-col gap-3"
    },

    // Card item
    card: {
        base: "bg-white border " + ColorStyles.neutral.borderLight + " " + Radius.lg + " overflow-hidden transition-shadow hover:" + Shadows.md,

        // Grid card
        grid: {
            image: "aspect-video w-full object-cover",
            content: "p-4",
            title: "font-semibold " + ColorStyles.neutral.text + " truncate",
            description: "text-sm " + ColorStyles.neutral.textLight + " mt-1 line-clamp-2",
            meta: "flex items-center gap-2 mt-3 text-xs " + ColorStyles.neutral.textMuted
        },

        // List card
        list: {
            container: "flex gap-4",
            image: "w-24 h-24 object-cover flex-shrink-0 " + Radius.md,
            content: "flex-1 py-1",
            title: "font-semibold " + ColorStyles.neutral.text,
            description: "text-sm " + ColorStyles.neutral.textLight + " mt-1",
            meta: "flex items-center gap-2 mt-2 text-xs " + ColorStyles.neutral.textMuted
        }
    },

    // Loading skeleton
    skeleton: {
        grid: "aspect-video bg-gray-200 animate-pulse " + Radius.lg,
        list: "h-24 bg-gray-200 animate-pulse " + Radius.md
    }
}

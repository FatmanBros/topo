// Stepper Variants - Style definitions for Stepper component

import { ColorStyles, Radius } from "../tokens.tp"

StepperVariants -> {
    container: "w-full",

    // Horizontal layout
    horizontal: {
        list: "flex items-center",
        step: "flex-1 flex items-center",
        connector: "flex-1 h-0.5 mx-2"
    },

    // Vertical layout
    vertical: {
        list: "flex flex-col",
        step: "flex items-start",
        connector: "w-0.5 min-h-[24px] ml-4 my-1"
    },

    // Step indicator (circle/number)
    indicator: {
        base: "flex items-center justify-center rounded-full font-medium transition-colors flex-shrink-0",
        size: {
            sm: "h-6 w-6 text-xs",
            md: "h-8 w-8 text-sm",
            lg: "h-10 w-10 text-base"
        },
        // States
        completed: ColorStyles.primary.bg + " text-white",
        active: "border-2 " + ColorStyles.primary.border + " " + ColorStyles.primary.text + " bg-white",
        pending: "border-2 " + ColorStyles.neutral.borderLight + " " + ColorStyles.neutral.textMuted + " bg-white",
        error: ColorStyles.danger.bg + " text-white"
    },

    // Step content
    content: {
        container: "ml-3 flex-1",
        title: {
            base: "font-medium",
            completed: ColorStyles.neutral.text,
            active: ColorStyles.primary.text,
            pending: ColorStyles.neutral.textMuted
        },
        description: {
            base: "text-sm mt-0.5",
            style: ColorStyles.neutral.textLight
        }
    },

    // Connector line
    connector: {
        completed: ColorStyles.primary.bg,
        active: "bg-gray-200",
        pending: "bg-gray-200"
    },

    // Clickable steps
    clickable: "cursor-pointer hover:opacity-80 transition-opacity",

    // Check icon for completed
    checkIcon: "h-4 w-4"
}

// Avatar Variants - Style definitions for Avatar component

AvatarVariants -> {
    base: "inline-flex items-center justify-center font-medium overflow-hidden bg-gray-200 text-gray-600",

    shape: {
        circle: "rounded-full",
        square: "rounded-lg"
    },

    size: {
        xs: "h-6 w-6 text-xs",
        sm: "h-8 w-8 text-sm",
        md: "h-10 w-10 text-base",
        lg: "h-12 w-12 text-lg",
        xl: "h-16 w-16 text-xl",
        xxl: "h-20 w-20 text-2xl"
    },

    status: {
        online: "bg-green-500",
        offline: "bg-gray-400",
        busy: "bg-red-500",
        away: "bg-amber-500"
    },

    ring: "ring-2 ring-offset-2 ring-indigo-500"
}

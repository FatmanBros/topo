// Modal Variants - Style definitions for Modal component

import { ColorStyles, Shadows } from "../tokens.tp"

ModalVariants -> {
    overlay: "fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4",

    container: "relative bg-white rounded-xl " + Shadows.xl + " max-h-[90vh] overflow-hidden flex flex-col",

    size: {
        sm: "w-full max-w-sm",
        md: "w-full max-w-md",
        lg: "w-full max-w-lg",
        xl: "w-full max-w-xl",
        full: "w-full max-w-4xl"
    },

    header: "flex items-center justify-between px-6 py-4 border-b " + ColorStyles.neutral.borderLight,

    title: "text-lg font-semibold " + ColorStyles.neutral.text,

    closeButton: "p-2 rounded-lg hover:bg-gray-100 transition-colors " + ColorStyles.neutral.textLight,

    closeIcon: "h-5 w-5",

    body: "flex-1 overflow-auto px-6 py-4",

    footer: "flex items-center justify-end gap-3 px-6 py-4 border-t " + ColorStyles.neutral.borderLight,

    // Animation classes
    animation: {
        enter: "animate-fade-in",
        leave: "animate-fade-out"
    }
}

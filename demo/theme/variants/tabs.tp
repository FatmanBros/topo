// Tabs Variants - Style definitions for Tabs component

import { ColorStyles } from "../tokens.tp"

TabsVariants -> {
    container: "w-full",

    // Tab list styles
    list: {
        base: "flex",
        line: "border-b " + ColorStyles.neutral.borderLight,
        pills: "gap-1 p-1 bg-gray-100 rounded-lg",
        enclosed: "border-b " + ColorStyles.neutral.borderLight
    },

    // Individual tab styles
    tab: {
        base: "inline-flex items-center justify-center gap-2 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 " + ColorStyles.primary.focusRing,

        // Line style
        line: {
            default: "px-4 py-2 -mb-px border-b-2 border-transparent " + ColorStyles.neutral.textLight + " hover:" + ColorStyles.neutral.text,
            active: "px-4 py-2 -mb-px border-b-2 " + ColorStyles.primary.border + " " + ColorStyles.primary.text
        },

        // Pills style
        pills: {
            default: "px-3 py-1.5 rounded-md " + ColorStyles.neutral.textLight + " hover:" + ColorStyles.neutral.text,
            active: "px-3 py-1.5 rounded-md bg-white shadow-sm " + ColorStyles.neutral.text
        },

        // Enclosed style
        enclosed: {
            default: "px-4 py-2 border border-transparent " + ColorStyles.neutral.textLight + " hover:" + ColorStyles.neutral.text,
            active: "px-4 py-2 border " + ColorStyles.neutral.borderLight + " border-b-white bg-white rounded-t-lg -mb-px"
        },

        disabled: "opacity-50 cursor-not-allowed"
    },

    // Size variants
    size: {
        sm: "text-sm",
        md: "text-base",
        lg: "text-lg"
    },

    // Tab icon
    icon: "h-4 w-4",

    // Tab badge/count
    badge: "ml-2 px-2 py-0.5 text-xs rounded-full bg-gray-100 " + ColorStyles.neutral.text,

    // Tab panel
    panel: "py-4 focus:outline-none"
}

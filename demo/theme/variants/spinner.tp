// Spinner Variants - Style definitions for Spinner component

SpinnerVariants -> {
    base: "inline-block animate-spin rounded-full border-2 border-solid border-current border-r-transparent",

    variant: {
        primary: "text-indigo-600",
        secondary: "text-gray-600",
        white: "text-white",
        current: "text-current"
    },

    size: {
        xs: "h-3 w-3 border",
        sm: "h-4 w-4 border",
        md: "h-6 w-6 border-2",
        lg: "h-8 w-8 border-2",
        xl: "h-12 w-12 border-4"
    }
}

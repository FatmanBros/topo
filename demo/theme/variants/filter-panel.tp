// FilterPanel Variants - Style definitions for FilterPanel component

import { ColorStyles, Radius } from "../tokens.tp"

FilterPanelVariants -> {
    container: {
        base: "bg-white border " + ColorStyles.neutral.borderLight + " " + Radius.lg,
        inline: "p-4",
        sidebar: "p-4 w-64",
        modal: "p-6"
    },

    // Header
    header: {
        container: "flex items-center justify-between mb-4",
        title: "font-semibold " + ColorStyles.neutral.text,
        clearAll: "text-sm " + ColorStyles.primary.text + " hover:underline"
    },

    // Filter sections
    section: {
        container: "border-b " + ColorStyles.neutral.borderLight + " py-4 last:border-b-0",
        header: "flex items-center justify-between cursor-pointer",
        title: "font-medium text-sm " + ColorStyles.neutral.text,
        chevron: "h-4 w-4 " + ColorStyles.neutral.textMuted + " transition-transform",
        chevronOpen: "rotate-180",
        content: "mt-3 space-y-2"
    },

    // Filter types
    checkbox: {
        container: "flex items-center gap-2",
        label: "text-sm " + ColorStyles.neutral.text,
        count: "text-xs " + ColorStyles.neutral.textMuted + " ml-auto"
    },

    radio: {
        container: "flex items-center gap-2",
        label: "text-sm " + ColorStyles.neutral.text
    },

    range: {
        container: "space-y-2",
        inputs: "flex items-center gap-2",
        input: "w-full px-3 py-1.5 text-sm border " + ColorStyles.neutral.borderLight + " " + Radius.md,
        separator: ColorStyles.neutral.textMuted
    },

    select: {
        container: "w-full",
        trigger: "w-full px-3 py-2 text-sm text-left border " + ColorStyles.neutral.borderLight + " " + Radius.md + " flex items-center justify-between"
    },

    // Active filters (chips)
    activeFilters: {
        container: "flex flex-wrap gap-2 mb-4",
        chip: {
            base: "inline-flex items-center gap-1 px-2 py-1 text-xs " + Radius.full,
            style: ColorStyles.primary.bgLight + " " + ColorStyles.primary.text,
            remove: "hover:bg-indigo-200 " + Radius.full + " p-0.5"
        }
    },

    // Footer actions
    footer: {
        container: "flex items-center gap-2 mt-4 pt-4 border-t " + ColorStyles.neutral.borderLight,
        apply: "flex-1",
        reset: "flex-1"
    }
}

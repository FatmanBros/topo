// Skeleton Variants - Style definitions for Skeleton loader component

import { Radius } from "../tokens.tp"

SkeletonVariants -> {
    base: "animate-pulse bg-gray-200",

    variant: {
        default: "bg-gray-200",
        light: "bg-gray-100",
        dark: "bg-gray-300"
    },

    radius: {
        none: Radius.none,
        sm: Radius.sm,
        md: Radius.md,
        lg: Radius.lg,
        full: Radius.full
    },

    // Preset shapes
    text: "h-4 w-full",
    heading: "h-8 w-3/4",
    avatar: "rounded-full",
    button: "h-10 w-24",
    thumbnail: "aspect-square",
    card: "h-48 w-full",

    // Common widths
    width: {
        quarter: "w-1/4",
        third: "w-1/3",
        half: "w-1/2",
        twoThirds: "w-2/3",
        threeQuarters: "w-3/4",
        full: "w-full"
    },

    // Common heights
    height: {
        xs: "h-2",
        sm: "h-4",
        md: "h-6",
        lg: "h-8",
        xl: "h-12"
    },

    // Sizes for avatar-like skeletons
    size: {
        xs: "h-6 w-6",
        sm: "h-8 w-8",
        md: "h-10 w-10",
        lg: "h-12 w-12",
        xl: "h-16 w-16"
    }
}

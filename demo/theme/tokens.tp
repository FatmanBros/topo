// =============================================================================
// Spacing & Sizing
// =============================================================================

Sizes -> {
    xs: { py: "py-1", px: "px-2", text: "text-xs", h: "h-6", w: "w-6" },
    sm: { py: "py-1.5", px: "px-3", text: "text-sm", h: "h-8", w: "w-8" },
    md: { py: "py-2", px: "px-4", text: "text-base", h: "h-10", w: "w-10" },
    lg: { py: "py-2.5", px: "px-5", text: "text-lg", h: "h-12", w: "w-12" },
    xl: { py: "py-3", px: "px-6", text: "text-xl", h: "h-14", w: "w-14" }
}

// =============================================================================
// Border Radius
// =============================================================================

Radius -> {
    none: "rounded-none",
    sm: "rounded",
    md: "rounded-md",
    lg: "rounded-lg",
    xl: "rounded-xl",
    full: "rounded-full"
}

// =============================================================================
// Shadows
// =============================================================================

Shadows -> {
    none: "shadow-none",
    sm: "shadow-sm",
    md: "shadow",
    lg: "shadow-lg",
    xl: "shadow-xl"
}

// =============================================================================
// Transitions
// =============================================================================

Transitions -> {
    none: "",
    fast: "transition-all duration-150",
    normal: "transition-all duration-200",
    slow: "transition-all duration-300"
}

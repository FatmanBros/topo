// LP Getting Started section - 3 step guide
import { CTAButton } from "../../../components/molecules/cta-button.tp"

LPGettingStarted -> {
    id: "getting-started"
    style: "py-24 bg-white"
    children: [GettingStartedContainer]
}

GettingStartedContainer -> {
    style: "max-w-4xl mx-auto px-6 text-center"
    align: vertical
    children: [
        GettingStartedTitle,
        GettingStartedSubtitle,
        GettingStartedSteps,
        GettingStartedCTA
    ]
}

GettingStartedTitle -> {
    type: text
    content: "Get Started in Seconds"
    style: "text-4xl font-bold text-gray-900 mb-4"
}

GettingStartedSubtitle -> {
    type: text
    content: "Three simple commands to start building"
    style: "text-xl text-gray-600 mb-12"
}

GettingStartedSteps -> {
    style: "space-y-4 mb-12"
    children: [
        GettingStartedStep({ number: "1", command: "cargo install --path .", label: "Install topo" }),
        GettingStartedStep({ number: "2", command: "topo new my-app", label: "Create a new project" }),
        GettingStartedStep({ number: "3", command: "cd my-app && topo start", label: "Start developing" })
    ]
}

GettingStartedStep(props) -> {
    style: "flex items-center gap-4 bg-gray-50 rounded-xl p-4 text-left"
    children: [
        StepNumber({ number: props.number }),
        StepContent({ command: props.command, label: props.label })
    ]
}

StepNumber(props) -> {
    type: text
    content: props.number
    style: "w-10 h-10 bg-gradient-to-r from-pink-500 to-violet-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0"
}

StepContent(props) -> {
    style: "flex-1"
    align: vertical
    children: [
        StepCommand({ command: props.command }),
        StepLabel({ label: props.label })
    ]
}

StepCommand(props) -> {
    type: text
    content: props.command
    style: "font-mono text-gray-900 font-medium"
}

StepLabel(props) -> {
    type: text
    content: props.label
    style: "text-sm text-gray-500"
}

GettingStartedCTA -> {
    style: "mt-8"
    children: [CTAButton({ href: "https://github.com/FatmanBros/topo", content: "View Documentation" })]
}

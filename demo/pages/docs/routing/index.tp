// Routing docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { Text } from "@packages/components/atoms/text.tp"

Page -> DocsTemplate({ children: [RoutingContent] })

RoutingContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        FileBasedSection,
        RouterSection,
        RoutesSection,
        DynamicRoutesSection,
        NavigationSection,
        LayoutsSection
    ]
}

PageHeader -> DocsSection({
    id: "routing",
    title: "Routing",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "topo uses file-based routing with optional router definition for navigation guards."
})

// File-based routing
FileBasedSection -> DocsCodeSection({
    title: "File-Based Routing",
    description: "Your file structure becomes your routes:",
    filename: "pages/",
    code: `
    pages/
    ├── index.tp          -> /
    ├── about/
    │   └── index.tp      -> /about
    ├── blog/
    │   ├── index.tp      -> /blog
    │   └── [slug]/
    │       └── index.tp  -> /blog/:slug
    ├── users/
    │   ├── index.tp      -> /users
    │   └── [id]/
    │       ├── index.tp  -> /users/:id
    │       └── edit.tp   -> /users/:id/edit
    └── docs/
        └── [...path]/
            └── index.tp  -> /docs/* (catch-all)`,
    preview: [ConfigPreview({
        items: [
            { label: "/", desc: "pages/index.tp" },
            { label: "/about", desc: "pages/about/index.tp" },
            { label: "/blog/:slug", desc: "pages/blog/[slug]/index.tp" },
            { label: "/users/:id", desc: "pages/users/[id]/index.tp" },
            { label: "/docs/*", desc: "pages/docs/[...path]/index.tp" }
        ]
    })]
})

// Router definition
RouterSection -> DocsCodeSection({
    title: "Router Definition",
    description: "Define routes with guards in routes.tp:",
    filename: "routes.tp",
    code: `
    // Sub-router for nested routes
    router DocsRouter {
        index: "/", []
        installation: "/installation", []
        quickStart: "/quick-start", []
    }

    // Main router with guards
    router {
        home: "/", []
        login: "/login", []
        dashboard: "/dashboard", [isAuth]
        admin: "/admin", [isAuth, isAdmin]
        docs: "/docs", [] -> DocsRouter
    }`,
    preview: [FeatureList({
        title: "Router features:",
        items: [
            { icon: "v", text: "Route-level guard arrays" },
            { icon: "v", text: "Sub-router references with ->" },
            { icon: "v", text: "Guards execute before navigation" },
            { icon: "v", text: "Type-safe .routeName navigation" }
        ]
    })]
})

// Routes definition (type-safe paths)
RoutesSection -> DocsCodeSection({
    title: "Routes Definition",
    description: "Type-safe path generation with Routes:",
    filename: "routes.tp",
    code: `
    // Named sub-routes
    Routes DocsRoutes {
        index: "/"
        installation: "/installation"
    }

    // Main routes with parameters
    Routes {
        home: "/"
        login: "/login"
        docs: "/docs" -> DocsRoutes
        userDetail(id): "/users/{id}"
        projectTask(projectId, taskId): "/projects/{projectId}/tasks/{taskId}"

        Guards {
            global: [isAuthenticated]
            skip: [home, login]
        }
    }

    // Usage: Routes.userDetail("123") -> "/users/123"
    // Usage: Routes.docs.installation() -> "/docs/installation"`,
    preview: [ConfigPreview({
        items: [
            { label: "Routes.home()", desc: "Returns \"/\"" },
            { label: "Routes.userDetail(\"123\")", desc: "Returns \"/users/123\"" },
            { label: "Routes.docs.installation()", desc: "Returns \"/docs/installation\"" }
        ]
    })]
})

// Dynamic routes
DynamicRoutesSection -> DocsCodeSection({
    title: "Dynamic Routes",
    description: "Use brackets for dynamic segments:",
    filename: "users/[id]/index.tp",
    code: `
    // Access route params via props
    Page(props) -> {
        children: [
            UserProfile({
                id: props.params.id
            })
        ]
    }

    // Or use the router
    UserProfile -> {
        init: UserStore.FetchUser(router.params.id)
        children: [
            UserHeader,
            UserDetails
        ]
    }`,
    preview: [DynamicPreview]
})

DynamicPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "Route: /users/123", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "params.id = \"123\"", style: "font-mono text-sm text-pink-600" })
    ]
}

// Navigation
NavigationSection -> DocsCodeSection({
    title: "Navigation",
    description: "Navigate using links, route references, or programmatically:",
    filename: "nav.tp",
    code: `
    // Declarative link
    NavLink -> {
        type: link
        href: "/about"
        content: "About Us"
    }

    // Using Routes for type-safe paths
    UserLink(id) -> {
        type: link
        href: Routes.userDetail(id)
        content: "View Profile"
    }

    // Effect-based navigation with guards
    LoginForm | {
        Effects {
            on LoginSuccess {
                navigate: .dashboard    // Uses router with guards
            }
            on GoToDocs {
                navigate: .docs.installation
            }
        }
    }

    // Programmatic navigation
    BackButton -> {
        type: button
        content: "Back"
        onClick: () => router.back()
    }`,
    preview: [NavigationPreview]
})

NavigationPreview -> {
    style: "flex gap-3"
    children: [
        NavPreviewLink({ text: "About", href: "#" }),
        NavPreviewLink({ text: "Users", href: "#" }),
        NavPreviewButton({ text: "Back" })
    ]
}

NavPreviewLink(props) -> {
    type: link
    href: props.href
    content: props.text
    style: "text-pink-500 hover:text-pink-600"
}

NavPreviewButton(props) -> {
    type: button
    content: props.text
    style: "px-3 py-1 bg-gray-200 rounded text-sm hover:bg-gray-300"
}

// Layouts
LayoutsSection -> DocsCodeSection({
    title: "Layouts",
    description: "Share layouts across pages with template.tp:",
    filename: "dashboard/template.tp",
    code: `
    // dashboard/template.tp
    // All pages in dashboard/ use this layout

    DashboardTemplate(props) -> {
        style: "flex min-h-screen"
        children: [
            Sidebar,
            Main({ children: props.children })
        ]
    }

    // dashboard/index.tp
    import { DashboardTemplate } from "./template.tp"

    Page -> DashboardTemplate({
        children: [DashboardContent]
    })`,
    preview: [LayoutsPreview]
})

LayoutsPreview -> {
    style: "flex h-32 border rounded-lg overflow-hidden"
    children: [
        LayoutSidebar,
        LayoutMain
    ]
}

LayoutSidebar -> {
    style: "w-16 bg-gray-800 flex items-center justify-center"
    children: [Text({ text: "Nav", style: "text-white text-xs" })]
}

LayoutMain -> {
    style: "flex-1 bg-gray-50 flex items-center justify-center"
    children: [Text({ text: "Page Content", style: "text-gray-400 text-sm" })]
}

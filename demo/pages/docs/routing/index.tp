// Routing docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsText, DocsDescription } from "@/components/molecules/docs-section.tp"
import { CodeBlock } from "@/components/molecules/code-block.tp"
import { CodePreview } from "@/components/molecules/code-preview.tp"
import { Text } from "@/components/atoms/text.tp"
import { SectionTitle } from "@/components/molecules/section-title.tp"

Page -> DocsTemplate({ children: [RoutingContent] })

RoutingContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        FileBasedSection,
        DynamicRoutesSection,
        NavigationSection,
        LayoutsSection
    ]
}

PageHeader -> DocsSection({
    id: "routing",
    title: "Routing",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "topo uses file-based routing. Create files in the pages directory and routes are automatically generated."
})

// File-based routing
FileBasedSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "File-Based Routing" }),
        DocsText({ text: "Your file structure becomes your routes:" }),
        FileBasedExample
    ]
}

FileBasedExample -> CodePreview({
    filename: "pages/",
    code: "pages/\n├── index.tp          → /\n├── about/\n│   └── index.tp      → /about\n├── blog/\n│   ├── index.tp      → /blog\n│   └── [slug]/\n│       └── index.tp  → /blog/:slug\n├── users/\n│   ├── index.tp      → /users\n│   └── [id]/\n│       ├── index.tp  → /users/:id\n│       └── edit.tp   → /users/:id/edit\n└── docs/\n    └── [...path]/\n        └── index.tp  → /docs/* (catch-all)",
    preview: [FileBasedPreview]
})

FileBasedPreview -> {
    align: vertical
    style: "space-y-2"
    children: [
        RouteItem({ path: "/", file: "index.tp" }),
        RouteItem({ path: "/about", file: "about/index.tp" }),
        RouteItem({ path: "/blog/:slug", file: "blog/[slug]/index.tp" }),
        RouteItem({ path: "/users/:id", file: "users/[id]/index.tp" })
    ]
}

RouteItem(props) -> {
    style: "flex items-center gap-3 text-sm"
    children: [
        Text({ text: props.path, style: "font-mono text-pink-600" }),
        Text({ text: "→", style: "text-gray-400" }),
        Text({ text: props.file, style: "text-gray-500" })
    ]
}

// Dynamic routes
DynamicRoutesSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Dynamic Routes" }),
        DocsText({ text: "Use brackets for dynamic segments:" }),
        DynamicRoutesExample
    ]
}

DynamicRoutesExample -> CodePreview({
    filename: "users/[id]/index.tp",
    code: "// Access route params via props\nPage(props) -> {\n    children: [UserProfile({ id: props.params.id })]\n}\n\n// Or use the router\nUserProfile -> {\n    init: UserStore.FetchUser(router.params.id)\n    children: [\n        UserHeader,\n        UserDetails\n    ]\n}",
    preview: [DynamicPreview]
})

DynamicPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "Route: /users/123", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "params.id = \"123\"", style: "font-mono text-sm text-pink-600" })
    ]
}

// Navigation
NavigationSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Navigation" }),
        DocsText({ text: "Navigate using links or programmatically:" }),
        NavigationExample
    ]
}

NavigationExample -> CodePreview({
    filename: "nav.tp",
    code: "// Declarative link\nNavLink -> {\n    type: link\n    href: \"/about\"\n    content: \"About Us\"\n}\n\n// With dynamic params\nUserLink(id) -> {\n    type: link\n    href: \"/users/\" + id\n    content: \"View Profile\"\n}\n\n// Programmatic navigation\nLoginButton -> {\n    type: button\n    content: \"Login\"\n    onClick: () => router.push(\"/login\")\n}\n\n// Go back\nBackButton -> {\n    type: button\n    content: \"Back\"\n    onClick: () => router.back()\n}",
    preview: [NavigationPreview]
})

NavigationPreview -> {
    style: "flex gap-3"
    children: [
        NavPreviewLink({ text: "About", href: "#" }),
        NavPreviewLink({ text: "Users", href: "#" }),
        NavPreviewButton({ text: "Back" })
    ]
}

NavPreviewLink(props) -> {
    type: link
    href: props.href
    content: props.text
    style: "text-pink-500 hover:text-pink-600"
}

NavPreviewButton(props) -> {
    type: button
    content: props.text
    style: "px-3 py-1 bg-gray-200 rounded text-sm hover:bg-gray-300"
}

// Layouts
LayoutsSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Layouts" }),
        DocsText({ text: "Share layouts across pages with template.tp:" }),
        LayoutsExample
    ]
}

LayoutsExample -> CodePreview({
    filename: "dashboard/template.tp",
    code: "// dashboard/template.tp\n// All pages in dashboard/ use this layout\n\nDashboardTemplate(props) -> {\n    style: \"flex min-h-screen\"\n    children: [\n        Sidebar,\n        Main({ children: props.children })\n    ]\n}\n\n// dashboard/index.tp\nimport { DashboardTemplate } from \"./template.tp\"\n\nPage -> DashboardTemplate({\n    children: [DashboardContent]\n})",
    preview: [LayoutsPreview]
})

LayoutsPreview -> {
    style: "flex h-32 border rounded-lg overflow-hidden"
    children: [
        LayoutSidebar,
        LayoutMain
    ]
}

LayoutSidebar -> {
    style: "w-16 bg-gray-800 flex items-center justify-center"
    children: [Text({ text: "📋", style: "text-xl" })]
}

LayoutMain -> {
    style: "flex-1 bg-gray-50 flex items-center justify-center"
    children: [Text({ text: "Page Content", style: "text-gray-400 text-sm" })]
}

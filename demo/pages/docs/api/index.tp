// API Services docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ApiPreview } from "@/components/molecules/api-preview.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { Text } from "@packages/components/atoms/text.tp"

Page -> DocsTemplate({ children: [APIContent] })

APIContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicAPISection,
        AutoGenNote,
        TypeDefinitionsSection,
        TypeSyntaxSection,
        CustomEndpointsSection,
        InterceptorsSection,
        InterceptorsList,
        UsageSection,
        TopoInfoSection
    ]
}

PageHeader -> DocsSection({
    id: "api",
    title: "API Services",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Define REST APIs with the :: operator. CRUD methods are auto-generated - zero boilerplate required."
})

// Basic API
BasicAPISection -> DocsCodeSection({
    title: "Auto-Generated CRUD",
    description: "Just define the base endpoint and get all CRUD methods for free:",
    filename: "api.tp",
    code: `
    // This is all you need!
    UserApi :: {
        rest: "/api/users"
    }`,
    preview: [ApiPreview({
        endpoints: [
            { method: "GET", path: "/api/users", desc: "getAll()" },
            { method: "GET", path: "/api/users/:id", desc: "getById(id)" },
            { method: "POST", path: "/api/users", desc: "create(data)" },
            { method: "PUT", path: "/api/users/:id", desc: "update(id, data)" },
            { method: "DELETE", path: "/api/users/:id", desc: "delete(id)" }
        ]
    })]
})

AutoGenNote -> {
    style: "p-4 bg-green-50 rounded-lg border border-green-200"
    children: [
        Text({ text: "All 5 methods generated from 3 lines of code!", style: "text-green-700 font-medium" })
    ]
}

// Custom Endpoints
CustomEndpointsSection -> DocsCodeSection({
    title: "Custom Endpoints",
    description: "Add custom endpoints alongside auto-generated ones:",
    filename: "api.tp",
    code: `
    UserApi :: {
        rest: "/api/users"

        // Custom endpoints
        search: get("/search?q={query}")
        activate: post("/{id}/activate")
        bulkDelete: delete("/bulk")
        export: get("/export", { responseType: "blob" })
    }`,
    preview: [CustomAPIPreview]
})

CustomAPIPreview -> {
    align: vertical
    style: "space-y-2"
    children: [
        Text({ text: "Auto-generated:", style: "text-gray-500 text-xs mb-1" }),
        ApiPreview({
            endpoints: [
                { method: "GET", path: "/api/users", desc: "getAll()" },
                { method: "POST", path: "/api/users", desc: "create(data)" }
            ]
        }),
        Text({ text: "Custom:", style: "text-gray-500 text-xs mt-2 mb-1" }),
        ApiPreview({
            endpoints: [
                { method: "GET", path: "/api/users/search", desc: "search(query)" },
                { method: "POST", path: "/api/users/:id/activate", desc: "activate(id)" },
                { method: "DELETE", path: "/api/users/bulk", desc: "bulkDelete(ids)" }
            ]
        })
    ]
}

// Interceptors
InterceptorsSection -> DocsCodeSection({
    title: "Interceptors & Configuration",
    description: "Configure common settings and intercept requests/responses:",
    filename: "api-config.tp",
    code: `
    Api :: {
        baseUrl: "/api"

        headers: {
            "Content-Type": "application/json"
        }

        interceptors: {
            request: (config) => {
                token: getAuthToken()
                config.headers.Authorization =
                    "Bearer " + token
                return config
            }

            response: (res) => res.data

            error: (err) => {
                if (err.status == 401) {
                    redirect("/login")
                }
                throw err
            }
        }
    }`,
    preview: [ConfigPreview({
        items: [
            { label: "baseUrl", desc: "Common prefix for all endpoints" },
            { label: "headers", desc: "Default headers" },
            { label: "request", desc: "Modify before sending" },
            { label: "response", desc: "Transform response data" },
            { label: "error", desc: "Global error handling" }
        ]
    })]
})

InterceptorsList -> DocsDescription({
    text: "Interceptors are perfect for auth tokens, logging, error handling, and response transformation."
})

// Usage
UsageSection -> DocsCodeSection({
    title: "Using in Components",
    description: "Call API methods directly in your components and effects:",
    filename: "user-list.tp",
    code: `
    // In Effects
    Effects {
        on FetchUsers {
            users: await UserApi.getAll()
            dispatch: SetUsers(users)
        }

        on SearchUsers(query) {
            results: await UserApi.search(query)
            dispatch: SetSearchResults(results)
        }
    }

    // In Components
    DeleteButton(id) -> {
        type: button
        content: "Delete"
        onClick: () => UserApi.delete(id)
    }`,
    preview: [FeatureList({
        title: "API calls are:",
        items: [
            { icon: "v", text: "Type-safe" },
            { icon: "v", text: "Auto-cached (configurable)" },
            { icon: "v", text: "Cancellable" },
            { icon: "v", text: "Progress tracking supported" }
        ]
    })]
})

// Type Definitions Section
TypeDefinitionsSection -> DocsCodeSection({
    title: "Type Definitions",
    description: "Add request/response types for better tooling and documentation:",
    filename: "auth-api.tp",
    code: `
    AuthApi :: {
        rest: "/api/auth"

        // Simple response type with arrow syntax
        login: post("/login") -> AuthToken

        // Full type definition with block syntax
        signUp: post("/sign-up") {
            request: SignUpRequest
            response: AuthToken
            error: AuthError
        }

        // Inline object types
        logout: post("/logout") -> { success: boolean }

        me: get("/me") -> User
    }`,
    preview: [TypeBenefitsList]
})

TypeBenefitsList -> FeatureList({
    title: "Type annotations provide:",
    items: [
        { icon: "v", text: "JSDoc comments in generated code" },
        { icon: "v", text: "IDE autocomplete support" },
        { icon: "v", text: "API documentation via topo info" },
        { icon: "v", text: "Error type tracking" }
    ]
})

// Type Syntax Section
TypeSyntaxSection -> DocsCodeSection({
    title: "Type Syntax",
    description: "Use various type annotation formats:",
    filename: "types.tp",
    code: `
    // Reference types
    getUser: get("/users/:id") -> User

    // Inline object types
    updateProfile: put("/profile") {
        request: { name: string, bio: string? }
        response: User
    }

    // Array types
    listUsers: get("/users") -> User[]

    // Union types (for error handling)
    authenticate: post("/auth") {
        response: AuthToken
        error: AuthError | NetworkError
    }`,
    preview: [TypeSyntaxPreview]
})

TypeSyntaxPreview -> {
    align: vertical
    style: "space-y-2"
    children: [
        Text({ text: "Supported type formats:", style: "text-gray-500 text-xs mb-2" }),
        ApiPreview({
            endpoints: [
                { method: "->", path: "Type", desc: "Reference type" },
                { method: "->", path: "Type[]", desc: "Array type" },
                { method: "->", path: "Type?", desc: "Optional type" },
                { method: "->", path: "A | B", desc: "Union type" },
                { method: "{}", path: "{ ... }", desc: "Object type" }
            ]
        })
    ]
}

// Topo Info Section
TopoInfoSection -> DocsCodeSection({
    title: "API Documentation",
    description: "View all API endpoints and their types with topo info:",
    filename: "terminal",
    code: `
    $ topo info list --apis

    API Services
    ──────────────────────────────────────────────────
      AuthApi (auth-api.tp)
        rest: /api/auth
        endpoints:
          POST   /login → login() -> AuthToken
          POST   /sign-up → signUp(SignUpRequest) -> AuthToken | AuthError
          POST   /logout → logout() -> { success: boolean }
          GET    /me → me() -> User`,
    preview: [TopoInfoNote]
})

TopoInfoNote -> {
    style: "p-4 bg-blue-50 rounded-lg border border-blue-200"
    children: [
        Text({ text: "Run topo info list --apis to see all your API services with their type signatures.", style: "text-blue-700 text-sm" })
    ]
}

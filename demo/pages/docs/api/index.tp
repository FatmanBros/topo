// API Services docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { Text } from "@/components/atoms/text.tp"

Page -> DocsTemplate({ children: [APIContent] })

APIContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicAPISection,
        AutoGenNote,
        CustomEndpointsSection,
        InterceptorsSection,
        InterceptorsList,
        UsageSection
    ]
}

PageHeader -> DocsSection({
    id: "api",
    title: "API Services",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Define REST APIs with the :: operator. CRUD methods are auto-generated - zero boilerplate required."
})

// Basic API
BasicAPISection -> DocsCodeSection({
    title: "Auto-Generated CRUD",
    description: "Just define the base endpoint and get all CRUD methods for free:",
    filename: "api.tp",
    code: `// This is all you need!
UserApi :: {
    rest: "/api/users"
}`,
    preview: [BasicAPIPreview]
})

BasicAPIPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        APILine({ method: "GET", path: "/api/users", desc: "getAll()" }),
        APILine({ method: "GET", path: "/api/users/:id", desc: "getById(id)" }),
        APILine({ method: "POST", path: "/api/users", desc: "create(data)" }),
        APILine({ method: "PUT", path: "/api/users/:id", desc: "update(id, data)" }),
        APILine({ method: "DELETE", path: "/api/users/:id", desc: "delete(id)" })
    ]
}

AutoGenNote -> {
    style: "p-4 bg-green-50 rounded-lg border border-green-200"
    children: [
        Text({ text: "All 5 methods generated from 3 lines of code!", style: "text-green-700 font-medium" })
    ]
}

// Custom Endpoints
CustomEndpointsSection -> DocsCodeSection({
    title: "Custom Endpoints",
    description: "Add custom endpoints alongside auto-generated ones:",
    filename: "api.tp",
    code: `UserApi :: {
    rest: "/api/users"

    // Custom endpoints
    search: get("/search?q={query}")
    activate: post("/{id}/activate")
    bulkDelete: delete("/bulk")
    export: get("/export", { responseType: "blob" })
}`,
    preview: [CustomAPIPreview]
})

CustomAPIPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        Text({ text: "Auto-generated:", style: "text-gray-500 text-xs mb-1" }),
        APILine({ method: "GET", path: "/api/users", desc: "getAll()" }),
        APILine({ method: "POST", path: "/api/users", desc: "create(data)" }),
        Text({ text: "Custom:", style: "text-gray-500 text-xs mt-2 mb-1" }),
        APILine({ method: "GET", path: "/api/users/search", desc: "search(query)" }),
        APILine({ method: "POST", path: "/api/users/:id/activate", desc: "activate(id)" }),
        APILine({ method: "DELETE", path: "/api/users/bulk", desc: "bulkDelete(ids)" })
    ]
}

// Interceptors
InterceptorsSection -> DocsCodeSection({
    title: "Interceptors & Configuration",
    description: "Configure common settings and intercept requests/responses:",
    filename: "api-config.tp",
    code: `Api :: {
    baseUrl: "/api"

    headers: {
        "Content-Type": "application/json"
    }

    interceptors: {
        request: (config) => {
            token: getAuthToken()
            config.headers.Authorization =
                "Bearer " + token
            return config
        }

        response: (res) => res.data

        error: (err) => {
            if (err.status == 401) {
                redirect("/login")
            }
            throw err
        }
    }
}`,
    preview: [InterceptorsPreview]
})

InterceptorsPreview -> {
    align: vertical
    style: "space-y-3"
    children: [
        ConfigItem({ label: "baseUrl", desc: "Common prefix for all endpoints" }),
        ConfigItem({ label: "headers", desc: "Default headers" }),
        ConfigItem({ label: "request", desc: "Modify before sending" }),
        ConfigItem({ label: "response", desc: "Transform response data" }),
        ConfigItem({ label: "error", desc: "Global error handling" })
    ]
}

ConfigItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.label, style: "font-mono text-xs px-2 py-0.5 bg-violet-100 text-violet-700 rounded" }),
        Text({ text: props.desc, style: "text-gray-600 text-sm" })
    ]
}

InterceptorsList -> DocsDescription({
    text: "Interceptors are perfect for auth tokens, logging, error handling, and response transformation."
})

// Usage
UsageSection -> DocsCodeSection({
    title: "Using in Components",
    description: "Call API methods directly in your components and effects:",
    filename: "user-list.tp",
    code: `// In Effects
Effects {
    on FetchUsers {
        users: await UserApi.getAll()
        dispatch: SetUsers(users)
    }

    on SearchUsers(query) {
        results: await UserApi.search(query)
        dispatch: SetSearchResults(results)
    }
}

// In Components
DeleteButton(id) -> {
    type: button
    content: "Delete"
    onClick: () => UserApi.delete(id)
}`,
    preview: [UsagePreview]
})

UsagePreview -> {
    align: vertical
    style: "space-y-2 text-sm"
    children: [
        Text({ text: "API calls are:", style: "font-medium text-gray-700" }),
        FeatureItem({ icon: "v", text: "Type-safe" }),
        FeatureItem({ icon: "v", text: "Auto-cached (configurable)" }),
        FeatureItem({ icon: "v", text: "Cancellable" }),
        FeatureItem({ icon: "v", text: "Progress tracking supported" })
    ]
}

// Shared preview components (could be moved to molecules later)
APILine(props) -> {
    style: "flex items-center gap-2"
    children: [
        APIMethod({ method: props.method }),
        Text({ text: props.path, style: "text-gray-600" }),
        Text({ text: props.desc, style: "text-gray-400 text-xs" })
    ]
}

APIMethod(props) -> Text({
    text: props.method,
    style: props.method == "GET" ? "px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold"
         : props.method == "POST" ? "px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-bold"
         : props.method == "PUT" ? "px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs font-bold"
         : "px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs font-bold"
})

FeatureItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.icon, style: "text-green-500" }),
        Text({ text: props.text, style: "text-gray-600" })
    ]
}

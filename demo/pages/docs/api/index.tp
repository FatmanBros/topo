// API Services docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsText, DocsDescription } from "../../../components/molecules/docs-section.tp"
import { CodeBlock } from "../../../components/molecules/code-block.tp"
import { CodePreview } from "../../../components/molecules/code-preview.tp"
import { Text } from "../../../components/atoms/text.tp"

Page -> DocsTemplate({ children: [APIContent] })

APIContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicAPISection,
        CustomEndpointsSection,
        InterceptorsSection,
        UsageSection
    ]
}

PageHeader -> DocsSection({
    id: "api",
    title: "API Services",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Define REST APIs with the :: operator. CRUD methods are auto-generated - zero boilerplate required."
})

// Basic API
BasicAPISection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Auto-Generated CRUD" }),
        DocsText({ text: "Just define the base endpoint and get all CRUD methods for free:" }),
        BasicAPIExample,
        AutoGenNote
    ]
}

SectionTitle(props) -> DocsText({
    text: props.text,
    style: "text-xl font-semibold text-gray-900"
})

BasicAPIExample -> CodePreview({
    filename: "api.tp",
    code: "// This is all you need!\nUserApi :: {\n    rest: \"/api/users\"\n}",
    preview: [BasicAPIPreview]
})

BasicAPIPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        APILine({ method: "GET", path: "/api/users", desc: "getAll()" }),
        APILine({ method: "GET", path: "/api/users/:id", desc: "getById(id)" }),
        APILine({ method: "POST", path: "/api/users", desc: "create(data)" }),
        APILine({ method: "PUT", path: "/api/users/:id", desc: "update(id, data)" }),
        APILine({ method: "DELETE", path: "/api/users/:id", desc: "delete(id)" })
    ]
}

AutoGenNote -> {
    style: "p-4 bg-green-50 rounded-lg border border-green-200"
    children: [
        Text({ text: "✨ All 5 methods generated from 3 lines of code!", style: "text-green-700 font-medium" })
    ]
}

// Custom Endpoints
CustomEndpointsSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Custom Endpoints" }),
        DocsText({ text: "Add custom endpoints alongside auto-generated ones:" }),
        CustomAPIExample
    ]
}

CustomAPIExample -> CodePreview({
    filename: "api.tp",
    code: "UserApi :: {\n    rest: \"/api/users\"\n    \n    // Custom endpoints\n    search: get(\"/search?q={query}\")\n    activate: post(\"/{id}/activate\")\n    bulkDelete: delete(\"/bulk\")\n    export: get(\"/export\", { responseType: \"blob\" })\n}",
    preview: [CustomAPIPreview]
})

CustomAPIPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        Text({ text: "Auto-generated:", style: "text-gray-500 text-xs mb-1" }),
        APILine({ method: "GET", path: "/api/users", desc: "getAll()" }),
        APILine({ method: "POST", path: "/api/users", desc: "create(data)" }),
        Text({ text: "Custom:", style: "text-gray-500 text-xs mt-2 mb-1" }),
        APILine({ method: "GET", path: "/api/users/search", desc: "search(query)" }),
        APILine({ method: "POST", path: "/api/users/:id/activate", desc: "activate(id)" }),
        APILine({ method: "DELETE", path: "/api/users/bulk", desc: "bulkDelete(ids)" })
    ]
}

// Interceptors
InterceptorsSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Interceptors & Configuration" }),
        DocsText({ text: "Configure common settings and intercept requests/responses:" }),
        InterceptorsExample,
        InterceptorsList
    ]
}

InterceptorsExample -> CodePreview({
    filename: "api-config.tp",
    code: "Api :: {\n    baseUrl: \"/api\"\n    \n    headers: {\n        \"Content-Type\": \"application/json\"\n    }\n    \n    interceptors: {\n        request: (config) => {\n            token: getAuthToken()\n            config.headers.Authorization =\n                \"Bearer \" + token\n            return config\n        }\n        \n        response: (res) => res.data\n        \n        error: (err) => {\n            if (err.status == 401) {\n                redirect(\"/login\")\n            }\n            throw err\n        }\n    }\n}",
    preview: [InterceptorsPreview]
})

InterceptorsPreview -> {
    align: vertical
    style: "space-y-3"
    children: [
        ConfigItem({ label: "baseUrl", desc: "Common prefix for all endpoints" }),
        ConfigItem({ label: "headers", desc: "Default headers" }),
        ConfigItem({ label: "request", desc: "Modify before sending" }),
        ConfigItem({ label: "response", desc: "Transform response data" }),
        ConfigItem({ label: "error", desc: "Global error handling" })
    ]
}

ConfigItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.label, style: "font-mono text-xs px-2 py-0.5 bg-violet-100 text-violet-700 rounded" }),
        Text({ text: props.desc, style: "text-gray-600 text-sm" })
    ]
}

InterceptorsList -> DocsDescription({
    text: "Interceptors are perfect for auth tokens, logging, error handling, and response transformation."
})

// Usage
UsageSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Using in Components" }),
        DocsText({ text: "Call API methods directly in your components and effects:" }),
        UsageExample
    ]
}

UsageExample -> CodePreview({
    filename: "user-list.tp",
    code: "// In Effects\nEffects {\n    on FetchUsers {\n        users: await UserApi.getAll()\n        dispatch: SetUsers(users)\n    }\n    \n    on SearchUsers(query) {\n        results: await UserApi.search(query)\n        dispatch: SetSearchResults(results)\n    }\n}\n\n// In Components\nDeleteButton(id) -> {\n    type: button\n    content: \"Delete\"\n    onClick: () => UserApi.delete(id)\n}",
    preview: [UsagePreview]
})

UsagePreview -> {
    align: vertical
    style: "space-y-2 text-sm"
    children: [
        Text({ text: "API calls are:", style: "font-medium text-gray-700" }),
        FeatureItem({ icon: "✓", text: "Type-safe" }),
        FeatureItem({ icon: "✓", text: "Auto-cached (configurable)" }),
        FeatureItem({ icon: "✓", text: "Cancellable" }),
        FeatureItem({ icon: "✓", text: "Progress tracking supported" })
    ]
}

// Shared components
APILine(props) -> {
    style: "flex items-center gap-2"
    children: [
        APIMethod({ method: props.method }),
        Text({ text: props.path, style: "text-gray-600" }),
        Text({ text: props.desc, style: "text-gray-400 text-xs" })
    ]
}

APIMethod(props) -> Text({
    text: props.method,
    style: props.method == "GET" ? "px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold"
         : props.method == "POST" ? "px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-bold"
         : props.method == "PUT" ? "px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs font-bold"
         : "px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs font-bold"
})

FeatureItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.icon, style: "text-green-500" }),
        Text({ text: props.text, style: "text-gray-600" })
    ]
}

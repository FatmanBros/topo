// Docs main content
import { DocsSection, DocsText, DocsDescription } from "../../../components/molecules/docs-section.tp"
import { CodeBlock } from "../../../components/molecules/code-block.tp"
import { CodePreview } from "../../../components/molecules/code-preview.tp"
import { Text } from "../../../components/atoms/text.tp"
import { PrimaryButton } from "../../../components/atoms/button.tp"

DocsContent -> {
    style: "flex-1 p-8 max-w-5xl"
    children: [
        IntroSection,
        InstallSection,
        QuickStartSection,
        ComponentsSection,
        StoreSection,
        APISection
    ]
}

// Introduction
IntroSection -> DocsSection({
    id: "introduction",
    title: "Introduction",
    children: [IntroDesc]
})

IntroDesc -> DocsDescription({
    text: "topo is a declarative UI framework that eliminates nesting hell. Write flat, readable code with built-in state management, API services, and file-based routing."
})

// Installation
InstallSection -> DocsSection({
    id: "installation",
    title: "Installation",
    children: [InstallContent]
})

InstallContent -> {
    align: vertical
    style: "space-y-4"
    children: [
        DocsText({ text: "Clone and build from source:" }),
        CodeBlock({ filename: "terminal", code: "git clone https://github.com/FatmanBros/topo.git\ncd topo\ncargo build --release" }),
        DocsText({ text: "Add to your PATH:" }),
        CodeBlock({ filename: "terminal", code: "export PATH=\"$PATH:$(pwd)/target/release\"" })
    ]
}

// Quick Start
QuickStartSection -> DocsSection({
    id: "quick-start",
    title: "Quick Start",
    children: [QuickStartContent]
})

QuickStartContent -> {
    align: vertical
    style: "space-y-4"
    children: [
        DocsText({ text: "Create a new project and start the dev server:" }),
        CodeBlock({ filename: "terminal", code: "topo new my-app\ncd my-app\ntopo dev" }),
        DocsText({ text: "Open http://localhost:7090 to see your app.", style: "text-sm text-gray-500" })
    ]
}

// Components
ComponentsSection -> DocsSection({
    id: "components",
    title: "Components",
    children: [ComponentsContent]
})

ComponentsContent -> {
    align: vertical
    style: "space-y-6"
    children: [
        DocsText({ text: "Components are defined with the -> operator. They return a configuration object with type, style, content, and children." }),
        ComponentsExample
    ]
}

ComponentsExample -> CodePreview({
    filename: "button.tp",
    code: "Button(label) -> {\n    type: button\n    content: label\n    style: \"px-4 py-2 bg-blue-500\n           text-white rounded\n           hover:bg-blue-600\"\n}",
    preview: [ButtonPreview]
})

ButtonPreview -> {
    style: "flex gap-3"
    children: [
        PreviewButton1,
        PreviewButton2,
        PreviewButton3
    ]
}

PreviewButton1 -> PrimaryButton("Click me", null)
PreviewButton2 -> {
    type: button
    content: "Secondary"
    style: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
}
PreviewButton3 -> {
    type: button
    content: "Danger"
    style: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600"
}

// Store
StoreSection -> DocsSection({
    id: "store",
    title: "Store (State Management)",
    children: [StoreContent]
})

StoreContent -> {
    align: vertical
    style: "space-y-6"
    children: [
        DocsText({ text: "Stores are defined with the | operator. They include State, Actions, Reducers, and Effects for complete state management." }),
        StoreExample,
        StoreFeatures
    ]
}

StoreFeatures -> {
    align: vertical
    style: "space-y-4 mt-6"
    children: [
        StoreFeaturesTitle,
        StoreFeature1,
        StoreFeature2
    ]
}

StoreFeaturesTitle -> DocsText({
    text: "Store Features:",
    style: "font-semibold text-gray-900"
})

StoreFeature1 -> DocsDescription({
    text: "Name abbreviation: In the same file, you can access store state directly without the store name prefix. For example, 'count' instead of 'Counter.count'."
})

StoreFeature2 -> DocsDescription({
    text: "Cross-component access: Parent components can access and dispatch actions to child component stores. This enables coordinated state management across your component tree."
})

StoreExample -> CodePreview({
    filename: "counter.tp",
    code: "Counter | {\n    State { count: 0 }\n    Actions {\n        Increment\n        Decrement\n    }\n    Reducers {\n        on Increment {\n            count: count + 1\n        }\n        on Decrement {\n            count: count - 1\n        }\n    }\n}",
    preview: [CounterPreview]
})

CounterPreview -> {
    style: "flex items-center gap-4"
    children: [
        CounterMinusBtn,
        CounterDisplay,
        CounterPlusBtn
    ]
}

CounterMinusBtn -> {
    type: button
    content: "-"
    style: "w-10 h-10 bg-pink-500 text-white rounded-full hover:bg-pink-600 font-bold text-xl"
}

CounterDisplay -> Text({
    text: "0",
    style: "text-4xl font-bold text-gray-900 w-16 text-center"
})

CounterPlusBtn -> {
    type: button
    content: "+"
    style: "w-10 h-10 bg-pink-500 text-white rounded-full hover:bg-pink-600 font-bold text-xl"
}

// API Services
APISection -> DocsSection({
    id: "api-services",
    title: "API Services",
    children: [APIContent]
})

APIContent -> {
    align: vertical
    style: "space-y-6"
    children: [
        DocsText({ text: "API services are defined with the :: operator. Just define 'rest' and all CRUD methods are auto-generated." }),
        APIExample,
        AutoGenNote,
        CustomEndpointsSection,
        APIConfigSection
    ]
}

CustomEndpointsSection -> {
    align: vertical
    style: "space-y-4 mt-4"
    children: [
        CustomEndpointsTitle,
        APICustomExample
    ]
}

CustomEndpointsTitle -> DocsText({
    text: "Custom Endpoints:",
    style: "font-semibold text-gray-900"
})

AutoGenNote -> DocsDescription({
    text: "Methods like getAll(), getById(id), create(data), update(id, data), delete(id) are automatically generated from endpoint definitions. No boilerplate needed!"
})

APIConfigSection -> {
    align: vertical
    style: "space-y-4 mt-6"
    children: [
        APIConfigTitle,
        APIConfigExample
    ]
}

APIConfigTitle -> DocsText({
    text: "Common Configuration & Interceptors:",
    style: "font-semibold text-gray-900"
})

APIConfigExample -> CodePreview({
    filename: "api-config.tp",
    code: "Api :: {\n    baseUrl: \"/api\"\n    headers: {\n        \"Content-Type\": \"application/json\"\n    }\n    interceptors: {\n        request: (config) => {\n            config.headers.Authorization =\n                \"Bearer \" + getToken()\n            return config\n        }\n        response: (res) => res.data\n        error: (err) => {\n            if (err.status == 401) {\n                redirect(\"/login\")\n            }\n            throw err\n        }\n    }\n}",
    preview: [APIConfigPreview]
})

APIConfigPreview -> {
    align: vertical
    style: "space-y-3 text-sm"
    children: [
        APIConfigItem({ label: "baseUrl", desc: "Common base URL for all endpoints" }),
        APIConfigItem({ label: "headers", desc: "Default headers for all requests" }),
        APIConfigItem({ label: "interceptors.request", desc: "Pre-request processing (e.g., attach auth token)" }),
        APIConfigItem({ label: "interceptors.response", desc: "Response transformation" }),
        APIConfigItem({ label: "interceptors.error", desc: "Error handling (e.g., 401 redirect)" })
    ]
}

APIConfigItem(props) -> {
    style: "flex items-start gap-2"
    children: [
        APIConfigLabel({ text: props.label }),
        APIConfigDesc({ text: props.desc })
    ]
}

APIConfigLabel(props) -> Text({
    text: props.label,
    style: "font-mono text-xs px-2 py-0.5 bg-violet-100 text-violet-700 rounded shrink-0"
})

APIConfigDesc(props) -> Text({
    text: props.desc,
    style: "text-gray-600 text-sm"
})

APIExample -> CodePreview({
    filename: "api.tp",
    code: "// This is all you need!\nUserApi :: {\n    rest: \"/api/users\"\n}",
    preview: [APIPreview]
})

APICustomExample -> CodePreview({
    filename: "custom-api.tp",
    code: "// Add custom endpoints alongside\n// auto-generated CRUD methods\nUserApi :: {\n    rest: \"/api/users\"\n    search: get(\"/search\")\n    bulkDelete: post(\"/bulk-delete\")\n}",
    preview: [APICustomPreview]
})

APICustomPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        APIPreviewLine({ method: "GET", path: "/api/users", desc: "getAll() - auto" }),
        APIPreviewLine({ method: "GET", path: "/api/users/:id", desc: "getById(id) - auto" }),
        APIPreviewLine({ method: "POST", path: "/api/users", desc: "create(data) - auto" }),
        APIPreviewLine({ method: "PUT", path: "/api/users/:id", desc: "update(id, data) - auto" }),
        APIPreviewLine({ method: "DELETE", path: "/api/users/:id", desc: "delete(id) - auto" }),
        APIPreviewLine({ method: "GET", path: "/api/users/search", desc: "search() - custom" }),
        APIPreviewLine({ method: "POST", path: "/api/users/bulk-delete", desc: "bulkDelete() - custom" })
    ]
}

APIPreview -> {
    align: vertical
    style: "space-y-2 font-mono text-sm"
    children: [
        APIPreviewLine({ method: "GET", path: "/api/users", desc: "getAll()" }),
        APIPreviewLine({ method: "GET", path: "/api/users/:id", desc: "getById(id)" }),
        APIPreviewLine({ method: "POST", path: "/api/users", desc: "create(data)" }),
        APIPreviewLine({ method: "PUT", path: "/api/users/:id", desc: "update(id, data)" }),
        APIPreviewLine({ method: "DELETE", path: "/api/users/:id", desc: "delete(id)" })
    ]
}

APIPreviewLine(props) -> {
    style: "flex items-center gap-2"
    children: [
        APIMethod({ method: props.method }),
        APIPath({ path: props.path }),
        APIDesc({ desc: props.desc })
    ]
}

APIMethod(props) -> Text({
    text: props.method,
    style: props.method == "GET" ? "px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold"
         : props.method == "POST" ? "px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-bold"
         : props.method == "PUT" ? "px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs font-bold"
         : "px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs font-bold"
})

APIPath(props) -> Text({
    text: props.path,
    style: "text-gray-600"
})

APIDesc(props) -> Text({
    text: props.desc,
    style: "text-gray-400 text-xs"
})

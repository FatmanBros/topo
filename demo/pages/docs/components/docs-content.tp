// Docs main content
import { DocsSection, DocsText, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { CodeBlock } from "@/components/molecules/code-block.tp"
import { Text } from "@/components/atoms/text.tp"
import { PrimaryButton } from "@/components/atoms/button.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { ApiPreview } from "@/components/molecules/api-preview.tp"

DocsContent -> {
    style: "flex-1 p-8 max-w-5xl"
    children: [
        IntroSection,
        InstallSection,
        QuickStartSection,
        ComponentsSection,
        StoreSection,
        APISection
    ]
}

// Introduction
IntroSection -> DocsSection({
    id: "introduction",
    title: "Introduction",
    children: [IntroDesc]
})

IntroDesc -> DocsDescription({
    text: "topo is a declarative UI framework that eliminates nesting hell. Write flat, readable code with built-in state management, API services, and file-based routing."
})

// Installation
InstallSection -> DocsSection({
    id: "installation",
    title: "Installation",
    children: [InstallContent]
})

InstallContent -> {
    align: vertical
    style: "space-y-4"
    children: [
        DocsText({ text: "Clone and build from source:" }),
        CodeBlock({ filename: "terminal", code: `
    git clone https://github.com/FatmanBros/topo.git
    cd topo
    cargo build --release` }),
        DocsText({ text: "Add to your PATH:" }),
        CodeBlock({ filename: "terminal", code: `export PATH="$PATH:$(pwd)/target/release"` })
    ]
}

// Quick Start
QuickStartSection -> DocsSection({
    id: "quick-start",
    title: "Quick Start",
    children: [QuickStartContent]
})

QuickStartContent -> {
    align: vertical
    style: "space-y-4"
    children: [
        DocsText({ text: "Create a new project and start the dev server:" }),
        CodeBlock({ filename: "terminal", code: `
    topo new my-app
    cd my-app
    topo dev` }),
        DocsText({ text: "Open http://localhost:7090 to see your app.", style: "text-sm text-gray-500" })
    ]
}

// Components
ComponentsSection -> DocsCodeSection({
    title: "Components",
    description: "Components are defined with the -> operator. They return a configuration object with type, style, content, and children.",
    filename: "button.tp",
    code: `
    Button(label) -> {
        type: button
        content: label
        style: "px-4 py-2 bg-blue-500
               text-white rounded
               hover:bg-blue-600"
    }`,
    preview: [{
        style: "flex gap-3"
        children: [
            PrimaryButton("Click me", null),
            { type: button, content: "Secondary", style: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" },
            { type: button, content: "Danger", style: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600" }
        ]
    }]
})

// Store
StoreSection -> {
    align: vertical
    style: "space-y-6"
    children: [
        StoreSectionHeader,
        StoreBasicExample,
        StoreEffectsExample,
        StoreTestingExample
    ]
}

StoreSectionHeader -> DocsSection({
    id: "store",
    title: "Store (State Management)",
    children: [DocsDescription({ text: "Stores are defined with the | operator. They include State, Actions, Reducers, and Effects for complete state management." })]
})

StoreBasicExample -> DocsCodeSection({
    title: "Basic Store",
    description: "Define state and actions:",
    filename: "counter.tp",
    code: `
    Counter | {
        State { count: 0 }
        Actions {
            Increment
            Decrement
        }
        Reducers {
            on Increment {
                count: count + 1
            }
            on Decrement {
                count: count - 1
            }
        }
    }`,
    preview: [{
        style: "flex items-center gap-4"
        children: [
            { type: button, content: "-", style: "w-10 h-10 bg-pink-500 text-white rounded-full hover:bg-pink-600 font-bold text-xl" },
            Text({ text: "0", style: "text-4xl font-bold text-gray-900 w-16 text-center" }),
            { type: button, content: "+", style: "w-10 h-10 bg-pink-500 text-white rounded-full hover:bg-pink-600 font-bold text-xl" }
        ]
    }]
})

StoreEffectsExample -> DocsCodeSection({
    title: "Effects (Async Operations)",
    description: "Handle API calls and side effects:",
    filename: "user-store.tp",
    code: `
    UserStore | {
        State {
            users: []
            isLoading: false
        }
        Actions {
            FetchUsers
            SetUsers(users)
        }
        Effects {
            on FetchUsers {
                try {
                    users: await UserApi.getAll()
                    dispatch: SetUsers(users)
                } catch(e) {
                    dispatch: SetError(e.message)
                }
            }
        }
    }`,
    preview: [FeatureList({
        title: "Effects support:",
        items: [
            { icon: "v", text: "Async/await syntax" },
            { icon: "v", text: "Automatic loading states" },
            { icon: "v", text: "Built-in error handling" }
        ]
    })]
})

StoreTestingExample -> DocsCodeSection({
    title: "Easy Testing",
    description: "Test stores in isolation:",
    filename: "counter.test.tp",
    code: `
    test "Counter increments" {
        store: Counter.init()
        store.dispatch(Increment)
        expect(store.state.count).toBe(1)
    }`,
    preview: [FeatureList({
        title: "Testing features:",
        items: [
            { icon: "v", text: "Simple test syntax" },
            { icon: "v", text: "Isolated store instances" },
            { icon: "v", text: "Built-in assertions" }
        ]
    })]
})

// API Services
APISection -> {
    align: vertical
    style: "space-y-6"
    children: [
        APISectionHeader,
        APIBasicExample,
        APIConfigExample
    ]
}

APISectionHeader -> DocsSection({
    id: "api-services",
    title: "API Services",
    children: [DocsDescription({ text: "API services are defined with the :: operator. Just define 'rest' and all CRUD methods are auto-generated." })]
})

APIBasicExample -> DocsCodeSection({
    title: "Auto-Generated CRUD",
    description: "Define once, get all methods:",
    filename: "api.tp",
    code: `
    // This is all you need!
    UserApi :: {
        rest: "/api/users"
    }`,
    preview: [ApiPreview({
        endpoints: [
            { method: "GET", path: "/api/users", desc: "getAll()" },
            { method: "GET", path: "/api/users/:id", desc: "getById(id)" },
            { method: "POST", path: "/api/users", desc: "create(data)" },
            { method: "PUT", path: "/api/users/:id", desc: "update(id, data)" },
            { method: "DELETE", path: "/api/users/:id", desc: "delete(id)" }
        ]
    })]
})

APIConfigExample -> DocsCodeSection({
    title: "Interceptors",
    description: "Configure auth and error handling:",
    filename: "api-config.tp",
    code: `
    Api :: {
        baseUrl: "/api"
        interceptors: {
            request: (config) => {
                config.headers.Authorization =
                    "Bearer " + getToken()
                return config
            }
            error: (err) => {
                if (err.status == 401) {
                    redirect("/login")
                }
                throw err
            }
        }
    }`,
    preview: [ConfigPreview({
        items: [
            { label: "baseUrl", desc: "Common base URL" },
            { label: "request", desc: "Add auth headers" },
            { label: "error", desc: "Handle 401 redirect" }
        ]
    })]
})

// Styling docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { Text } from "@packages/components/atoms/text.tp"

Page -> DocsTemplate({ children: [StylingContent] })

StylingContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        TailwindSection,
        DynamicStylesSection,
        ThemingSection,
        ResponsiveSection
    ]
}

PageHeader -> DocsSection({
    id: "styling",
    title: "Styling",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "topo uses Tailwind CSS for styling. Write utility classes directly in your style property."
})

// Tailwind
TailwindSection -> DocsCodeSection({
    title: "Tailwind CSS",
    description: "Apply Tailwind classes in the style property:",
    filename: "button.tp",
    code: `
    PrimaryButton -> {
        type: button
        content: "Click me"
        style: "px-4 py-2
               bg-pink-500 text-white
               rounded-lg shadow-md
               hover:bg-pink-600
               active:scale-95
               transition-all"
    }`,
    preview: [TailwindPreview]
})

TailwindPreview -> {
    style: "flex gap-3"
    children: [
        StyleButton({ text: "Primary", style: "px-4 py-2 bg-pink-500 text-white rounded-lg shadow-md hover:bg-pink-600 transition-all" }),
        StyleButton({ text: "Secondary", style: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-all" }),
        StyleButton({ text: "Outline", style: "px-4 py-2 border-2 border-pink-500 text-pink-500 rounded-lg hover:bg-pink-50 transition-all" })
    ]
}

StyleButton(props) -> {
    type: button
    content: props.text
    style: props.style
}

// Dynamic styles
DynamicStylesSection -> DocsCodeSection({
    title: "Dynamic Styles",
    description: "Conditional styling with ternary operator:",
    filename: "status.tp",
    code: `
    StatusBadge(props) -> {
        type: text
        content: props.status
        style: props.status == "active"
            ? "px-2 py-1 bg-green-100
               text-green-700 rounded-full"
            : props.status == "pending"
            ? "px-2 py-1 bg-yellow-100
               text-yellow-700 rounded-full"
            : "px-2 py-1 bg-red-100
               text-red-700 rounded-full"
    }`,
    preview: [DynamicPreview]
})

DynamicPreview -> {
    style: "flex gap-3"
    children: [
        Badge({ text: "Active", style: "px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm" }),
        Badge({ text: "Pending", style: "px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm" }),
        Badge({ text: "Inactive", style: "px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm" })
    ]
}

Badge(props) -> {
    type: text
    content: props.text
    style: props.style
}

// Theming
ThemingSection -> DocsCodeSection({
    title: "Theming",
    description: "Create theme variables for consistent styling:",
    filename: "theme.tp",
    code: `
    // Define theme
    Theme | {
        State {
            mode: "light"
            colors: {
                primary: "pink-500"
                secondary: "violet-500"
                background: "white"
                text: "gray-900"
            }
        }

        Actions { Toggle }

        Reducers {
            on Toggle {
                mode: mode == "light"
                    ? "dark" : "light"
                colors: mode == "light"
                    ? { primary: "pink-400",
                        background: "gray-900",
                        text: "white" }
                    : { primary: "pink-500",
                        background: "white",
                        text: "gray-900" }
            }
        }
    }

    // Use theme
    Card -> {
        style: "bg-" + Theme.colors.background
             + " text-" + Theme.colors.text
    }`,
    preview: [ThemePreview]
})

ThemePreview -> {
    style: "flex gap-4"
    children: [
        ThemeCard({ mode: "Light", bg: "bg-white", text: "text-gray-900", border: "border-gray-200" }),
        ThemeCard({ mode: "Dark", bg: "bg-gray-900", text: "text-white", border: "border-gray-700" })
    ]
}

ThemeCard(props) -> {
    style: "p-4 rounded-lg border " + props.bg + " " + props.text + " " + props.border
    children: [
        Text({ text: props.mode + " Mode", style: "font-medium" }),
        Text({ text: "Theme preview", style: "text-sm opacity-70 mt-1" })
    ]
}

// Responsive
ResponsiveSection -> DocsCodeSection({
    title: "Responsive Design",
    description: "Use Tailwind's responsive prefixes:",
    filename: "grid.tp",
    code: `
    Grid -> {
        style: "grid
               grid-cols-1
               md:grid-cols-2
               lg:grid-cols-3
               xl:grid-cols-4
               gap-4"
        children: items.for(item => Card(item))
    }

    Sidebar -> {
        style: "hidden md:block
               w-64 h-screen
               fixed left-0 top-0"
    }`,
    preview: [ResponsivePreview]
})

ResponsivePreview -> {
    align: vertical
    style: "space-y-4"
    children: [
        GridPreview,
        ConfigPreview({
            items: [
                { label: "sm:", desc: "640px and up" },
                { label: "md:", desc: "768px and up" },
                { label: "lg:", desc: "1024px and up" },
                { label: "xl:", desc: "1280px and up" }
            ]
        })
    ]
}

GridPreview -> {
    style: "grid grid-cols-2 lg:grid-cols-4 gap-2"
    children: [
        GridItem({ n: "1" }),
        GridItem({ n: "2" }),
        GridItem({ n: "3" }),
        GridItem({ n: "4" })
    ]
}

GridItem(props) -> {
    style: "h-12 bg-pink-100 rounded flex items-center justify-center"
    children: [Text({ text: props.n, style: "text-pink-600 font-medium" })]
}

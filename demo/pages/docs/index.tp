// Docs landing page (Introduction)
import { DocsTemplate } from "./template.tp"
import { DocsSection, DocsText, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { Text } from "@/components/atoms/text.tp"
import { SectionTitle } from "@/components/molecules/section-title.tp"

Page -> DocsTemplate({ children: [IntroContent] })

IntroContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        WhyTopoSection,
        FeaturesSection,
        ComparisonSection,
        GetStartedSection
    ]
}

PageHeader -> DocsSection({
    id: "introduction",
    title: "Introduction",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "topo is a declarative UI framework that eliminates nesting hell. Write flat, readable code with built-in state management, API services, and file-based routing."
})

// Why topo
WhyTopoSection -> DocsCodeSection({
    title: "Why topo?",
    description: "Modern UI frameworks often lead to deeply nested, hard-to-read code. topo solves this with a flat, declarative syntax.",
    filename: "comparison",
    code: `
    // Traditional nested JSX
    <div className="card">
      <div className="header">
        <h1>{title}</h1>
        <span>{subtitle}</span>
      </div>
      <div className="body">
        {children}
      </div>
    </div>

    // topo - flat and readable
    Card -> {
        style: "card"
        children: [Header, Body]
    }

    Header -> {
        children: [Title, Subtitle]
    }

    Body -> {
        children: content
    }`,
    preview: [{
        align: vertical
        style: "space-y-3"
        children: [
            { style: "flex items-center gap-2", children: [Text({ text: "v", style: "text-green-500" }), Text({ text: "Flat structure - no nesting hell", style: "text-gray-600" })] },
            { style: "flex items-center gap-2", children: [Text({ text: "v", style: "text-green-500" }), Text({ text: "Each component is self-contained", style: "text-gray-600" })] },
            { style: "flex items-center gap-2", children: [Text({ text: "v", style: "text-green-500" }), Text({ text: "Easy to refactor and maintain", style: "text-gray-600" })] }
        ]
    }]
})

// Features
FeaturesSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Key Features" }),
        FeaturesGrid
    ]
}

FeaturesGrid -> {
    style: "grid grid-cols-1 md:grid-cols-2 gap-4"
    children: [
        FeatureCard({ icon: "v", title: "Components", desc: "Build UIs with simple, composable components using the -> operator" }),
        FeatureCard({ icon: "v", title: "Store", desc: "Built-in state management with Actions, Reducers, and Effects" }),
        FeatureCard({ icon: "v", title: "API Services", desc: "Auto-generated CRUD methods from REST endpoint definitions" }),
        FeatureCard({ icon: "v", title: "File-based Routing", desc: "Automatic route generation from your file structure" }),
        FeatureCard({ icon: "v", title: "Tailwind CSS", desc: "First-class Tailwind support for styling" }),
        FeatureCard({ icon: "v", title: "Easy Testing", desc: "Test stores and components in isolation" }),
        FeatureCard({ icon: "v", title: "Forms", desc: "Declarative form handling with validation annotations" }),
        FeatureCard({ icon: "v", title: "i18n", desc: "Built-in internationalization support" })
    ]
}

FeatureCard(props) -> {
    style: "p-4 bg-gray-50 rounded-xl border border-gray-100"
    children: [
        {
            style: "flex items-center gap-2 mb-2"
            children: [
                Text({ text: props.icon, style: "text-green-500" }),
                Text({ text: props.title, style: "font-semibold text-gray-900" })
            ]
        },
        Text({ text: props.desc, style: "text-sm text-gray-600" })
    ]
}

// Comparison
ComparisonSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "topo vs Others" }),
        ComparisonTable
    ]
}

ComparisonTable -> {
    style: "overflow-x-auto"
    children: [{
        style: "grid grid-cols-4 gap-2 text-sm min-w-[500px]"
        children: [
            Text({ text: "Feature", style: "font-semibold text-gray-700 p-2 bg-gray-100 rounded" }),
            Text({ text: "topo", style: "font-semibold text-gray-700 p-2 bg-gray-100 rounded" }),
            Text({ text: "React", style: "font-semibold text-gray-700 p-2 bg-gray-100 rounded" }),
            Text({ text: "Vue", style: "font-semibold text-gray-700 p-2 bg-gray-100 rounded" }),
            Text({ text: "Nesting", style: "p-2 text-gray-600" }),
            Text({ text: "Flat", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "Deep", style: "p-2 text-gray-400" }),
            Text({ text: "Deep", style: "p-2 text-gray-400" }),
            Text({ text: "State", style: "p-2 text-gray-600" }),
            Text({ text: "Built-in", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "External", style: "p-2 text-yellow-600" }),
            Text({ text: "Built-in", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "API Layer", style: "p-2 text-gray-600" }),
            Text({ text: "Built-in", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "Manual", style: "p-2 text-gray-400" }),
            Text({ text: "Manual", style: "p-2 text-gray-400" }),
            Text({ text: "Routing", style: "p-2 text-gray-600" }),
            Text({ text: "File-based", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "External", style: "p-2 text-yellow-600" }),
            Text({ text: "External", style: "p-2 text-yellow-600" }),
            Text({ text: "Forms", style: "p-2 text-gray-600" }),
            Text({ text: "Built-in", style: "p-2 text-green-600 font-medium" }),
            Text({ text: "Manual", style: "p-2 text-gray-400" }),
            Text({ text: "Manual", style: "p-2 text-gray-400" })
        ]
    }]
}

// Get started
GetStartedSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Get Started" }),
        DocsText({ text: "Ready to try topo? Follow these links to get started:" }),
        {
            align: vertical
            style: "space-y-2"
            children: [
                GetStartedLink({ text: "Installation", href: "/docs/installation", desc: "Set up topo on your machine" }),
                GetStartedLink({ text: "Quick Start", href: "/docs/quick-start", desc: "Create your first project" }),
                GetStartedLink({ text: "Components", href: "/docs/components-guide", desc: "Learn the component syntax" })
            ]
        }
    ]
}

GetStartedLink(props) -> {
    type: link
    href: props.href
    content: ""
    style: "block p-4 bg-pink-50 rounded-lg border border-pink-100 hover:bg-pink-100 transition-colors"
    children: [{
        style: "flex justify-between items-center"
        children: [
            {
                align: vertical
                children: [
                    Text({ text: props.text, style: "font-semibold text-pink-600" }),
                    Text({ text: props.desc, style: "text-sm text-pink-400" })
                ]
            },
            Text({ text: "->", style: "text-pink-500 text-xl" })
        ]
    }]
}

// Docs landing page (Introduction)
import { DocsTemplate } from "./template.tp"
import { DocsSection, DocsText, DocsDescription } from "../../components/molecules/docs-section.tp"
import { CodePreview } from "../../components/molecules/code-preview.tp"
import { Text } from "../../components/atoms/text.tp"

Page -> DocsTemplate({ children: [IntroContent] })

IntroContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        WhyTopoSection,
        FeaturesSection,
        ComparisonSection,
        GetStartedSection
    ]
}

PageHeader -> DocsSection({
    id: "introduction",
    title: "Introduction",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "topo is a declarative UI framework that eliminates nesting hell. Write flat, readable code with built-in state management, API services, and file-based routing."
})

// Why topo
WhyTopoSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Why topo?" }),
        DocsText({ text: "Modern UI frameworks often lead to deeply nested, hard-to-read code. topo solves this with a flat, declarative syntax that keeps your code clean and maintainable." }),
        CompareExample
    ]
}

SectionTitle(props) -> DocsText({
    text: props.text,
    style: "text-xl font-semibold text-gray-900"
})

CompareExample -> CodePreview({
    filename: "comparison",
    code: "// Traditional nested JSX\n<div className=\"card\">\n  <div className=\"header\">\n    <h1>{title}</h1>\n    <span>{subtitle}</span>\n  </div>\n  <div className=\"body\">\n    {children}\n  </div>\n</div>\n\n// topo - flat and readable\nCard -> {\n    style: \"card\"\n    children: [Header, Body]\n}\n\nHeader -> {\n    children: [Title, Subtitle]\n}\n\nBody -> {\n    children: content\n}",
    preview: [ComparePreview]
})

ComparePreview -> {
    align: vertical
    style: "space-y-3"
    children: [
        FeatureItem({ icon: "📖", text: "Flat structure - no nesting hell" }),
        FeatureItem({ icon: "🎯", text: "Each component is self-contained" }),
        FeatureItem({ icon: "🔧", text: "Easy to refactor and maintain" })
    ]
}

// Features
FeaturesSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Key Features" }),
        FeaturesGrid
    ]
}

FeaturesGrid -> {
    style: "grid grid-cols-1 md:grid-cols-2 gap-4"
    children: [
        FeatureCard({ icon: "🧩", title: "Components", desc: "Build UIs with simple, composable components using the -> operator" }),
        FeatureCard({ icon: "📦", title: "Store", desc: "Built-in state management with Actions, Reducers, and Effects" }),
        FeatureCard({ icon: "🌐", title: "API Services", desc: "Auto-generated CRUD methods from REST endpoint definitions" }),
        FeatureCard({ icon: "🛤️", title: "File-based Routing", desc: "Automatic route generation from your file structure" }),
        FeatureCard({ icon: "🎨", title: "Tailwind CSS", desc: "First-class Tailwind support for styling" }),
        FeatureCard({ icon: "🧪", title: "Easy Testing", desc: "Test stores and components in isolation" }),
        FeatureCard({ icon: "📝", title: "Forms", desc: "Declarative form handling with validation annotations" }),
        FeatureCard({ icon: "🌍", title: "i18n", desc: "Built-in internationalization support" })
    ]
}

FeatureCard(props) -> {
    style: "p-4 bg-gray-50 rounded-xl border border-gray-100"
    children: [
        FeatureCardHeader({ icon: props.icon, title: props.title }),
        FeatureCardDesc({ text: props.desc })
    ]
}

FeatureCardHeader(props) -> {
    style: "flex items-center gap-2 mb-2"
    children: [
        Text({ text: props.icon, style: "text-xl" }),
        Text({ text: props.title, style: "font-semibold text-gray-900" })
    ]
}

FeatureCardDesc(props) -> Text({
    text: props.text,
    style: "text-sm text-gray-600"
})

// Comparison
ComparisonSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "topo vs Others" }),
        ComparisonTable
    ]
}

ComparisonTable -> {
    style: "overflow-x-auto"
    children: [ComparisonTableContent]
}

ComparisonTableContent -> {
    style: "grid grid-cols-4 gap-2 text-sm min-w-[500px]"
    children: [
        TableHeader({ text: "Feature" }),
        TableHeader({ text: "topo" }),
        TableHeader({ text: "React" }),
        TableHeader({ text: "Vue" }),
        TableCell({ text: "Nesting" }),
        TableCellGood({ text: "Flat" }),
        TableCellBad({ text: "Deep" }),
        TableCellBad({ text: "Deep" }),
        TableCell({ text: "State" }),
        TableCellGood({ text: "Built-in" }),
        TableCellNeutral({ text: "External" }),
        TableCellGood({ text: "Built-in" }),
        TableCell({ text: "API Layer" }),
        TableCellGood({ text: "Built-in" }),
        TableCellBad({ text: "Manual" }),
        TableCellBad({ text: "Manual" }),
        TableCell({ text: "Routing" }),
        TableCellGood({ text: "File-based" }),
        TableCellNeutral({ text: "External" }),
        TableCellNeutral({ text: "External" }),
        TableCell({ text: "Forms" }),
        TableCellGood({ text: "Built-in" }),
        TableCellBad({ text: "Manual" }),
        TableCellBad({ text: "Manual" })
    ]
}

TableHeader(props) -> Text({
    text: props.text,
    style: "font-semibold text-gray-700 p-2 bg-gray-100 rounded"
})

TableCell(props) -> Text({
    text: props.text,
    style: "p-2 text-gray-600"
})

TableCellGood(props) -> Text({
    text: props.text,
    style: "p-2 text-green-600 font-medium"
})

TableCellBad(props) -> Text({
    text: props.text,
    style: "p-2 text-gray-400"
})

TableCellNeutral(props) -> Text({
    text: props.text,
    style: "p-2 text-yellow-600"
})

// Get started
GetStartedSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Get Started" }),
        DocsText({ text: "Ready to try topo? Follow these links to get started:" }),
        GetStartedLinks
    ]
}

GetStartedLinks -> {
    align: vertical
    style: "space-y-2"
    children: [
        GetStartedLink({ text: "Installation", href: "/docs/installation", desc: "Set up topo on your machine" }),
        GetStartedLink({ text: "Quick Start", href: "/docs/quick-start", desc: "Create your first project" }),
        GetStartedLink({ text: "Components", href: "/docs/components-guide", desc: "Learn the component syntax" })
    ]
}

GetStartedLink(props) -> {
    type: link
    href: props.href
    content: ""
    style: "block p-4 bg-pink-50 rounded-lg border border-pink-100 hover:bg-pink-100 transition-colors"
    children: [GetStartedLinkContent({ text: props.text, desc: props.desc })]
}

GetStartedLinkContent(props) -> {
    style: "flex justify-between items-center"
    children: [
        GetStartedLinkText({ text: props.text, desc: props.desc }),
        Text({ text: "→", style: "text-pink-500 text-xl" })
    ]
}

GetStartedLinkText(props) -> {
    align: vertical
    children: [
        Text({ text: props.text, style: "font-semibold text-pink-600" }),
        Text({ text: props.desc, style: "text-sm text-pink-400" })
    ]
}

FeatureItem(props) -> {
    style: "flex items-center gap-2"
    children: [
        Text({ text: props.icon, style: "text-lg" }),
        Text({ text: props.text, style: "text-gray-600" })
    ]
}

// Quick Start docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { Text } from "@/components/atoms/text.tp"

Page -> DocsTemplate({ children: [QuickStartContent] })

QuickStartContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        CreateProjectSection,
        ProjectStructureSection,
        FirstComponentSection,
        NextStepsSection
    ]
}

PageHeader -> DocsSection({
    id: "quick-start",
    title: "Quick Start",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Create your first topo project and see it in action."
})

// Create project
CreateProjectSection -> DocsCodeSection({
    title: "Create a New Project",
    description: "Use the CLI to scaffold a new project:",
    filename: "terminal",
    code: "topo new my-app\ncd my-app\ntopo dev\n\n# Open http://localhost:7090",
    preview: [FeatureList({
        title: "This creates:",
        items: [
            { icon: "v", text: "Project structure with pages/" },
            { icon: "v", text: "Component directories (atoms/molecules/organisms)" },
            { icon: "v", text: "Tailwind CSS configured" },
            { icon: "v", text: "Dev server with hot reload" }
        ]
    })]
})

// Project structure
ProjectStructureSection -> DocsCodeSection({
    title: "Project Structure",
    description: "A new topo project has the following structure:",
    filename: "project structure",
    code: "my-app/\n├── pages/\n│   ├── index.tp        # Home page (/)\n│   └── about/\n│       └── index.tp    # About page (/about)\n├── components/\n│   ├── atoms/          # Basic UI elements\n│   ├── molecules/      # Combined atoms\n│   └── organisms/      # Complex components\n├── stores/             # Global state\n├── services/           # API services\n└── topo.config.json    # Configuration",
    preview: [FeatureList({
        title: "Key directories:",
        items: [
            { icon: "v", text: "pages/ - File-based routing" },
            { icon: "v", text: "components/ - Reusable UI" },
            { icon: "v", text: "stores/ - State management" },
            { icon: "v", text: "services/ - API definitions" }
        ]
    })]
})

// First component
FirstComponentSection -> DocsCodeSection({
    title: "Your First Component",
    description: "Edit pages/index.tp to create your first component:",
    filename: "pages/index.tp",
    code: "Page -> {\n    style: \"p-8\"\n    children: [\n        Greeting,\n        Counter\n    ]\n}\n\nGreeting -> {\n    type: text\n    content: \"Hello, topo!\"\n    style: \"text-3xl font-bold\n           text-pink-500\"\n}",
    preview: [FirstComponentPreview]
})

FirstComponentPreview -> {
    align: vertical
    style: "space-y-4"
    children: [
        Text({ text: "Hello, topo!", style: "text-3xl font-bold text-pink-500" }),
        Text({ text: "Your first component!", style: "text-gray-500" })
    ]
}

// Next steps
NextStepsSection -> DocsCodeSection({
    title: "Next Steps",
    description: "Continue learning topo with these guides:",
    filename: "recommended",
    code: "# Recommended reading order\n1. Components Guide    # UI building blocks\n2. Store              # State management\n3. Routing            # Navigation & pages\n4. API Services       # Data fetching\n5. Styling            # Tailwind integration",
    preview: [NextStepsList]
})

NextStepsList -> {
    align: vertical
    style: "space-y-2"
    children: [
        NextStepItem({ text: "Learn about Components", href: "/docs/components-guide" }),
        NextStepItem({ text: "Explore State Management with Store", href: "/docs/store" }),
        NextStepItem({ text: "Connect to APIs", href: "/docs/api" })
    ]
}

NextStepItem(props) -> {
    type: link
    href: props.href
    content: "-> " + props.text
    style: "text-pink-500 hover:text-pink-600"
}

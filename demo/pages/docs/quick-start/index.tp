// Quick Start docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsText, DocsDescription } from "../../../components/molecules/docs-section.tp"
import { CodeBlock } from "../../../components/molecules/code-block.tp"
import { CodePreview } from "../../../components/molecules/code-preview.tp"
import { Text } from "../../../components/atoms/text.tp"

Page -> DocsTemplate({ children: [QuickStartContent] })

QuickStartContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        CreateProjectSection,
        ProjectStructureSection,
        FirstComponentSection,
        NextStepsSection
    ]
}

PageHeader -> DocsSection({
    id: "quick-start",
    title: "Quick Start",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Create your first topo project and see it in action."
})

// Create project
CreateProjectSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Create a New Project" }),
        DocsText({ text: "Use the CLI to scaffold a new project:" }),
        CodeBlock({ filename: "terminal", code: "topo new my-app\ncd my-app\ntopo dev" }),
        DocsText({ text: "Open http://localhost:7090 in your browser.", style: "text-gray-500" })
    ]
}

SectionTitle(props) -> DocsText({
    text: props.text,
    style: "text-xl font-semibold text-gray-900"
})

// Project structure
ProjectStructureSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Project Structure" }),
        DocsText({ text: "A new topo project has the following structure:" }),
        CodeBlock({ filename: "project structure", code: "my-app/\n├── pages/\n│   ├── index.tp        # Home page (/)\n│   └── about/\n│       └── index.tp    # About page (/about)\n├── components/\n│   ├── atoms/          # Basic UI elements\n│   ├── molecules/      # Combined atoms\n│   └── organisms/      # Complex components\n├── stores/             # Global state\n├── services/           # API services\n└── topo.config.json    # Configuration" })
    ]
}

// First component
FirstComponentSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Your First Component" }),
        DocsText({ text: "Edit pages/index.tp to create your first component:" }),
        FirstComponentExample
    ]
}

FirstComponentExample -> CodePreview({
    filename: "pages/index.tp",
    code: "Page -> {\n    style: \"p-8\"\n    children: [\n        Greeting,\n        Counter\n    ]\n}\n\nGreeting -> {\n    type: text\n    content: \"Hello, topo!\"\n    style: \"text-3xl font-bold\n           text-pink-500\"\n}",
    preview: [FirstComponentPreview]
})

FirstComponentPreview -> {
    align: vertical
    style: "space-y-4"
    children: [
        Text({ text: "Hello, topo!", style: "text-3xl font-bold text-pink-500" }),
        Text({ text: "Your first component!", style: "text-gray-500" })
    ]
}

// Next steps
NextStepsSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Next Steps" }),
        NextStepsList
    ]
}

NextStepsList -> {
    align: vertical
    style: "space-y-2"
    children: [
        NextStepItem({ text: "Learn about Components", href: "/docs/components-guide" }),
        NextStepItem({ text: "Explore State Management with Store", href: "/docs/store" }),
        NextStepItem({ text: "Connect to APIs", href: "/docs/api" })
    ]
}

NextStepItem(props) -> {
    type: link
    href: props.href
    content: "→ " + props.text
    style: "text-pink-500 hover:text-pink-600"
}

// Guards docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { Text } from "@/components/atoms/text.tp"

Page -> {
    title: "Guards"
    children: DocsTemplate({ children: [GuardsContent] })
}

GuardsContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicGuardSection,
        RouterGuardSection,
        ComponentGuardSection,
        ExampleSection
    ]
}

PageHeader -> DocsSection({
    id: "guards",
    title: "Guards",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Guards protect routes and components with authentication and authorization checks. Define guards once and use them in router definitions or component declarations."
})

// Basic guard definition
BasicGuardSection -> DocsCodeSection({
    title: "Defining Guards",
    description: "Use the ? operator to define a guard with a check condition and redirect path:",
    filename: "guards/auth.guard.tp",
    code: `
// Guard definition: Name ? { check, redirect }
AuthGuard ? {
    check: AuthStore.isLoggedIn
    redirect: "/login"
}

AdminGuard ? {
    check: AuthStore.isAdmin
    redirect: "/"
}`,
    preview: [GuardPreview]
})

GuardPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "check: condition expression", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "true -> allow navigation", style: "font-mono text-sm text-green-600" }),
        Text({ text: "false -> redirect to path", style: "font-mono text-sm text-red-600" })
    ]
}

// Router guards
RouterGuardSection -> DocsCodeSection({
    title: "Router Guards",
    description: "Embed guards directly in router definitions:",
    filename: "routes.tp",
    code: `
// Sub-router with guards on all routes
router AdminRouter {
    users: "/users", [isAdmin]
    settings: "/settings", [isAdmin]
    logs: "/logs", [isAdmin, isSuperAdmin]
}

// Main router
router {
    home: "/", []
    login: "/login", []
    dashboard: "/dashboard", [isAuth]
    admin: "/admin", [] -> AdminRouter
}

// Navigation with guards (in Effects)
LoginForm | {
    Effects {
        on LoginSuccess {
            navigate: .dashboard  // Checks isAuth guard
        }
        on GoToAdmin {
            navigate: .admin.users  // Checks isAdmin guard
        }
    }
}`,
    preview: [RouterGuardPreview]
})

RouterGuardPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "route: \"/path\", [guards]", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "navigate: .route -> checks guards first", style: "font-mono text-sm text-blue-600" }),
        Text({ text: "All guards pass -> navigate", style: "font-mono text-sm text-green-600" }),
        Text({ text: "Any guard fails -> redirect", style: "font-mono text-sm text-red-600" })
    ]
}

// Component-level guards
ComponentGuardSection -> DocsCodeSection({
    title: "Component Guards",
    description: "Conditionally render components based on guard checks:",
    filename: "admin-panel.tp",
    code: `
// Guard applied to component definition
// Component renders null if guard check fails

DeleteButton -> isAdmin {
    type: button
    content: "Delete"
    style: "bg-red-500 text-white px-4 py-2 rounded"
    onClick: handleDelete
}

// Multiple guards (all must pass)
SuperAdminPanel -> isAuth, isAdmin {
    style: "p-6 bg-yellow-50 border-2 border-yellow-400"
    children: [
        Text({ text: "Super Admin Controls" }),
        DangerousActions
    ]
}

// Usage - component auto-hides if guard fails
AdminDashboard -> {
    children: [
        WelcomeMessage,
        DeleteButton,      // Only visible to admins
        SuperAdminPanel    // Only visible to super admins
    ]
}`,
    preview: [ComponentGuardPreview]
})

ComponentGuardPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "Comp -> Guard { }", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "Guard.check() == true -> render component", style: "font-mono text-sm text-green-600" }),
        Text({ text: "Guard.check() == false -> render null", style: "font-mono text-sm text-red-600" })
    ]
}

// Full example
ExampleSection -> DocsCodeSection({
    title: "Complete Example",
    description: "A typical authentication setup:",
    filename: "app.tp",
    code: `
// Store with auth state
AuthStore | {
    State {
        isLoggedIn: false
        isAdmin: false
        user: null
    }

    Actions {
        Login(user)
        Logout
    }

    Reducers {
        on Login(user) {
            isLoggedIn: true
            isAdmin: user.role == "admin"
            user: user
        }
        on Logout {
            isLoggedIn: false
            isAdmin: false
            user: null
        }
    }
}

// Guards
isAuth ? {
    check: AuthStore.isLoggedIn
    redirect: "/login"
}

isAdmin ? {
    check: AuthStore.isAdmin
    redirect: "/dashboard"
}

// Router with guards
router AdminRouter {
    users: "/users", [isAdmin]
    settings: "/settings", [isAdmin]
}

router {
    home: "/", []
    login: "/login", []
    register: "/register", []
    dashboard: "/dashboard", [isAuth]
    admin: "/admin", [isAuth] -> AdminRouter
}

// Guarded component
DeleteUserButton -> isAdmin {
    type: button
    content: "Delete User"
    style: "bg-red-500 text-white"
}`,
    preview: [ExamplePreview]
})

ExamplePreview -> {
    align: vertical
    style: "space-y-1 p-4 bg-gray-50 rounded-lg text-xs"
    children: [
        Text({ text: "/home, /login, /register -> No guard", style: "font-mono text-green-600" }),
        Text({ text: "/dashboard -> isAuth", style: "font-mono text-blue-600" }),
        Text({ text: "/admin/* -> isAuth + isAdmin", style: "font-mono text-purple-600" }),
        Text({ text: "DeleteUserButton -> isAdmin (component)", style: "font-mono text-pink-600" })
    ]
}

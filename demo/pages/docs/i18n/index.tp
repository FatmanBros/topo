// i18n docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { Text } from "@/components/atoms/text.tp"

Page -> DocsTemplate({ children: [I18nContent] })

I18nContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        SetupSection,
        TranslationsSection,
        UsageSection,
        SwitchingSection
    ]
}

PageHeader -> DocsSection({
    id: "i18n",
    title: "Internationalization (i18n)",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Built-in internationalization support. Define translations once and use them anywhere in your app."
})

// Setup
SetupSection -> DocsCodeSection({
    title: "Setup",
    description: "Configure i18n in your project:",
    filename: "topo.config.json",
    code: `
    {
        "i18n": {
            "defaultLocale": "en",
            "locales": ["en", "ja", "ko", "zh"],
            "directory": "./locales"
        }
    }`,
    preview: [ConfigPreview({
        items: [
            { label: "en", desc: "English" },
            { label: "ja", desc: "Japanese" },
            { label: "ko", desc: "Korean" },
            { label: "zh", desc: "Chinese" }
        ]
    })]
})

// Translations
TranslationsSection -> DocsCodeSection({
    title: "Translation Files",
    description: "Create JSON files for each locale:",
    filename: "locales/en.json",
    code: `
    // locales/en.json
    {
        "common": {
            "welcome": "Welcome",
            "login": "Log in",
            "logout": "Log out"
        },
        "home": {
            "title": "Build UIs faster",
            "subtitle": "The flat UI framework"
        },
        "errors": {
            "required": "{field} is required",
            "minLength": "Must be at least {min} chars"
        }
    }

    // locales/ja.json
    {
        "common": {
            "welcome": "ようこそ",
            "login": "ログイン",
            "logout": "ログアウト"
        },
        "home": {
            "title": "UIをより速く構築",
            "subtitle": "フラットなUIフレームワーク"
        }
    }`,
    preview: [TranslationsPreview]
})

TranslationsPreview -> {
    style: "grid grid-cols-2 gap-4"
    children: [
        TranslationCard({ lang: "English", welcome: "Welcome", login: "Log in" }),
        TranslationCard({ lang: "Japanese", welcome: "ようこそ", login: "ログイン" })
    ]
}

TranslationCard(props) -> {
    style: "p-3 bg-gray-50 rounded-lg"
    align: vertical
    children: [
        Text({ text: props.lang, style: "font-medium text-sm text-gray-700 mb-2" }),
        Text({ text: props.welcome, style: "text-lg" }),
        Text({ text: props.login, style: "text-sm text-pink-500" })
    ]
}

// Usage
UsageSection -> DocsCodeSection({
    title: "Using Translations",
    description: "Access translations with the t() function:",
    filename: "home.tp",
    code: `
    // Simple key
    Title -> {
        type: text
        content: t("home.title")
        style: "text-3xl font-bold"
    }

    // With interpolation
    ErrorMessage(props) -> {
        type: text
        content: t("errors.required", {
            field: props.field
        })
        style: "text-red-500 text-sm"
    }

    // Nested keys
    NavItems -> {
        children: [
            NavLink({
                text: t("common.login"),
                href: "/login"
            }),
            NavLink({
                text: t("common.logout"),
                href: "/logout"
            })
        ]
    }`,
    preview: [UsagePreview]
})

UsagePreview -> {
    align: vertical
    style: "space-y-3"
    children: [
        Text({ text: "Build UIs faster", style: "text-xl font-bold" }),
        Text({ text: "Email is required", style: "text-red-500 text-sm" }),
        UsageNav
    ]
}

UsageNav -> {
    style: "flex gap-4"
    children: [
        Text({ text: "Log in", style: "text-pink-500" }),
        Text({ text: "Log out", style: "text-gray-500" })
    ]
}

// Switching
SwitchingSection -> DocsCodeSection({
    title: "Language Switching",
    description: "Change locale at runtime:",
    filename: "locale-switcher.tp",
    code: `
    LocaleSwitcher -> {
        style: "flex gap-2"
        children: locales.for(locale => {
            LocaleButton({
                code: locale,
                active: i18n.locale == locale
            })
        })
    }

    LocaleButton(props) -> {
        type: button
        content: props.code.toUpperCase()
        onClick: () => i18n.setLocale(props.code)
        style: props.active
            ? "px-3 py-1 bg-pink-500 text-white rounded"
            : "px-3 py-1 bg-gray-200 rounded"
    }`,
    preview: [SwitchingPreview]
})

SwitchingPreview -> {
    style: "flex gap-2"
    children: [
        LangButton({ code: "EN", active: true }),
        LangButton({ code: "JA", active: false }),
        LangButton({ code: "KO", active: false }),
        LangButton({ code: "ZH", active: false })
    ]
}

LangButton(props) -> {
    type: button
    content: props.code
    style: props.active
        ? "px-3 py-1 bg-pink-500 text-white rounded text-sm font-medium"
        : "px-3 py-1 bg-gray-200 text-gray-700 rounded text-sm hover:bg-gray-300"
}

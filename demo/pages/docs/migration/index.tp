// Migration docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { Text } from "@packages/components/atoms/text.tp"
import { SectionTitle } from "@/components/molecules/section-title.tp"

Page -> DocsTemplate({ children: [MigrationContent] })

MigrationContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        OverviewSection,
        GenerateDdlSection,
        MigrationDiffSection,
        CloudflareD1Section,
        PostgresSection,
        BestPracticesSection
    ]
}

PageHeader -> DocsSection({
    id: "migration",
    title: "Migration",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Generate and manage database migrations from your topo Schema definitions. Support for SQLite, PostgreSQL, and MySQL."
})

// Overview
OverviewSection -> {
    align: vertical
    style: "space-y-4"
    children: [
        SectionTitle({ text: "Overview" }),
        OverviewText,
        FeaturesList
    ]
}

OverviewText -> DocsDescription({
    text: "topo's migration system generates DDL statements from your Schema definitions. Use code-first approach to manage your database schema evolution."
})

FeaturesList -> FeatureList({
    title: "Supported operations:",
    items: [
        { icon: "v", text: "Initial schema generation (CREATE TABLE)" },
        { icon: "v", text: "Schema diff generation (ALTER TABLE)" },
        { icon: "v", text: "Multiple dialect support (SQLite, PostgreSQL, MySQL)" },
        { icon: "v", text: "Cloudflare D1 integration" }
    ]
})

// Generate DDL
GenerateDdlSection -> DocsCodeSection({
    title: "Generate DDL",
    description: "Generate initial database schema:",
    filename: "terminal",
    code: `
    # Generate DDL for SQLite (default)
    topo schema --dialect sqlite > schema.sql

    # Generate for PostgreSQL
    topo schema --dialect postgres > schema.sql

    # Generate for MySQL
    topo schema --dialect mysql > schema.sql

    # Example output (SQLite):
    -- Generated by topo
    -- Do not edit manually

    CREATE TABLE users (
      id TEXT PRIMARY KEY NOT NULL,
      name TEXT NOT NULL,
      email TEXT UNIQUE NOT NULL,
      age INTEGER
    );

    CREATE TABLE posts (
      id TEXT PRIMARY KEY NOT NULL,
      user_id TEXT NOT NULL,
      title TEXT NOT NULL,
      content TEXT,
      FOREIGN KEY (user_id) REFERENCES users(id)
    );

    -- Enable foreign keys
    PRAGMA foreign_keys = ON;`,
    preview: [DdlNote]
})

DdlNote -> {
    style: "p-4 bg-blue-50 rounded-lg border border-blue-200"
    children: [
        Text({ text: "DDL is automatically generated from your Schema block. Tables are created in dependency order to satisfy foreign key constraints.", style: "text-blue-700 text-sm" })
    ]
}

// Migration Diff
MigrationDiffSection -> DocsCodeSection({
    title: "Schema Diff",
    description: "Generate migration from schema changes:",
    filename: "terminal",
    code: `
    # Compare current schema with previous version
    topo migrate --from schema.v1.tp --to schema.v2.tp

    # Example: Adding a column
    # schema.v1.tp:
    Schema {
        users {
            id: string @primary
            name: string
        }
    }

    # schema.v2.tp:
    Schema {
        users {
            id: string @primary
            name: string
            email: string @unique   // new column
        }
    }

    # Generated migration:
    -- Add table: users
    ALTER TABLE users ADD COLUMN email TEXT UNIQUE NOT NULL;`,
    preview: [DiffPreview]
})

DiffPreview -> FeatureList({
    title: "Detected changes:",
    items: [
        { icon: "v", text: "New tables → CREATE TABLE" },
        { icon: "v", text: "Dropped tables → DROP TABLE" },
        { icon: "v", text: "New columns → ALTER TABLE ADD COLUMN" },
        { icon: "v", text: "Dropped columns → ALTER TABLE DROP COLUMN" }
    ]
})

// Cloudflare D1
CloudflareD1Section -> DocsCodeSection({
    title: "Cloudflare D1",
    description: "Apply migrations to Cloudflare D1:",
    filename: "terminal",
    code: `
    # Generate SQLite DDL
    topo schema --dialect sqlite > migrations/0001_initial.sql

    # Apply migration using wrangler
    wrangler d1 execute YOUR_DATABASE --file=migrations/0001_initial.sql

    # Or apply in local dev
    wrangler d1 execute YOUR_DATABASE --local --file=migrations/0001_initial.sql

    # For subsequent migrations
    topo migrate --from schema.v1.tp --to schema.v2.tp > migrations/0002_add_email.sql
    wrangler d1 execute YOUR_DATABASE --file=migrations/0002_add_email.sql`,
    preview: [D1Preview]
})

D1Preview -> {
    align: vertical
    style: "space-y-2"
    children: [
        Text({ text: "D1 Migration workflow:", style: "font-medium text-gray-700" }),
        WorkflowStep({ num: "1", text: "Generate DDL with --dialect sqlite" }),
        WorkflowStep({ num: "2", text: "Save to migrations/ directory" }),
        WorkflowStep({ num: "3", text: "Apply with wrangler d1 execute" }),
        WorkflowStep({ num: "4", text: "Test locally with --local flag" })
    ]
}

WorkflowStep(props) -> {
    style: "flex items-center gap-3 pl-4"
    children: [
        StepNumber({ num: props.num }),
        Text({ text: props.text, style: "text-sm text-gray-600" })
    ]
}

StepNumber(props) -> {
    style: "w-6 h-6 bg-pink-100 rounded-full flex items-center justify-center"
    children: [
        Text({ text: props.num, style: "text-pink-600 text-xs font-bold" })
    ]
}

// PostgreSQL
PostgresSection -> DocsCodeSection({
    title: "PostgreSQL",
    description: "Apply migrations to PostgreSQL:",
    filename: "terminal",
    code: `
    # Generate PostgreSQL DDL
    topo schema --dialect postgres > migrations/0001_initial.sql

    # Apply using psql
    psql -d your_database -f migrations/0001_initial.sql

    # Or with connection string
    psql $DATABASE_URL -f migrations/0001_initial.sql

    # Example PostgreSQL output:
    CREATE TABLE users (
      id TEXT PRIMARY KEY NOT NULL,
      name TEXT NOT NULL,
      email TEXT UNIQUE NOT NULL,
      age INTEGER,
      created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
      metadata JSONB
    );`,
    preview: [PostgresNote]
})

PostgresNote -> {
    style: "p-4 bg-green-50 rounded-lg border border-green-200"
    children: [
        Text({ text: "PostgreSQL-specific types like TIMESTAMPTZ and JSONB are automatically used when targeting postgres dialect.", style: "text-green-700 text-sm" })
    ]
}

// Best Practices
BestPracticesSection -> DocsCodeSection({
    title: "Best Practices",
    description: "Recommended migration workflow:",
    filename: "workflow.tp",
    code: `
    # Project structure
    my-app/
    ├── src/
    │   └── schema.tp          # Current schema definition
    ├── migrations/
    │   ├── 0001_initial.sql
    │   ├── 0002_add_posts.sql
    │   └── 0003_add_tags.sql
    └── schema-versions/
        ├── v1.tp              # Schema snapshots
        ├── v2.tp
        └── v3.tp

    # Workflow:
    # 1. Make changes to src/schema.tp
    # 2. Generate diff from previous version
    # 3. Review generated SQL
    # 4. Apply to database
    # 5. Save schema snapshot`,
    preview: [BestPracticesPreview]
})

BestPracticesPreview -> FeatureList({
    title: "Tips:",
    items: [
        { icon: "v", text: "Keep schema snapshots for version comparison" },
        { icon: "v", text: "Review generated SQL before applying" },
        { icon: "v", text: "Test migrations locally first" },
        { icon: "v", text: "Use sequential numbered filenames" }
    ]
})

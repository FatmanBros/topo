// Components Guide docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { Text } from "@packages/components/atoms/text.tp"
import { PrimaryButton } from "@packages/components/atoms/button.tp"

Page -> DocsTemplate({ children: [ComponentsContent] })

ComponentsContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicSyntaxSection,
        PropsSection,
        ChildrenSection,
        CompositionSection,
        GuardedComponentSection
    ]
}

PageHeader -> DocsSection({
    id: "components",
    title: "Components",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Components are the building blocks of topo applications. Define reusable UI elements with a simple, flat syntax."
})

// Basic syntax
BasicSyntaxSection -> DocsCodeSection({
    title: "Basic Syntax",
    description: "Components are defined using the -> operator:",
    filename: "button.tp",
    code: `
    Button -> {
        type: button
        content: "Click me"
        style: "px-4 py-2 bg-blue-500
               text-white rounded
               hover:bg-blue-600"
    }`,
    preview: [{
        type: button
        content: "Click me"
        style: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
    }]
})

// Props
PropsSection -> DocsCodeSection({
    title: "Props",
    description: "Pass data to components using props:",
    filename: "button.tp",
    code: `
    // With single prop
    Button(label) -> {
        type: button
        content: label
        style: "px-4 py-2 bg-blue-500
               text-white rounded"
    }

    // With props object
    Card(props) -> {
        style: "p-4 rounded shadow"
        children: [
            Title({ text: props.title }),
            Body({ text: props.body })
        ]
    }`,
    preview: [{
        align: vertical
        style: "space-y-3"
        children: [
            PrimaryButton("Primary", null),
            PrimaryButton("Secondary", null),
            PrimaryButton("Custom Label", null)
        ]
    }]
})

// Children
ChildrenSection -> DocsCodeSection({
    title: "Children",
    description: "Compose components using children:",
    filename: "card.tp",
    code: `
    Card -> {
        style: "p-6 bg-white rounded-xl
               shadow-lg"
        children: [
            CardHeader,
            CardBody,
            CardFooter
        ]
    }

    CardHeader -> {
        type: text
        content: "Card Title"
        style: "text-xl font-bold"
    }

    CardBody -> {
        type: text
        content: "Card content here..."
        style: "text-gray-600 mt-2"
    }`,
    preview: [{
        style: "p-6 bg-white rounded-xl shadow-lg border"
        children: [
            Text({ text: "Card Title", style: "text-xl font-bold" }),
            Text({ text: "Card content goes here...", style: "text-gray-600 mt-2" }),
            Text({ text: "Footer", style: "text-sm text-gray-400 mt-4" })
        ]
    }]
})

// Composition
CompositionSection -> DocsCodeSection({
    title: "Composition",
    description: "Build complex UIs by composing simple components:",
    filename: "profile.tp",
    code: `
    // Atoms compose into molecules
    ProfileCard -> {
        style: "flex items-center gap-4 p-4"
        children: [
            Avatar({ src: user.avatar }),
            ProfileInfo
        ]
    }

    ProfileInfo -> {
        children: [
            Username({ name: user.name }),
            UserRole({ role: user.role })
        ]
    }`,
    preview: [{
        style: "flex items-center gap-4 p-4 bg-gray-50 rounded-lg"
        children: [
            {
                style: "w-12 h-12 bg-pink-200 rounded-full flex items-center justify-center"
                children: [Text({ text: "JD", style: "font-bold text-pink-600" })]
            },
            {
                align: vertical
                children: [
                    Text({ text: "John Doe", style: "font-semibold" }),
                    Text({ text: "Developer", style: "text-sm text-gray-500" })
                ]
            }
        ]
    }]
})

// Guarded Components
GuardedComponentSection -> DocsCodeSection({
    title: "Guarded Components",
    description: "Conditionally render components based on guard checks:",
    filename: "admin-button.tp",
    code: `
    // Component renders null if guard fails
    DeleteButton -> isAdmin {
        type: button
        content: "Delete"
        style: "bg-red-500 text-white px-4 py-2"
        onClick: handleDelete
    }

    // Multiple guards (all must pass)
    SuperAdminPanel -> isAuth, isAdmin {
        style: "p-4 border-2 border-yellow-400"
        children: [AdminControls]
    }

    // Usage - component auto-hides
    Dashboard -> {
        children: [
            WelcomeMessage,
            DeleteButton    // Only visible to admins
        ]
    }`,
    preview: [GuardedPreview]
})

GuardedPreview -> {
    align: vertical
    style: "space-y-2 p-4 bg-gray-50 rounded-lg"
    children: [
        Text({ text: "Comp -> Guard { }", style: "font-mono text-sm text-gray-600" }),
        Text({ text: "Guard passes -> render", style: "font-mono text-sm text-green-600" }),
        Text({ text: "Guard fails -> null", style: "font-mono text-sm text-red-600" })
    ]
}

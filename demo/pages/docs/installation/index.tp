// Installation docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"

Page -> DocsTemplate({ children: [InstallationContent] })

InstallationContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        PrerequisitesSection,
        InstallFromSourceSection,
        VerifySection
    ]
}

PageHeader -> DocsSection({
    id: "installation",
    title: "Installation",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Get topo up and running on your machine in minutes."
})

// Prerequisites
PrerequisitesSection -> DocsCodeSection({
    title: "Prerequisites",
    description: "Make sure you have the following installed:",
    filename: "requirements",
    code: "# Required\nRust 1.70+      rustup.rs\nGit             git-scm.com\nNode.js 18+     nodejs.org",
    preview: [ConfigPreview({
        items: [
            { label: "Rust", desc: "1.70+ (install from rustup.rs)" },
            { label: "Git", desc: "For cloning the repository" },
            { label: "Node.js", desc: "18+ (for Tailwind CSS)" }
        ]
    })]
})

// Install from source
InstallFromSourceSection -> DocsCodeSection({
    title: "Install from Source",
    description: "Clone the repository and build:",
    filename: "terminal",
    code: "# Clone and build\ngit clone https://github.com/user/topo.git\ncd topo\ncargo build --release\n\n# Option 1: Add to PATH\nexport PATH=\"$PATH:/path/to/topo/target/release\"\n\n# Option 2: Create symlink\nsudo ln -s $(pwd)/target/release/topo /usr/local/bin/topo",
    preview: [FeatureList({
        title: "After installation:",
        items: [
            { icon: "v", text: "topo CLI available globally" },
            { icon: "v", text: "Dev server with hot reload" },
            { icon: "v", text: "Production build command" },
            { icon: "v", text: "Project scaffolding" }
        ]
    })]
})

// Verify installation
VerifySection -> DocsCodeSection({
    title: "Verify Installation",
    description: "Check that topo is installed correctly:",
    filename: "terminal",
    code: "topo --version\n# topo 0.1.0\n\ntopo --help\n# Shows available commands",
    preview: [FeatureList({
        title: "Available commands:",
        items: [
            { icon: "v", text: "topo new <name> - Create project" },
            { icon: "v", text: "topo dev - Start dev server" },
            { icon: "v", text: "topo build - Production build" },
            { icon: "v", text: "topo --help - Show help" }
        ]
    })]
})

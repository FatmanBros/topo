// Forms docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { Text } from "@/components/atoms/text.tp"

Page -> DocsTemplate({ children: [FormsContent] })

FormsContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicFormSection,
        ValidationSection,
        AutoGenSection,
        SubmitSection
    ]
}

PageHeader -> DocsSection({
    id: "forms",
    title: "Forms",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Build forms with automatic validation and store integration. Define once, get all form handling for free."
})

// Basic Form
BasicFormSection -> DocsCodeSection({
    title: "Form Store",
    description: "Define form fields in a Store with validation annotations:",
    filename: "login-form.tp",
    code: `
    LoginForm | {
        State {
            @key("email")
            @required
            @email
            email: ""

            @key("password")
            @required
            @minLength(8)
            password: ""

            @hidden
            isSubmitting: false
        }

        Actions {
            SetEmail(value)
            SetPassword(value)
            Submit
        }

        Reducers {
            on SetEmail(value) { email: value }
            on SetPassword(value) { password: value }
            on Submit { isSubmitting: true }
        }
    }`,
    preview: [BasicFormPreview]
})

BasicFormPreview -> {
    align: vertical
    style: "space-y-3 w-full max-w-xs"
    children: [
        FormInput({ placeholder: "Email", type: "email" }),
        FormInput({ placeholder: "Password", type: "password" }),
        FormButton({ text: "Login" })
    ]
}

FormInput(props) -> {
    type: input
    placeholder: props.placeholder
    style: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent"
}

FormButton(props) -> {
    type: button
    content: props.text
    style: "w-full px-4 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600"
}

// Validation
ValidationSection -> DocsCodeSection({
    title: "Validation Annotations",
    description: "Built-in validation with declarative annotations:",
    filename: "annotations.tp",
    code: `
    @required           // Field must have value
    @email              // Valid email format
    @minLength(8)       // Min 8 characters
    @maxLength(100)     // Max 100 characters
    @pattern("[A-Z]+")  // Regex pattern
    @min(0)             // Min number value
    @max(100)           // Max number value
    @hidden             // Not rendered as input`,
    preview: [ConfigPreview({
        items: [
            { label: "@required", desc: "Field must have a value" },
            { label: "@email", desc: "Valid email format" },
            { label: "@minLength(n)", desc: "Minimum character count" },
            { label: "@maxLength(n)", desc: "Maximum character count" },
            { label: "@pattern(regex)", desc: "Regex pattern match" },
            { label: "@min(n)", desc: "Minimum number value" },
            { label: "@max(n)", desc: "Maximum number value" },
            { label: "@hidden", desc: "Not rendered as input" }
        ]
    })]
})

// Auto-generated fields
AutoGenSection -> DocsCodeSection({
    title: "Auto-Generated Fields",
    description: "Use ...Fields to auto-generate form inputs from the anonymous store:",
    filename: "contact-form.tp",
    code: `
    // contact-form.tp
    // Store name auto-generated from filename!
    | {
        State {
            @key("name")
            @required
            @label("Your Name")
            name: ""

            @key("email")
            @required
            @email
            @label("Email Address")
            email: ""

            @key("message")
            @required
            @minLength(10)
            @label("Message")
            @textarea
            message: ""
        }
    }

    // Auto-generate all fields!
    Form -> {
        type: form
        onSubmit: .Submit
        children: [
            ...Fields,
            SubmitButton
        ]
    }`,
    preview: [AutoGenPreview]
})

AutoGenPreview -> {
    align: vertical
    style: "space-y-3 w-full"
    children: [
        LabeledInput({ label: "Your Name", placeholder: "John Doe" }),
        LabeledInput({ label: "Email Address", placeholder: "john@example.com" }),
        LabeledTextarea({ label: "Message", placeholder: "Enter your message..." }),
        FormButton({ text: "Send Message" })
    ]
}

LabeledInput(props) -> {
    align: vertical
    style: "space-y-1"
    children: [
        Text({ text: props.label, style: "text-sm font-medium text-gray-700" }),
        FormInput({ placeholder: props.placeholder, type: "text" })
    ]
}

LabeledTextarea(props) -> {
    align: vertical
    style: "space-y-1"
    children: [
        Text({ text: props.label, style: "text-sm font-medium text-gray-700" }),
        TextareaField({ placeholder: props.placeholder })
    ]
}

TextareaField(props) -> {
    type: textarea
    placeholder: props.placeholder
    style: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 h-24 resize-none"
}

// Submit handling
SubmitSection -> DocsCodeSection({
    title: "Form Submission",
    description: "Handle form submission with Effects:",
    filename: "form-submit.tp",
    code: `
    LoginForm | {
        // ... State, Actions, Reducers

        Effects {
            on Submit {
                // Validation runs automatically
                if (!isValid) {
                    return
                }

                try {
                    result: await AuthApi.login({
                        email: email,
                        password: password
                    })
                    dispatch: SetSuccess
                    navigate: .dashboard  // Type-safe with guards
                } catch(e) {
                    dispatch: SetError(e.message)
                }
            }
        }
    }`,
    preview: [FeatureList({
        title: "Form submission features:",
        items: [
            { icon: "v", text: "Auto validation before submit" },
            { icon: "v", text: "Loading state management" },
            { icon: "v", text: "Error handling built-in" },
            { icon: "v", text: "Type-safe navigation with guards" }
        ]
    })]
})

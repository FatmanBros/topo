// Store docs page
import { DocsTemplate } from "../template.tp"
import { DocsSection, DocsDescription } from "@/components/molecules/docs-section.tp"
import { DocsCodeSection } from "@/components/organisms/docs-code-section.tp"
import { FeatureList } from "@/components/molecules/feature-list.tp"
import { ConfigPreview } from "@/components/molecules/config-preview.tp"
import { Text } from "@packages/components/atoms/text.tp"

Page -> DocsTemplate({ children: [StoreContent] })

StoreContent -> {
    align: vertical
    style: "space-y-8"
    children: [
        PageHeader,
        BasicStoreSection,
        EffectsSection,
        FeaturesSection,
        TestingSection
    ]
}

PageHeader -> DocsSection({
    id: "store",
    title: "Store (State Management)",
    children: [HeaderDesc]
})

HeaderDesc -> DocsDescription({
    text: "Stores provide predictable state management with Actions, Reducers, and Effects. Inspired by Redux but with a cleaner syntax."
})

// Basic Store
BasicStoreSection -> DocsCodeSection({
    title: "Basic Store",
    description: "Define stores using the | operator:",
    filename: "counter.tp",
    code: `
    Counter | {
        State {
            count: 0
        }

        Actions {
            Increment
            Decrement
            SetCount(value)
        }

        Reducers {
            on Increment {
                count: count + 1
            }
            on Decrement {
                count: count - 1
            }
            on SetCount(value) {
                count: value
            }
        }
    }`,
    preview: [CounterPreview]
})

// Live counter store for preview
Counter | {
    State {
        count: 0
    }
    Actions {
        Increment
        Decrement
    }
    Reducers {
        on Increment { count: count + 1 }
        on Decrement { count: count - 1 }
    }
}

CounterPreview -> {
    style: "flex items-center gap-4"
    children: [
        CounterBtn({ text: "-", onClick: Counter.Decrement }),
        Text({ text: Counter.count, style: "text-4xl font-bold w-16 text-center" }),
        CounterBtn({ text: "+", onClick: Counter.Increment })
    ]
}

CounterBtn(props) -> {
    type: button
    content: props.text
    onClick: props.onClick
    style: "w-10 h-10 bg-pink-500 text-white rounded-full hover:bg-pink-600 font-bold text-xl"
}

// Effects
EffectsSection -> DocsCodeSection({
    title: "Effects (Async Operations)",
    description: "Handle async operations like API calls with Effects:",
    filename: "user-store.tp",
    code: `
    UserStore | {
        State {
            users: []
            isLoading: false
            error: null
        }

        Actions {
            FetchUsers
            SetUsers(users)
            SetError(error)
        }

        Reducers {
            on FetchUsers {
                isLoading: true
                error: null
            }
            on SetUsers(users) {
                users: users
                isLoading: false
            }
            on SetError(error) {
                error: error
                isLoading: false
            }
        }

        Effects {
            on FetchUsers {
                try {
                    users: await UserApi.getAll()
                    dispatch: SetUsers(users)
                } catch(e) {
                    dispatch: SetError(e.message)
                }
            }

            on LoginSuccess {
                navigate: .dashboard    // Route with guards
            }
        }
    }`,
    preview: [FeatureList({
        title: "Effects support:",
        items: [
            { icon: "v", text: "Async/await syntax" },
            { icon: "v", text: "Automatic loading states" },
            { icon: "v", text: "Built-in error handling" },
            { icon: "v", text: "Navigation with guards" }
        ]
    })]
})

// Features
FeaturesSection -> DocsCodeSection({
    title: "Store Features",
    description: "Convenient shortcuts for common patterns:",
    filename: "features.tp",
    code: `
    // Name Abbreviation
    // Access state directly without prefix
    count              // Instead of Counter.count
    Increment          // Instead of Counter.Increment

    // Cross-Component Access
    // Parent can access child stores
    ChildStore.count   // Read child state
    ChildStore.dispatch(Increment)  // Dispatch to child

    // In Effects
    Effects {
        on FetchData {
            data: await Api.get()
            dispatch: SetData(data)   // dispatch keyword
        }
    }`,
    preview: [ConfigPreview({
        items: [
            { label: "count", desc: "Access state directly (no prefix)" },
            { label: "Increment", desc: "Dispatch action by name" },
            { label: "ChildStore.count", desc: "Cross-component state access" },
            { label: "dispatch", desc: "Trigger actions from Effects" }
        ]
    })]
})

// Testing
TestingSection -> DocsCodeSection({
    title: "Easy Testing",
    description: "Stores are easy to test in isolation:",
    filename: "counter.test.tp",
    code: `
    test "increments count" {
        store: Counter.init()

        store.dispatch(Increment)

        expect(store.state.count).toBe(1)
    }

    test "decrements from initial" {
        store: Counter.init({ count: 10 })

        store.dispatch(Decrement)

        expect(store.state.count).toBe(9)
    }

    test "handles async fetch" {
        store: UserStore.init()
        mock(UserApi.getAll).returns([user1])

        await store.dispatch(FetchUsers)

        expect(store.state.users).toEqual([user1])
    }`,
    preview: [FeatureList({
        title: "Testing features:",
        items: [
            { icon: "v", text: "Simple test syntax" },
            { icon: "v", text: "Direct state initialization" },
            { icon: "v", text: "Isolated store instances" },
            { icon: "v", text: "Easy mocking for effects" }
        ]
    })]
})

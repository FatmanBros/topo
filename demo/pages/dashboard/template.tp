// Dashboard template - layout only
import { DashboardLayout } from "@/components/templates/dashboard-layout.tp"
import { Header } from "@/components/organisms/header.tp"
import { DashboardHeaderLeft, DashboardHeaderRight } from "./components/dashboard-header-content.tp"
import { StatCardsGrid } from "./components/stat-cards.tp"
import { RecentActivityCard } from "./components/recent-activity.tp"
import { QuickActionsCard } from "./components/quick-actions.tp"

DashboardTemplate -> DashboardLayout([DashboardHeaderSection, StatCardsGrid, DashboardContent])

DashboardHeaderSection -> Header({
    left: DashboardHeaderLeft,
    right: DashboardHeaderRight
})

DashboardContent -> {
    style: "grid grid-cols-1 lg:grid-cols-3 gap-6"
    children: [RecentActivityCard, QuickActionsCard]
}

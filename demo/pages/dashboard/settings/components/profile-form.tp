// Profile Form component with store
ProfileSettings | {
    State {
        fullName: ""
        email: ""
        bio: ""
        isLoading: true
    }

    Actions {
        Load
        SetProfile(profile)
        SetFullName(name)
        SetEmail(email)
        SetBio(bio)
    }

    Reducers {
        on Load { isLoading: true }
        on SetProfile(profile) { fullName: profile.fullName, email: profile.email, bio: profile.bio }
        on SetFullName(name) { fullName: name }
        on SetEmail(email) { email: email }
        on SetBio(bio) { bio: bio }
    }

    Effects {
        on Load {
            try {
                profile: await http.get("/api/settings/profile")
                dispatch: SetProfile(profile)
            } catch(e) {
                dispatch: SetProfile({ fullName: "", email: "", bio: "" })
            }
        }
    }
}

ProfileForm -> {
    init: ProfileSettings.Load
    align: vertical
    style: "space-y-6"
    children: [ProfileFormTitle, ProfileFormFields]
}

ProfileFormTitle -> {
    type: text
    content: "Profile Settings"
    style: "text-lg font-semibold text-gray-900 pb-4 border-b border-gray-100"
}

ProfileFormFields -> {
    align: vertical
    style: "space-y-4 pt-4"
    children: [
        FormField({ label: "Full Name", value: ProfileSettings.fullName, type: "text" }),
        FormField({ label: "Email", value: ProfileSettings.email, type: "email" }),
        FormField({ label: "Bio", value: ProfileSettings.bio, type: "textarea" }),
        SaveButton
    ]
}

FormField(label, value, type) -> {
    align: vertical
    style: "space-y-2"
    children: [
        FormFieldLabel({ label: label }),
        FormFieldInput({ value: value, type: type })
    ]
}

FormFieldLabel(label) -> {
    type: text
    content: label
    style: "text-sm font-medium text-gray-700"
}

FormFieldInput(value, type) -> {
    type: input
    inputType: type
    style: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
}

SaveButton -> {
    type: button
    content: "Save Changes"
    style: "mt-4 px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 w-fit"
}

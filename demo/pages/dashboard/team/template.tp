// Team template - layout only
import { DashboardLayout } from "../../../components/templates/dashboard-layout.tp"
import { TeamGrid } from "./components/team-grid.tp"

TeamTemplate -> DashboardLayout([TeamHeader, TeamGrid])

TeamHeader -> {
    style: "mb-8"
    children: [TeamTitle, TeamSubtitle]
}

TeamTitle -> {
    type: text
    content: "Team Members"
    style: "text-2xl font-bold text-gray-900"
}

TeamSubtitle -> {
    type: text
    content: "Manage your team and their roles"
    style: "text-gray-500 mt-2"
}

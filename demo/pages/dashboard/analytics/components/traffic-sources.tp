// Traffic Sources component with store
TrafficSources | {
    State {
        sources: []
        isLoading: true
    }

    Actions {
        Load
        SetSources(sources)
    }

    Reducers {
        on Load { isLoading: true }
        on SetSources(sources) { sources: sources }
    }

    Effects {
        on Load {
            try {
                sources: await http.get("/api/analytics/sources")
                dispatch: SetSources(sources)
            } catch(e) {
                dispatch: SetSources([])
            }
        }
    }
}

SourcesChart -> {
    init: TrafficSources.Load
    style: "bg-white rounded-xl shadow-sm border border-gray-100 p-6"
    children: [SourcesChartTitle, SourcesList]
}

SourcesChartTitle -> {
    type: text
    content: "Traffic Sources"
    style: "text-lg font-semibold text-gray-900 mb-4"
}

SourcesList -> {
    align: vertical
    style: "space-y-4"
    children: TrafficSources.sources.for(source => {
        SourceItem({
            name: source.name,
            value: source.value,
            color: source.color
        })
    })
}

SourceItem(name, value, color) -> {
    style: "flex items-center justify-between"
    children: [
        SourceItemLeft({ name: name, color: color }),
        SourceItemValue({ value: value })
    ]
}

SourceItemLeft(name, color) -> {
    style: "flex items-center gap-3"
    children: [
        SourceItemDot({ color: color }),
        SourceItemName({ name: name })
    ]
}

SourceItemDot(color) -> {
    style: color + " w-3 h-3 rounded-full"
}

SourceItemName(name) -> {
    type: text
    content: name
    style: "text-gray-700"
}

SourceItemValue(value) -> {
    type: text
    content: value
    style: "font-semibold text-gray-900"
}

// Projects template - layout only
import { DashboardLayout } from "../../../components/templates/dashboard-layout.tp"
import { PageHeader, PrimaryActionButton } from "../../../components/molecules/page-header.tp"
import { ProjectsGrid } from "./components/projects-grid.tp"

ProjectsTemplate -> DashboardLayout([ProjectsPageHeader, ProjectsGrid])

ProjectsPageHeader -> PageHeader({
    title: "Projects",
    actions: [NewProjectButton]
})

NewProjectButton -> PrimaryActionButton({ label: "+ New Project" })

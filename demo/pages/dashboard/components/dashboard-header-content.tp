// Dashboard header content - left and right sections
import { Heading } from "@packages/components/atoms/heading.tp"
import { Text } from "@packages/components/atoms/text.tp"
import { Button } from "@packages/components/atoms/button.tp"

DashboardHeaderLeft -> {
    align: vertical
    children: [
        Heading({ text: "Dashboard", level: 2, style: "text-2xl font-bold text-gray-900" }),
        Text({ text: "Welcome back! Here's what's happening.", style: "text-gray-500 mt-1" })
    ]
}

DashboardHeaderRight -> {
    style: "flex items-center gap-4"
    children: [NotificationButton, UserAvatar]
}

NotificationButton -> Button("Notifications", null, "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition", "button")

UserAvatar -> {
    style: "w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center"
    children: [Text({ text: "T", style: "text-white font-semibold" })]
}

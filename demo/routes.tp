// Routes definition - type-safe paths and navigation with guards

// Sub-routes for docs section
Routes DocsRoutes {
    index: "/"
    installation: "/installation"
    quickStart: "/quick-start"
    components: "/components-guide"
    store: "/store"
}

// Main routes
Routes {
    home: "/"
    login: "/login"
    dashboard: "/dashboard", [isAuth]
    docs: "/docs" -> DocsRoutes
    userDetail(id): "/users/{id}", [isAuth]
    projectTask(projectId, taskId): "/projects/{projectId}/tasks/{taskId}"

    Guards {
        global: [isAuthenticated]
        skip: [home, login, docs]
    }
}

// Router definition - navigation with guards

// Sub-router for docs section
router DocsRouter {
    index: "/", []
    installation: "/installation", []
    quickStart: "/quick-start", []
    components: "/components-guide", []
    store: "/store", []
}

// Main router
router {
    home: "/", []
    login: "/login", []
    dashboard: "/dashboard", [isAuth]
    docs: "/docs", [] -> DocsRouter
    users: "/users", [isAuth]
}

// Type-safe path generation (existing Routes)
Routes DocsRoutes {
    index: "/"
    installation: "/installation"
    quickStart: "/quick-start"
    components: "/components-guide"
    store: "/store"
}

Routes {
    home: "/"
    login: "/login"
    dashboard: "/dashboard"
    docs: "/docs" -> DocsRoutes
    userDetail(id): "/users/{id}"
    projectTask(projectId, taskId): "/projects/{projectId}/tasks/{taskId}"

    Guards {
        global: [isAuthenticated]
        skip: [home, login, docs]
    }
}

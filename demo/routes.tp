// Routes definition - type-safe paths and navigation

// Sub-routes for docs section
Routes DocsRoutes {
    index: "/"
    installation: "/installation"
    quickStart: "/quick-start"
    components: "/components-guide"
    store: "/store"
}

// Main routes
Routes {
    home: "/" -> { title: "Home" }
    login: "/login" -> { title: "Login" }
    dashboard: "/dashboard" -> { title: "Dashboard" }
    docs: "/docs" -> DocsRoutes
    userDetail(id): "/users/{id}" -> { title: "User Detail" }
    projectTask(projectId, taskId): "/projects/{projectId}/tasks/{taskId}"
}

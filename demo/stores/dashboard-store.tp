// Dashboard store - manages dashboard data
Dashboard | {
    State {
        stats: [
            { label: "Total Users", value: "12,345", change: "+12.5%", positive: true },
            { label: "Revenue", value: "$45,678", change: "+8.2%", positive: true },
            { label: "Active Sessions", value: "1,234", change: "-3.1%", positive: false },
            { label: "Conversion Rate", value: "3.24%", change: "+0.8%", positive: true }
        ]
        activities: [
            { user: "Alice", action: "created a new project", time: "2 minutes ago" },
            { user: "Bob", action: "updated the dashboard", time: "15 minutes ago" },
            { user: "Carol", action: "completed a task", time: "1 hour ago" },
            { user: "Dave", action: "joined the team", time: "3 hours ago" }
        ]
        isLoading: false
    }

    Actions {
        SetStats(stats)
        SetActivities(activities)
        SetLoading(loading)
    }

    Reducers {
        on SetStats(stats) { stats: stats }
        on SetActivities(activities) { activities: activities }
        on SetLoading(loading) { isLoading: loading }
    }
}

// UI Components showcase tests

// =============================================================================
// UI Components Overview - These tests verify the main UI overview page
// =============================================================================

Test("UI概要ページが表示される") {
    goto("/topo/docs/ui")
    expect(text "UI Components", { visible })
    expect(text "Component Categories", { visible })
    capture()
}

Test("カテゴリカードが表示される") {
    goto("/topo/docs/ui")
    expect(text "Atoms", { visible })
    expect(text "Molecules", { visible })
    expect(text "Organisms", { visible })
    capture()
}


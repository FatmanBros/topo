// Login form tests
import { LoginFormCard } from "./components/organisms/login-form.tp"

BeforeEach {
    goto("/login")
}

Test("ログインフォームが表示される") {
    expect(LoginFormCard.email, { visible })
    expect(LoginFormCard.password, { visible })
    expect(submit, { visible })
    capture()
}

Test("空のメールでバリデーションエラー") {
    fill(LoginFormCard.email, "")
    click(submit)
    expect(LoginFormCard.emailError, { visible })
}

Test("正常なログインフロー") {
    fill(LoginFormCard.email, "test@example.com")
    fill(LoginFormCard.password, "password123")

    // フォームの値が正しく入力されていることを確認
    expect(LoginFormCard.email, "test@example.com")
    expect(LoginFormCard.password, "password123")
}

xTest("未実装テスト") {
    expect(LoginFormCard.email, { disabled })
}

// Organisms: Login form
import "../stores/login.tp"
import "../atoms/input.tp"
import "../molecules/form-field.tp"

LoginTitle -> {
    type: text
    content: "Sign In"
    style: "text-2xl font-bold text-gray-900 mb-6 text-center"
}

EmailField -> {
    style: "mb-4"
    align: vertical
    children: [
        Label("Email"),
        Input("email", "Enter your email", $LoginForm.email, LoginForm.SetEmail)
    ]
}

PasswordField -> {
    style: "mb-6"
    align: vertical
    children: [
        Label("Password"),
        Input("password", "Enter your password", $LoginForm.password, LoginForm.SetPassword)
    ]
}

SubmitButton -> {
    type: button
    content: "Sign In"
    click: LoginForm.Submit
    style: "w-full bg-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-indigo-700 transition cursor-pointer"
}

DebugInfo -> {
    type: text
    content: $LoginForm.email
    style: "text-sm text-gray-500 mt-4 text-center"
}

LoginFormCard -> {
    style: "bg-white p-8 rounded-xl shadow-lg max-w-md w-full"
    align: vertical
    children: [
        LoginTitle,
        EmailField,
        PasswordField,
        SubmitButton,
        DebugInfo
    ]
}

App -> {
    style: "min-h-screen bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center p-4"
    children: [LoginFormCard]
}

// Molecules: Form field components
import { Input } from "../atoms/input.tp"

Label(text) -> {
    type: text
    content: text
    style: "block text-sm font-medium text-gray-700 mb-2"
}

ErrorText(msg, dataError) -> {
    type: text
    content: msg
    dataError: dataError
    style: "text-red-500 text-sm mt-1"
}

FormField(label, inputType, placeholder, value, onInput, errorMsg, dataError) -> {
    style: "mb-4"
    align: vertical
    children: [
        Label(label),
        Input(inputType, placeholder, value, onInput),
        ErrorText(errorMsg, dataError)
    ]
}

// Store: Login form state management

LoginForm | {
    State {
        @label("メールアドレス")
        @required
        @email
        email: ""

        @label("パスワード")
        @required
        @minLength(8)
        password: ""

        isSubmitting: false
    }

    Actions {
        Submit
        SetSubmitting(value)
    }

    Reducers {
        on SetSubmitting(value) {
            isSubmitting: value
        }
    }
}

// Atoms: Input components

Input(inputType, placeholder, value, onInput, dataField) -> {
    type: input
    inputType: inputType
    placeholder: placeholder
    value: value
    input: onInput
    dataField: dataField
    style: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
}

// Select dropdown component
Select(options, value, onInput, placeholder) -> {
    type: select
    options: options
    value: value
    input: onInput
    placeholder: placeholder
    style: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
}

// Textarea component for multi-line input
Textarea(placeholder, value, onInput, rows) -> {
    type: textarea
    placeholder: placeholder
    value: value
    input: onInput
    rows: rows
    style: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition resize-y"
}

Button(content, onClick, variant) -> {
    type: button
    content: content
    click: onClick
    style: variant
}

PrimaryButton(content, onClick) -> {
    type: button
    content: content
    click: onClick
    style: "w-full bg-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-indigo-700 transition"
}
